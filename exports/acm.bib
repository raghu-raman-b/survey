series = {VRST '18}
}

@inproceedings{10.1145/3290607.3311762,
author = {Kitson, Alexandra and Buie, Elizabeth and Stepanova, Ekaterina R. and Chirico, Alice and Riecke, Bernhard E. and Gaggioli, Andrea},
title = {Transformative Experience Design: Designing with Interactive Technologies to Support Transformative Experiences},
year = {2019},
isbn = {9781450359719},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3290607.3311762},
doi = {10.1145/3290607.3311762},
abstract = {Some life experiences can generate profound and long-lasting shifts in core beliefs and attitudes, including subjective transformation. These experiences can change what individuals know and value, their perspective on the world and life, evolving them as a grown person. For these characteristics, transformative experiences are gaining increasing attention in psychology, neuroscience, and philosophy. One potentially interesting question related to transformative experiences concerns how they can be invited by means of interactive technologies. This question lies at the center of a new research program, transformative experience design, which has two aims: (1) to investigate phenomenological and neurocognitive aspects of transformative experiences, as well as their implications for individual growth and psychological well-being; and (2) to translate such knowledge into tentative design principles for developing experiences that aim to support meaning in life and personal growth. Our goal for this SIG is to discuss challenges and opportunities for transformative experiences in the context of interactive technologies.},
booktitle = {Extended Abstracts of the 2019 CHI Conference on Human Factors in Computing Systems},
pages = {1–5},
numpages = {5},
keywords = {virtual reality, transformative experience, transcendent experience, techno-spirituality, positive technology, generative art},
location = {Glasgow, Scotland Uk},
series = {CHI EA '19}
}

@inproceedings{10.1145/3757372.3771874,
author = {Liu, Dongping and Li, Xiaomeng and Lu, Mengqian and Wang, Shiqi and Zhang, Luyao},
title = {Generative AI for All and for Humanity: From Zero to Hero with Open Data, Space Computing, and Sustainable Smart Cities},
year = {2025},
isbn = {9798400721328},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3757372.3771874},
doi = {10.1145/3757372.3771874},
abstract = {Generative artificial intelligence is reshaping creativity, learning, and problem solving—a renaissance for all and for humanity. This one-hour workshop guides educators and learners "from zero to hero" by linking generative AI with open data, space computing, and sustainable smart-city applications. Participants will curate and publish 3D urban datasets with clear documentation, transform them into interactive models, and simulate energy-aware scenarios such as drone routing. The workshop emphasizes responsible data governance and ethical practice, highlighting principles that call for data to be easy to find and reuse as well as respectful of community rights and benefits. Outcomes are aligned with the United Nations Sustainable Development Goals to connect technical practice with global challenges. Participants will leave with openly licensed teaching resources, including a rubric, workflow, and project templates that integrate responsible AI into curricula and incubate capstone proposals in computer graphics and interactive technologies.},
booktitle = {SIGGRAPH Asia 2025 Educator's Forum},
articleno = {11},
numpages = {5},
keywords = {Generative AI, Open Data, Space Computing, Smart Cities, Education, FAIR Principles, CARE Principles, SDGs, Drones, AR/VR, Blockchain Platforms, Web3, Responsible AI},
location = {
},
series = {SA '25}
}

@inproceedings{10.1145/3357236.3395532,
author = {Stepanova, Ekaterina R. and Desnoyers-Stewart, John and Pasquier, Philippe and Riecke, Bernhard E.},
title = {JeL: Breathing Together to Connect with Others and Nature},
year = {2020},
isbn = {9781450369749},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3357236.3395532},
doi = {10.1145/3357236.3395532},
abstract = {Bio-responsive immersive Virtual Reality can transform our interactions to bring awareness to our physiological rhythms fostering connection with our bodies, each other and nature. JeL is an immersive installation that aims to foster a feeling of connection through the process of breathing synchronization. Two immersants synchronize their breathing to fuel the growth of a coral-like structure that, together with the interactions of others, populates an initially empty coral reef. JeL is designed to support an intimate connection between users and with nature, sending a message about our collective capacity to care for the environment. JeL is an installation and research platform for exploring breathing synchronization and its effect on the feeling of connection. It was well received at a digital art festival where participants were able to relax and synchronize using the installation. Reflection on our design process and observations provides insights for the development of systems that promote connection.},
booktitle = {Proceedings of the 2020 ACM Designing Interactive Systems Conference},
pages = {641–654},
numpages = {14},
keywords = {virtual reality, interpersonal synchronization, installation art, generative systems, feeling of connection, ecopsychology, breathing biofeedback, bioresponsive systems},
location = {Eindhoven, Netherlands},
series = {DIS '20}
}

@inproceedings{10.1145/3293663.3293674,
author = {Li, Jingbei and Liu, Yu and Xiao, Huaxin and Tan, Hanlin and Zhang, Maojun},
title = {Wiener Loss: A Strong Correlative Loss Applied to Conditional GAN for Color Prediction},
year = {2018},
isbn = {9781450366410},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3293663.3293674},
doi = {10.1145/3293663.3293674},
abstract = {Colorization is a task to generate plausible color for a given grayscale image, where the target in input always have variable color styles. Due to the ill-posed inverse problem in colorization, the generated color image easily suffers from the phenomenon of color cast, where unexpected particular color affects the generated image. To cope with such problem, this paper proposes a novel loss function, called Wiener Loss, to constrain the training of colorization network. Concretely, we adopt conditional generative network for training. This paper uses the colorized image from generator and ground truth corporately to calculate their relevance defined as Wiener Loss and feeds this loss back into generator network for training. The experiments demonstrate that our method generates better results compared with its counterpart.},
booktitle = {Proceedings of the 2018 International Conference on Artificial Intelligence and Virtual Reality},
pages = {61–66},
numpages = {6},
keywords = {Loss function, Conditional GAN, Colorization},
location = {Nagoya, Japan},
series = {AIVR 2018}
}

@inproceedings{10.1145/3802133.3802203,
author = {Wang, Henan and Zhang, Chen},
title = {Application of Information Technology in History Education -- A Case Study of VR Technology in the Historical Teaching of Dunhuang Mogao Caves},
year = {2026},
isbn = {9798400721564},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3802133.3802203},
doi = {10.1145/3802133.3802203},
abstract = {Driven jointly by rapid technological iteration and the renewal of educational philosophies, information-based educational technologies have become a core engine of transformation in history education. Traditional history education faces multiple challenges, including the lack of emotional appeal caused by static presentation, the “affluence dilemma” that prevents learners from being physically present at historical sites, and geographical constraints that limit experiential teaching. Virtual reality (VR) technology offers an innovative pathway to addressing these challenges. Taking the practice of history education at the Mogao Caves in Dunhuang as a case study, this paper explores the pathways and practical value of integrating information-based educational technologies with history education. The results show that, supported by core computer technologies such as convolutional neural networks (CNNs) and generative adversarial networks (GANs), platforms including Exploring Dunhuang and Digital Dunhuang have realized 1:1 three-dimensional reconstruction of caves and high-precision replication of murals, enabling immersive and interactive learning experiences. Validation through linear regression and multilayer perceptron (MLP) neural network analyses demonstrates that these technological innovations effectively break through temporal and geographical constraints, enhance the attractiveness and dissemination efficiency of history education, and contribute to the living inheritance of the millennia-old Dunhuang culture. This paper further analyzes the key advantages and existing problems of technological applications and proposes optimization strategies, such as deepening technological integration and establishing ethical norms. These findings provide practical references for promoting the deep integration of VR technology and history education, constructing a new “experiential” model of history teaching, and supporting history education in fulfilling its fundamental mission of fostering virtue through education.},
booktitle = {Proceedings of the 2026 3rd International Conference on Informatics Education and Computer Technology Applications},
pages = {428–435},
numpages = {8},
keywords = {Digital Dunhuang, VR technology, history education, informatization technology in education},
location = {
},
series = {IECA 2026}
}

@article{10.1145/3355089.3356557,
author = {Kaplanyan, Anton S. and Sochenov, Anton and Leimk{\"u}hler, Thomas and Okunev, Mikhail and Goodall, Todd and Rufo, Gizem},
title = {DeepFovea: neural reconstruction for foveated rendering and video compression using learned statistics of natural videos},
year = {2019},
issue_date = {December 2019},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {38},
number = {6},
issn = {0730-0301},
url = {https://doi.org/10.1145/3355089.3356557},
doi = {10.1145/3355089.3356557},
abstract = {In order to provide an immersive visual experience, modern displays require head mounting, high image resolution, low latency, as well as high refresh rate. This poses a challenging computational problem. On the other hand, the human visual system can consume only a tiny fraction of this video stream due to the drastic acuity loss in the peripheral vision. Foveated rendering and compression can save computations by reducing the image quality in the peripheral vision. However, this can cause noticeable artifacts in the periphery, or, if done conservatively, would provide only modest savings. In this work, we explore a novel foveated reconstruction method that employs the recent advances in generative adversarial neural networks. We reconstruct a plausible peripheral video from a small fraction of pixels provided every frame. The reconstruction is done by finding the closest matching video to this sparse input stream of pixels on the learned manifold of natural videos. Our method is more efficient than the state-of-the-art foveated rendering, while providing the visual experience with no noticeable quality degradation. We conducted a user study to validate our reconstruction method and compare it against existing foveated rendering and video compression techniques. Our method is fast enough to drive gaze-contingent head-mounted displays in real time on modern hardware. We plan to publish the trained network to establish a new quality bar for foveated rendering and compression as well as encourage follow-up research.},
journal = {ACM Trans. Graph.},
month = nov,
articleno = {212},
numpages = {13},
keywords = {deep learning, foveated rendering, gaze-contingent rendering, generative networks, perceptual rendering, video compression, video generation, virtual reality}
}

@inproceedings{10.1145/3749012.3749073,
author = {Stergiou, Marina},
title = {Animated Threads: Digital Cloth Applications as a Creative Tool in Choreography and Costume Design},
year = {2025},
isbn = {9798400715617},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3749012.3749073},
doi = {10.1145/3749012.3749073},
abstract = {This research investigates the creative potential of digital cloth simulation as a generative and collaborative tool at the intersection of choreography and costume design. Drawing from emerging technologies, such as cloth simulation, motion capture, and extended reality (XR), the project explores how virtual garments can shape movement ideas, inform physical costume design, and enable new models of interdisciplinary collaboration. The study proposes an ideation-driven approach in which digital garments inspire choreographic thinking without physical realization. Through theoretical grounding, user studies, and experimental workshops with artists, this work aims to re-frame costume as an active, responsive agent in performance making, expanding both aesthetic possibilities and collaborative practices in contemporary dance.},
booktitle = {Proceedings of the 3rd International Conference of the ACM Greek SIGCHI Chapter},
pages = {242–245},
numpages = {4},
keywords = {Emerging technologies, XR, cloth simulation, choreography, embodiment, costume design},
location = {
},
series = {CHIGreece '25}
}

@inproceedings{10.1145/3749012.3749056,
author = {Stergiou, Marina and Vosinakis, Spyros},
title = {Exploring the role of Emerging Technologies in preservation and promotion of traditional costumes: The role of AI in current practices.},
year = {2025},
isbn = {9798400715617},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3749012.3749056},
doi = {10.1145/3749012.3749056},
abstract = {In the evolving landscape of cultural heritage preservation, emerging technologies such as Extended Reality (XR) and Artificial Intelligence (AI) are reshaping how archival and heritage material are preserved, documented, interpreted and promoted, since they can allow interactive and immersive experiences that can lead to deeper engagement and cultural appreciation. Traditional clothing that was worn during folk dancing is a core element of both tangible and intangible cultural heritage since it is correlated with various parameters such as movement, shapes, materials, crafts and history. This study aims to explore the possible ways that emerging technologies can contribute to the preservation and promotion of traditional costumes by studying current state of the art in the digitization and interactive presentation of traditional costumes, with particular emphasis on movement and interactivity aspects. Furthermore, it examines case studies of AI application in the traditional heritage clothing area as well as in the contemporary fashion retail sector. The goal is to identify gaps in the existing XR heritage costumes pipeline and investigate areas that AI can contribute and ultimately, taking paradigms from AI applications in retail industry to see possible applications in the promotion/preservation of costume heritage section. Through the analysis of representative studies and projects, the review highlights growing interest in areas such as immersive experiences and 3D garment reconstruction. However, significant gaps persist in the dynamic, motion-aware, and interactive representation of costumes, especially within dance contexts. The study examines how AI can support various stages of the digital costume heritage pipeline, including metadata enrichment, generative reconstruction, motion simulation, and user experience evaluation. Moreover it identifies the domains where AI technologies are currently more mature and those where development is still emerging. Finally, it outlines future research opportunities, particularly in AI-assisted animation, virtual try-on systems, and gamified cultural applications. This review calls for a shift from passive digitization to context-aware, interactive, and embodied approaches that can capture the full material and symbolic complexity of traditional garments as both cultural artifacts and living expressions of heritage.},
booktitle = {Proceedings of the 3rd International Conference of the ACM Greek SIGCHI Chapter},
pages = {126–134},
numpages = {9},
keywords = {Emerging technologies, XR, AI, cultural heritage, traditional attires, ethnic costumes},
location = {
},
series = {CHIGreece '25}
}

@inproceedings{10.1145/3736539.3737497,
author = {Mah, Sang and DiPaola, Steve and Carter, Derrick and Loh, Juliana and Macleod, Alastair and Cuykendall, Shannon and Miller, Noah and Jahangiri, Nasim and Schiphorst, Thecla},
