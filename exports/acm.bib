@inproceedings{10.1145/3800645.3813001,
author = {Choi, Sooyeon and Lim, Jaewan and Lee, Nayoung and Yoo, Yongjae},
title = {Supporting Dance Motor Skill Training in Multisensory VR Experience},
year = {2026},
isbn = {9798400725630},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3800645.3813001},
doi = {10.1145/3800645.3813001},
abstract = {Acquiring motor skills, such as dance, is considered a difficult task, as novice learners frequently encounter challenges in promptly comprehending and adjusting their movements in learning contexts. In this study, we present a virtual environment training system that incorporates haptic feedback and generative AI to support novices’ learning of body movements in dance. The system guides the user through haptic feedback in VR, generated from dance sequence data captured from professional choreographers. User studies with novice participants were conducted to 1) establish effective feedback for guidance and 2) evaluate the user’s training experiences using the system. We also conducted comprehensive interviews with participants and experts to confirm the design strategies and seek insights regarding the perception and utilization of virtual environments, along with haptic and visual feedback in dance learning processes. Based on the outcomes, we established the design guidelines for virtual environment training systems that facilitate learning bodily movement regulation, including in dance education.},
booktitle = {Proceedings of the 2026 Designing Interactive Systems Conference},
pages = {2852–2867},
numpages = {16},
keywords = {Dance Training, Haptic Guidance, Motor Learning, Virtual Reality, Adaptive Practice},
location = {
},
series = {DIS '26}
}

@inproceedings{10.1145/3757372.3771865,
author = {Pan, Zhigeng and Wang, Wenyun and Lang, Xu and Dai, Rui and Zhu, Xingmeng and Qi, Bingchao},
title = {The VR Wonderland of Yue Opera},
year = {2025},
isbn = {9798400721328},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3757372.3771865},
doi = {10.1145/3757372.3771865},
abstract = {As the second largest opera genre in China, Yue Opera's digital inheritance faces the dual challenges of a lack of interest from young people and insufficient interaction with existing technologies. To this end, this study proposes and constructs a virtual reality gamification system for the cultural inheritance of Yue Opera, "The VR Wonderland of Yue Opera"(VWYO). The system integrates virtual reality, motion capture, intelligent voice, and large language models to provide users with an immersive learning experience from cultural cognition, knowledge interaction, to performance imitation through the four-act scene of "voice dialogue - Yue Opera game - body learning - gesture learning". The results show that VWYO has advantages in improving the immersion of Yue Opera and helping to master knowledge, and also provides a generalizable technical path and practical paradigm for the digital living inheritance of intangible cultural heritage.},
booktitle = {SIGGRAPH Asia 2025 Educator's Forum},
articleno = {27},
numpages = {5},
keywords = {Embodied Interaction, Gamified Learning, Intangible Cultural Heritage, Large Language Model, Motion Capture},
location = {
},
series = {SA '25}
}

@inproceedings{10.1145/3761667.3761959,
author = {Kanimetova, Aziza and Nimet Dumlu, Burcu and Shen, Ximing and Zhong, Kanghong and Armstrong, Mark and Wakisaka, Sohei and Yoshida, Takatoshi and Minamizawa, Kouta},
title = {Yurt Portal: A Nomadic Spatial Interface to Reflect Cross-Cultural Virtual Digital Twins},
year = {2025},
isbn = {9798400721687},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3761667.3761959},
doi = {10.1145/3761667.3761959},
abstract = {Yurt Portal is an interactive Extended Reality (XR) experience that augments physical space by generating and mirroring cultural digital twins to foster cross-cultural communication. Set in a yurt - a traditional Kyrgyz nomadic dwelling - the installation integrates physical objects from both Kyrgyz and Japanese cultures. Users engage with generative AI-powered digital twins of themselves and the objects, creating layered interactions between physical and virtual elements. The system comprises three key components: the yurt space, curated cultural objects, and AI-driven digital interactive augmentations. By situating virtual content within the physical environment, the project explores the reality–virtuality continuum, positioning XR not merely as a technological medium but as a cultural interface. Yurt Portal emphasizes empathy-based cultural learning [Geertz 2017] through familiar artifacts, encouraging deeper understanding between underrepresented and well-known cultures. It embedded cultural narratives into the continuum of XR, highlighting how familiarity can foster empathy and build respect for cultural differences.},
booktitle = {SIGGRAPH Asia 2025 XR},
articleno = {26},
numpages = {2},
keywords = {Cultural Heritage, Interactive Space, Extended Reality},
location = {
},
series = {SA '25}
}

@inproceedings{10.1145/3379337.3415816,
author = {Richardson, Mark and Durasoff, Matt and Wang, Robert},
title = {Decoding Surface Touch Typing from Hand-Tracking},
year = {2020},
isbn = {9781450375146},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3379337.3415816},
doi = {10.1145/3379337.3415816},
abstract = {We propose a novel text decoding method that enables touch typing on an uninstrumented flat surface. Rather than relying on physical keyboards or capacitive touch, our method takes as input hand motion of the typist, obtained through hand-tracking, and decodes this motion directly into text. We use a temporal convolutional network to represent a motion model that maps the hand motion, represented as a sequence of hand pose features, into text characters. To enable touch typing without the haptic feedback of a physical keyboard, we had to address more erratic typing motion due to drift of the fingers. Thus, we incorporate a language model as a text prior and use beam search to efficiently combine our motion and language models to decode text from erratic or ambiguous hand motion. We collected a dataset of 20 touch typists and evaluated our model on several baselines, including contact-based text decoding and typing on a physical keyboard. Our proposed method is able to leverage continuous hand pose information to decode text more accurately than contact-based methods and an offline study shows parity (73 WPM, 2.38\% UER) with typing on a physical keyboard. Our results show that hand-tracking has the potential to enable rapid text entry in mobile environments.},
booktitle = {Proceedings of the 33rd Annual ACM Symposium on User Interface Software and Technology},
pages = {686–696},
numpages = {11},
keywords = {virtual reality, text input, hand-tracking, augmented reality},
location = {Virtual Event, USA},
series = {UIST '20}
}

@inproceedings{10.1145/3779232.3779266,
author = {Wang, Yu and Luan, Hongqiu and Gai, Wei and Wang, Lutong and Yang, Chenglei},
title = {Practice-Along-Watching in Panoramic VR: A Novel Human-AI Collaboration Genre for Demonstration-Based Training},
year = {2026},
isbn = {9798400723629},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3779232.3779266},
doi = {10.1145/3779232.3779266},
abstract = {Demonstration-Based Training relies on observing expert demonstrations and practicing with timely feedback. While Virtual Reality (VR) provides an immersive learning environment, existing approaches often disconnect observation from practice or lack adaptive guidance. This paper proposes a novel "Practice-Along-Watching" (PAW) model that seamlessly integrates teacher demonstrations in interactive virtual environment through panoramic video. Learners view real-time task performances by teachers from a first-person perspective and can simultaneously manipulate virtual objects to mimic the teacher’s actions. To overcome the passivity of pure watching or the rigidity of preset feedback, we introduce a collaborative Large Language Model (LLM) agent to empower demonstration-based training. The AI agent actively monitors the learner’s actions, compares them to expert demonstrations (including visual observation and process modeling), and provides timely, context-specific corrective feedback. In addition, the agent collaboratively controls the pace of learning, dynamically pauses demonstrations for practice reinforcement, or adjusts difficulty based on learner performance. We instantiate the model and apply it to the field of tea ceremony training. A comprehensive user study demonstrated the effectiveness of the collaborative HCI-AI approach. Compared to passive observation, participants using the AI-empowered PAW model showed improvements in task accuracy and procedural knowledge, while reporting high levels of engagement and personalized learning experiences.},
booktitle = {Proceedings of the 20th International Conference on Virtual Reality Continuum and Its Applications in Industry},
articleno = {10},
numpages = {8},
keywords = {Panoramic video, Virtual learning, Human-agent interaction},
location = {
},
series = {VRCAI '25}
}

@inproceedings{10.1145/3799825.3818737,
author = {Xiao, Sirui and Gao, Zihan and Lyu, Xin},
title = {Fading Peach Blossom Spring: A Perspective-Shifting VR Narrative with Reactive 3D Gaussian Splatting},
year = {2026},
isbn = {9798400725487},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3799825.3818737},
doi = {10.1145/3799825.3818737},
abstract = {3D Gaussian Splatting (3DGS) has enabled high-fidelity scene reconstruction, yet its applications in virtual reality have remained largely limited to static visualization. We present Fading Peach Blossom Spring, a stylized VR interactive narrative that combines generative AI, 3DGS, and Unreal Engine to create an environment that changes irreversibly through user interaction. Inspired by the classical Chinese tale The Peach Blossom Spring, the work constructs a perspective-shifting experience in which users first explore an idyllic ink-wash world that gradually dissolves into a desolate alternative space through touch. To realize this experience, we propose a reactive representation and interaction pipeline that transforms static 3DGS into a particle-based system for real-time environmental change, enabling a destructive interaction paradigm in which touch drives both environmental decay and narrative transition. User feedback suggests that this design encourages reflection on loss, responsibility, and the consequences of intervention. Overall, this work demonstrates the potential of 3DGS as a reactive medium for stylized VR storytelling and agency-driven narrative interaction.},
booktitle = {Proceedings of the Special Interest Group on Computer Graphics and Interactive Techniques Conference Posters},
articleno = {47},
numpages = {3},
keywords = {3D Gaussian Splatting, Virtual Reality, Generative AI, Interactive Narrative, User Agency},
location = {
},
series = {SIGGRAPH Posters '26}
}

@inproceedings{10.1145/3773699.3776573,
author = {Choi, Hyeokjin and Cha, Seung Hyun},
title = {Processed Experience: A Contemporary Discourse on Existence with Spatial Installation},
year = {2026},
isbn = {9798400720017},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3773699.3776573},
doi = {10.1145/3773699.3776573},
abstract = {Now, we see proliferation of information and things of experience. We undergo numerous digital experiences, yet overwhelmed by their splendor and quantity, we struggle to articulate what we have experienced. This excess of experience dilutes the density of condensed experience and punctures our sense of being. This demands philosophical reflection. In response, this paper proposes “Processed Experience” as a conceptual framework for understanding how digital experiences are constructed through discontinuous, fragmented units rather than continuous flows. Drawing from information theory and media aesthetics, we introduce three analytical axes: Medium (material conditions of information), Frame (quantum segmentation of time), and Attention (selective information capture mechanisms). These three dimensions project experience into discrete units we call “Dice”, which are formed through Encoding and Processing within information field. To reveal the framework as phenomenon, we present a spatial installation using Apple Vision Pro. Participants are surrounded by three-dimensional graphics and audio manifested by different processor—RGB differentials, AI interpretations, and interpolated graphics. The installation places the outputs of different processors (electrical circuits, algorithms, language models) in front of another processor—the human participant. The three-minute immersive experience progressively overwhelms participant, forcing them to confront their own processing. By confronting participants within others’ processed outputs, it prompts questions about how digital experiences are constructed through encoding and processing. This research presents “Processthetics”—an aesthetic attitude where processing is experience itself. Rather than being confused by excess, understanding experience in novel framework opens new interpretive possibilities for digital experience and existence in the contemporary era.},
booktitle = {Proceedings of the 2025 12th International Conference on Digital and Interactive Arts: Media Art Cultures, Communities \&amp; Territories},
articleno = {33},
numpages = {8},
keywords = {Digital Experience, Extended Reality, Information Theory, Media Aesthetics, Spatial Experience},
location = {
},
series = {ARTECH '25}
}

@inproceedings{10.1145/3820915.3820959,
author = {Duan, Ling and Lin, Jiaxin and Zhang, Li and Gao, Qian and Chen, Faming and Wu, Jianfeng and Gao, Peitao and Zhou, Guanghao and Li, Junzhi},
title = {Research on AI Agent Task Flow Modeling and Intelligent Review System for Contract Review},
year = {2026},
isbn = {9798400723612},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3820915.3820959},
doi = {10.1145/3820915.3820959},
abstract = {In the global business landscape, contract review has long relied on manual processes, leading to issues such as low efficiency, high costs, and heightened legal and financial risks. Existing AI-assisted approaches—whether rule-based templates, statistical machine learning, or end-to-end LLMs—suffer from limitations such as poor generalization, dependence on annotated data, or uncontrollable outputs, and they fail to deconstruct the cognitive process of review in a refined manner. This paper introduces an AI Agent framework to model contract review as a multi-agent task flow and develops an intelligent review system. The process is decomposed into subtasks within an architecture comprising a Management and Coordination Agent Hub, Specialized Execution Agents, and a Knowledge Support Layer. Additionally, the study develops an information extraction algorithm based on LLMs and structured prompts, as well as a hybrid risk identification algorithm combining rules and semantic models. The revision further clarifies cost-aware selective invocation, confidence-based conflict resolution, separate precision-recall evaluation, and a human-in-the-loop knowledge update workflow.},
booktitle = {Proceedings of the 2nd International Conference on Artificial Intelligence, Virtual Reality and Interaction Design},
pages = {290–296},
numpages = {7},
keywords = {AI Agent, Contract Review, Intelligent Review System, Large Language Model (LLM), Multi-Agent System},
location = {
},
series = {AIVRID '26}
}

@inproceedings{10.1145/3772363.3798326,
author = {Yang, Xiaoran and Zhan, Yang and Jin, Qiao},
title = {Understanding Prompt Construction and Interaction Challenges in LLM-Based Multi-Robot Systems for Spatial Tasks},
year = {2026},
isbn = {9798400722813},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3772363.3798326},
doi = {10.1145/3772363.3798326},
abstract = {LLM-based multi-robot systems (MRS) can take a user’s high-level goal and generate coordinated robot actions for spatial tasks. However, human-in-the-loop is still needed when the system benefits from humans providing clarifications or preferences, especially in settings where full autonomy is not yet reliable and the environment is highly uncertain. Motivated by this gap, we conducted a qualitative study (N = 12) in a VR-based multi-robot simulation environment to examine how users construct prompts for MRS and what challenges they perceive during task decomposition, allocation, and execution. Results show that users use prompts to specify robot roles, order, and end goals, and re-prompt when results are inefficient, or execution is not observable. We also found that gaps in workflow visibility, interface support, and coordination logic hinder users’ understanding and their ability to intervene. We provide design implications for human-in-the-loop interfaces and prompt support in LLM-based MRS.},
booktitle = {Proceedings of the Extended Abstracts of the 2026 CHI Conference on Human Factors in Computing Systems},
articleno = {706},
numpages = {5},
keywords = {Virtual Reality, Human Robot Interaction, Multi-Robot System},
location = {
},
series = {CHI EA '26}
}

@inproceedings{10.1145/3764687.3767274,
author = {Zhou, Dezijian and Globa, Anastasia and McLaughlan, Rebecca and Tran, Tram Thi Minh and Zhao, Yi and Wu, Ruo-Xuan and Liu, Tianrui and Liu, Renxuan and Wu, Xingting and Pedell, Sonja and Quigley, Aaron J},
title = {The Role of XR, Spatial, and Physical Interaction in Remote Multimodal Communication: Emotional Well-Being in Older Adults},
year = {2025},
isbn = {9798400720161},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3764687.3767274},
doi = {10.1145/3764687.3767274},
abstract = {As society ages and family structures evolve, many older adults increasingly rely on long-distance social connections. However, traditional methods such as video calls and text messaging often fall short in effectively supporting emotional expression, cognitive engagement, and sustained social participation. Recent technologies, including Extended Reality (XR)-based social platforms, avatar-mediated interactions, and wearable devices, have expanded opportunities for long-distance connections. Yet limited research has explored whether multimodal interactions in XR environments can improve older adults’ emotional well-being. Existing platforms and devices frequently overlook older adults’ specific needs, preferences, and interaction challenges. This half-day workshop invites participants to engage in spatial XR, gestures and haptic experiences, guided by the organisers and experts, to critically reflect on the strengths and limitations of these technologies. Using the scenario of celebrating holidays with distant family or friends, organisers and participants will co-design multimodal communication systems that involve spatial and physical interactions in remote XR environments to support social connectedness and emotional well-being for older adults.},
booktitle = {Proceedings of the 37th Australian Conference on Human-Computer Interaction},
pages = {992–998},
numpages = {7},
keywords = {Mixed Reality, Long-Distance Interaction, Spatial Communication, Generative Artificial Intelligence, Multisensory Interaction},
location = {
},
series = {OzCHI '25}
}

@inproceedings{10.1145/3613904.3642360,
author = {He, Ziyao and Li, Shiyuan and Song, Yunpeng and Cai, Zhongmin},
title = {Towards Building Condition-Based Cross-Modality Intention-Aware Human-AI Cooperation under VR Environment},
year = {2024},
isbn = {9798400703300},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3613904.3642360},
doi = {10.1145/3613904.3642360},
abstract = {To address critical challenges in effectively identifying user intent and forming relevant information presentations and recommendations in VR environments, we propose an innovative condition-based multi-modal human-AI cooperation framework. It highlights the intent tuples (intent, condition, intent prompt, action prompt) and 2-Large-Language-Models (2-LLMs) architecture. This design, utilizes “condition” as the core to describe tasks, dynamically match user interactions with intentions, and empower generations of various tailored multi-modal AI responses. The architecture of 2-LLMs separates the roles of intent detection and action generation, decreasing the prompt length and helping with generating appropriate responses. We implemented a VR-based intelligent furniture purchasing system based on the proposed framework and conducted a three-phase comparative user study. The results conclusively demonstrate the system’s superiority in time efficiency and accuracy, intention conveyance improvements, effective product acquisitions, and user satisfaction and cooperation preference. Our framework provides a promising approach towards personalized and efficient user experiences in VR.},
booktitle = {Proceedings of the 2024 CHI Conference on Human Factors in Computing Systems},
articleno = {955},
numpages = {13},
keywords = {Action Generation, Human-AI Cooperation, Intention Detection, Virtual Reality},
location = {Honolulu, HI, USA},
series = {CHI '24}
}

@inproceedings{10.1145/3706599.3720232,
author = {Liu, Shi and M{\"a}dche, Alexander and Feick, Martin},
title = {GazeClass: Towards Gaze-Adaptive Cross-Device Learning Support for Virtual Classrooms},
year = {2025},
isbn = {9798400713958},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3706599.3720232},
doi = {10.1145/3706599.3720232},
abstract = {Immersive virtual classrooms provide engaging learning experiences but often lack individualized support, particularly in asynchronous settings where students independently engage with pre-recorded lectures. This absence of live teacher interaction can hinder personalized guidance and self-reflection. To address this challenge, we present GazeClass, a system enabling cross-device interaction by combining eye tracking in Virtual Reality (VR) with a learning assistant powered by large language models (LLMs) on a separate mobile or desktop device, delivering post-lecture, gaze-adaptive learning support. During the lecture, eye tracking monitors students’ attention, and afterward, tailored feedback and self-reflective Q&amp;A are provided to bridge attention gaps. The cross-device interaction between VR and a mobile or desktop device fosters interactivity and active learning. Developed through co-design workshops and iterative evaluations, GazeClass was validated in a preliminary study, demonstrating its potential to enhance learning outcomes by addressing key challenges in immersive learning.},
booktitle = {Proceedings of the Extended Abstracts of the CHI Conference on Human Factors in Computing Systems},
articleno = {299},
numpages = {12},
keywords = {mixed reality, eye tracking, virtual classroom, adaptive support},
location = {
},
series = {CHI EA '25}
}

@inproceedings{10.1145/3746058.3758440,
author = {Yang, Seungwon and Yoon, Suwon and Choi, Jeongwon and Hwang, Inseok},
title = {Chameleon: A Surface-Anchored Smartphone AR Prototype with Visually Blended Mobile Display},
year = {2025},
isbn = {9798400720369},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3746058.3758440},
doi = {10.1145/3746058.3758440},
abstract = {Augmented reality (AR) is often realized through head-mounted displays, offering immersive but egocentric experiences. While smartphone-based AR is more accessible, it remains limited to handheld, single-user interaction. We introduce Chameleon, a prototype AR system that transforms smartphones into surface-anchored displays for co-located use. When placed flat, the phone creates a transparency illusion and anchors digital content visible to multiple users. Chameleon supports natural repositioning on the surface without external hardware by combining two techniques: (1) Background Acquisition uses opportunistic sensing and language model-assisted pattern generation to blend with surrounding surfaces, and (2) Real-Time Position Tracking augments inertial sensing to maintain spatial stability. This work shows how lightweight sensing can support casual, collaborative AR experiences using existing devices.},
booktitle = {Adjunct Proceedings of the 38th Annual ACM Symposium on User Interface Software and Technology},
articleno = {80},
numpages = {3},
keywords = {Augmented reality, Smartphone-based, Surface-anchored Display},
location = {
},
series = {UIST Adjunct '25}
}

@inproceedings{10.1145/3770855.3818659,
author = {Cenacchi, Filippo and Cao, Longbing and Richards, Deborah},
title = {The Decision Twin: Metaverse Patient Digital Twins as Executable Clinical Reality},
year = {2026},
isbn = {9798400722592},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3770855.3818659},
doi = {10.1145/3770855.3818659},
abstract = {Clinical AI is no longer bottlenecked only by model performance; it is bottlenecked by the accountable interaction loop through which clinicians and patients inspect evidence, test alternatives, and remain responsible for decisions under uncertainty. We argue that today's digital-twin systems, XR interfaces, and foundation-model copilots each address part of this loop, but they fail when deployed as separate products: predictions are not replayable across time, XR becomes descriptive visualization without executable state, and copilots are fluent without auditable grounding. We introduce the Metaverse Patient Digital Twin (MPDT) as a decision-grade clinical artifact defined by one requirement: every displayed claim or simulated scenario must be traceable to a versioned patient state, explicit assumptions, and replayable interaction logs. We specify minimal acceptance criteria, a reference loop in which stakeholders observe new evidence, update the twin state, run bounded simulations, generate explanations, commit decisions, and then log and monitor outcomes, along with a compact architecture that binds interoperability, simulation, governed interaction, and lifecycle controls. Finally, we outline workflows (risk stratification, diagnosis support, treatment rehearsal, training, cross-site coordination) and the evidence required to make MPDTs defensible: calibration over time, subgroup reliability, category-error prevention (observation vs simulation), and measurable workflow outcomes.},
booktitle = {Proceedings of the 32nd ACM SIGKDD Conference on Knowledge Discovery and Data Mining V.2},
pages = {13157–13163},
numpages = {7},
keywords = {patient digital twin, medical digital twin, extended reality (xr), metaverse healthcare, counterfactual simulation, explainable ai.},
location = {Republic of Korea},
series = {KDD '26}
}

@inproceedings{10.1145/3772363.3798643,
author = {Jeong, SangYeop and Na, Yeongseo and Jeong, Seung Gyu and Jeong, Jin-Woo and Kim, Seong-Eun},
title = {Reading the Mood Behind Words: Integrating Prosody-Derived Emotional Context into Socially Responsive VR Agents},
year = {2026},
isbn = {9798400722813},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3772363.3798643},
doi = {10.1145/3772363.3798643},
abstract = {In VR interactions with embodied conversational agents, users’ emotional intent is often conveyed more by how something is said than by what is said. However, most VR agent pipelines rely on speech-to-text processing, discarding prosodic cues and often producing emotionally incongruent responses despite correct semantics. We propose an emotion-context-aware VR interaction pipeline that treats vocal emotion as explicit dialogue context in an LLM-based conversational agent. A real-time speech emotion recognition model infers users’ emotional states from prosody, and the resulting emotion labels are injected into the agent’s dialogue context to shape response tone and style. We conducted a within-subjects VR study (N = 30) using semantically neutral and emotionally ambiguous utterances, comparing an emotion-aware agent with a text-only baseline. Results show significant improvements in dialogue quality, naturalness, engagement, rapport, and human-likeness, with 93.3\% of participants preferring the emotion-aware agent. These findings suggest that prosody-derived emotional context enables socially responsive VR conversations.},
booktitle = {Proceedings of the Extended Abstracts of the 2026 CHI Conference on Human Factors in Computing Systems},
articleno = {548},
numpages = {12},
keywords = {Virtual Reality, VR Conversational Agents, Vocal Prosody, Social Presence, User Experience},
location = {
},
series = {CHI EA '26}
}

@inproceedings{10.1145/3774521.3774615,
author = {Kaur, Supreet and Parakh, Ajay and Pareek, Vishakha and Nagar, Rajendra and Chaudhury, Santanu},
title = {Knowledge-Based Metaverse for Crafts},
year = {2026},
isbn = {9798400719301},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3774521.3774615},
doi = {10.1145/3774521.3774615},
abstract = {This paper presents an interactive and knowledge-driven metaverse designed to promote and preserve heritage crafts. Heritage crafts have tangible and intangible elements in the form of artefacts, materials and craftsmanship, representing a fusion of declarative and procedural knowledge. Many craft forms, sustained by the talents and understanding of artisans, are now endangered, rendering their preservation increasingly imperative. Metaverse and XR technologies have the potential to safeguard heritage as they are immersive platforms, but lack intelligence to support deeper understanding and interaction. In this work we are using Knowledge Augmented Generation (KAG) as the core architecture of our 3D craft world. KAG combine the power of LLMs and knowledge graphs to represent descriptive, factual and procedural knowledge about crafts. Within the platform, users can interact with the digital twins of craft artefacts by virtually holding them and knowing more about crafts through a 3D guide. We have implemented a KAG-driven 3D virtual guide to enhance learning and user engagement. The KAG framework has been evaluated for our heritage data using an F1 score, and the results indicate its effectiveness in representing and retrieving craft knowledge. Further, we have also explored the use of generative AI to co-create in the heritage metaverse.},
booktitle = {Proceedings of the Sixteen Indian Conference on Computer Vision, Graphics and Image Processing},
articleno = {88},
numpages = {8},
keywords = {Intelligent Metaverse, Heritage Metaverse, Extended Reality},
location = {
},
series = {ICVGIP '25}
}

@inproceedings{10.1145/3746058.3759017,
author = {Yao, Zhihao and Yao, Xiwen and Sun, Qirui and Xiong, Haowei and Lau, Kin Wang and Mi, Haipeng},
title = {Gesture2Prop: Conditional VR Prop Generation from Hand Gestures and Speech},
year = {2025},
isbn = {9798400720369},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3746058.3759017},
doi = {10.1145/3746058.3759017},
abstract = {Virtual reality is increasingly used in education, gaming, and creative fields, yet 3D modeling remains a complex process, limiting natural and efficient interaction. While generative AI has advanced text-to-3D techniques, intuitive inputs like hand gestures are still underexplored. Inspired by everyday gesture-based expression, this paper proposes a method that combines bimanual gestures with voice input to rapidly generate graspable 3D props in VR. By analyzing the spatial features and implicit intent of hand gestures, the system automatically infers the object’s size, grip type, and interaction pose, enabling natural and well-fitted 3D model.},
booktitle = {Adjunct Proceedings of the 38th Annual ACM Symposium on User Interface Software and Technology},
articleno = {38},
numpages = {4},
keywords = {Virtual Reality, 3D Content Generation, Hand Gesture Interaction},
location = {
},
series = {UIST Adjunct '25}
}

@inproceedings{10.1145/3811427.3811456,
author = {Wu, Guande and Turakhia, Dishita and Wu, Eden and Quispe, Sonia Castelo and Rulff, Jo{\~a}o and McGowan, Erin and He, Jianben and Wang, Yawei and Qian, Jing and Silva, Claudio},
title = {InsightAR: A Tool for Multi-modal Summarization and Interactive Analysis of AR-based Egocentric Task Videos},
year = {2026},
isbn = {9798400723421},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3811427.3811456},
doi = {10.1145/3811427.3811456},
abstract = {The growing use of head-mounted AR devices has produced a surge of egocentric recordings of procedural tasks—step-by-step activities such as medical procedures—creating rich opportunities for performance analysis. Yet current analyses are time-consuming, requiring substantial manual inspection to identify events, actions, and objects from videos, with little automated support for surfacing insights or errors. We introduce InsightAR, a visual analytics tool that integrates event detection, action recognition, and multi-modal language models to create video summaries capturing key errors and insights. Its interface further enables users to refine generated insights and errors collaboratively. A user study (N=16) found that&nbsp;InsightAR&nbsp;identifies significantly more errors and marginally significant insight numbers than the baseline. Our work demonstrated the feasibility and potential benefits of future human-AI collaborative video analysis.},
booktitle = {Proceedings of the 2026 International Conference on Advanced Visual Interfaces},
articleno = {7},
numpages = {9},
keywords = {Video Analysis, Multimodal Video Summarization, Egocentric Videos, Task Performance Analysis, Augmented Reality, Visual Analytics},
location = {
},
series = {AVI '26}
}

@inproceedings{10.1145/3719160.3736636,
author = {Maslych, Mykola and Katebi, Mohammadreza and Lee, Christopher and Hmaiti, Yahya and Ghasemaghaei, Amirpouya and Pumarada, Christian and Palmer, Janneese and Segarra Martinez, Esteban and Emporio, Marco and Snipes, Warren and McMahan, Ryan P. and LaViola Jr., Joseph J.},
title = {Mitigating Response Delays in Free-Form Conversations with LLM-powered Intelligent Virtual Agents},
year = {2025},
isbn = {9798400715273},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3719160.3736636},
doi = {10.1145/3719160.3736636},
abstract = {We investigated the challenges of mitigating response delays in free-form conversations with virtual agents powered by Large Language Models (LLMs) within Virtual Reality (VR). For this, we used conversational fillers, such as gestures and verbal cues, to bridge delays between user input and system responses and evaluate their effectiveness across various latency levels and interaction scenarios. We found that latency above 4 seconds degrades quality of experience, while natural conversational fillers improve perceived response time, especially in high-delay conditions. Our findings provide insights for practitioners and researchers to optimize user engagement whenever conversational systems’ responses are delayed by network limitations or slow hardware. We also contribute an open-source pipeline that streamlines deploying conversational agents in virtual environments.},
booktitle = {Proceedings of the 7th ACM Conference on Conversational User Interfaces},
articleno = {49},
numpages = {15},
keywords = {Conversational interfaces, LLM, VR, user study, response latency.},
location = {
},
series = {CUI '25}
}

@inproceedings{10.1145/3820915.3820964,
author = {Wang, Cheng and Zeng, Tongfei and Yang, Hang and Zang, Hao and Zhou, Zilan},
title = {Breaking DoRA's Efficiency Ceiling: Explicit Magnitude-Direction Collaborative Reinforcement for Parameter-Efficient Fine-Tuning},
year = {2026},
isbn = {9798400723612},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3820915.3820964},
doi = {10.1145/3820915.3820964},
abstract = {DoRA advances parameter-efficient fine-tuning (PEFT) by decomposing weights into magnitude and direction components, motivated by the observation that full fine-tuning exhibits strong negative correlation (ρ = −0.62) between their updates. However, DoRA’s implicit coupling achieves only weak correlation (ρ = −0.31), leaving substantial synergistic potential unrealized. We identify this magnitude-direction coordination gap as the fundamental bottleneck limiting DoRA’s efficiency. We propose explicit bi-level collaborative reinforcement that actively monitors and constrains the correlation toward full fine-tuning targets through adaptive loss weighting. The mechanism operates at two granularities: block-level constraints ensure global coordination across Transformer layers, while layer-level constraints provide targeted correction for severely deviating projection matrices. Experiments on vision-language retrieval benchmarks (Flickr30k&nbsp;[16], MSCOCO&nbsp;[11], Visual Genome&nbsp;[8]) with CLIP&nbsp;[19] and BLIP&nbsp;[9] models show our method improves Recall@1 by 2.7-3.2\% over DoRA while using identical trainable parameters (less than 1.1\%), achieving magnitude-direction correlation of ρ = −0.53 that substantially closes the gap toward full fine-tuning’s ρ = −0.62.},
booktitle = {Proceedings of the 2nd International Conference on Artificial Intelligence, Virtual Reality and Interaction Design},
pages = {324–331},
numpages = {8},
keywords = {Parameter-Efficient Fine-Tuning, Vision-Language Models, Magnitude-Direction Coordination, DoRA, Collaborative Reinforcement},
location = {
},
series = {AIVRID '26}
}

@inproceedings{10.1145/3757980.3758011,
author = {Shawash, Janset and Thibault, Mattia},
title = {The Immersive Cookbook: Co-Designing Recipes for Spatial XR in the Creative Industries},
year = {2025},
isbn = {9798400715129},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3757980.3758011},
doi = {10.1145/3757980.3758011},
abstract = {This hands-on workshop invites participants to co-design conceptual "recipes" for immersive experiences across four creative sectors: urban environments, museums and heritage, journalism and entertainment, and physical games and play. Drawing on the metaphor of a cookbook, participants will engage with XR "ingredients" (technologies, content types, interaction modes) and "cooking techniques" (design strategies, generative AI, spatial augmentation) to develop speculative but grounded prototypes. The workshop combines creative worldbuilding, AI-assisted co-creation, and participatory design methods to reflect on XR's spatial, inclusive, and experiential dimensions. Framed within the traditions of participatory design, speculative design, spatial theory, and experience-centered research, the session explores XR as a socially situated, layered medium. Outcomes will contribute to an evolving Immersive XR Cookbook and support broader research on low-threshold, context-sensitive XR design. This workshop is developed as part of the research activities of the NEXR (Next Extended Reality) project, which explores accessible, culturally grounded, and sector-specific XR adoption in Finland's creative industries.},
booktitle = {Proceedings of the 28th International Academic Mindtrek Conference},
pages = {445–448},
numpages = {4},
keywords = {Extended Reality (XR) Design, Generative AI, Inclusive Co-Creation Practices, Participatory Speculative Methods, Spatial Interaction},
location = {
},
series = {Mindtrek '25}
}

@inproceedings{10.1145/3641825.3689529,
author = {Schott, Ephraim and L{\'o}pez Garc{\'i}a, Irene and Zoeppig, Tony Jan and Hartmann, Manuel and Froehlich, Bernd},
title = {The Guide's Apprentices: Engaging Visitors of Virtual Museums through Appropriate Agent Embodiments},
year = {2024},
isbn = {9798400705359},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3641825.3689529},
doi = {10.1145/3641825.3689529},
abstract = {Embodied conversational agents are an established approach for immersively conveying the narratives and information of virtual museums. Recent advances in large language models and text-to-speech systems enable the active guidance of users by agents and raise the question of how such assistants should be visually embodied to engage visitors and promote knowledge transfer. This demo showcases a stylized humanoid guide, a novel animism-based approach with speaking objects, and a combination of both concepts to interactively guide users through a digital replica of the famous Gropius Room at the Bauhaus University in Weimar.},
booktitle = {Proceedings of the 30th ACM Symposium on Virtual Reality Software and Technology},
articleno = {83},
numpages = {2},
keywords = {Agent Embodiment, Conversational Agent, VR, Virtual Museum},
location = {Trier, Germany},
series = {VRST '24}
}

@article{10.1145/3841187,
author = {Liu, Yikuan and Guo, Siqi and Mousas, Christos},
title = {Don’t Just Fill the Silence: Exploring Conversational Filler Strategies in Embodied Virtual Agents},
year = {2026},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
issn = {1544-3558},
url = {https://doi.org/10.1145/3841187},
doi = {10.1145/3841187},
abstract = {Conversational fillers, such as short vocalizations (e.g., “uh,” “um”) or brief phrases that manage conversational flow, are increasingly used in embodied virtual agents. Yet, their effects on users’ perceptions remain insufficiently understood. Thus, we investigated how different conversational filler strategies shape users’ perceptions and experiences during interaction with an embodied virtual agent. We implemented a large language model (LLM)-driven conversational system that selects fillers from predefined sets and integrates them with generated responses via a prompt-engineered mechanism that maintains continuity between the filler and the response. In a within-group study ( (N=24) ), participants interacted with the agent across four conditions: filler-free (baseline), short, general, and context-specific fillers. Results showed that all filler types significantly improved perceived response time and reduced estimated response time relative to the filler-free condition. However, context-specific fillers provided additional benefits, including higher perceived filler quality, rapport, likability, willingness for future interaction, and lower uncanny valley ratings. Additional analyses showed that higher perceived filler quality and more favorable perceived response time were correlated with more positive perceptions of the agent and the interaction experience. These findings suggest that conversational fillers serve two roles: as temporal signals that reduce perceived delay and as context-sensitive cues that shape social perception, with meaningful benefits emerging only when fillers are contextually aligned.},
note = {Just Accepted},
journal = {ACM Trans. Appl. Percept.},
month = aug,
keywords = {Response Fillers, Response Delay Perception, Conversational Virtual Agents, Virtual Reality}
}

@inproceedings{10.1145/3820915.3821112,
author = {Wu, Wenyan},
title = {A Study on AIGC-Driven Interactive Design and User Perception of Cantonese Embroidery as Intangible Cultural Heritage Based on the Kano Model: A Case Study of New Chinese-Style Luggage},
year = {2026},
isbn = {9798400723612},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3820915.3821112},
doi = {10.1145/3820915.3821112},
abstract = {In the digital age, the living transmission of intangible cultural heritage faces an urgent need for transformation. Generative artificial intelligence offers efficient visual generation solutions for traditional clothing design; however, current applications largely remain limited to superficial generation, lacking precise translation of complex cultural elements and quantitative evaluation of user perception. This paper proposes a closed-loop framework for AIGC-driven ICH interactive design based on the Kano model. Using Cantonese embroidery and new Chinese-style luggage as case studies, the framework establishes a semantic mapping mechanism that translates the implicit craftsmanship of Cantonese embroidery into prompts for large language models, thereby generating high-fidelity visual prototypes. and conducting quantitative measurements of audience perception preferences via Kano Model questionnaires. The aim is to break through the barriers of traditional generative design's heavy reliance on subjective experience, providing scientific design methods and strategic insights for the cross-disciplinary integration and commercial transformation of intangible cultural heritage in the digital age.},
booktitle = {Proceedings of the 2nd International Conference on Artificial Intelligence, Virtual Reality and Interaction Design},
pages = {1260–1265},
numpages = {6},
keywords = {Cantonese Embroidery, Generative Artificial Intelligence, Interaction Design, Kano Model, New Chinese-Style Luggage, User Perception},
location = {
},
series = {AIVRID '26}
}

@inproceedings{10.1145/3756884.3766039,
author = {Jang, Jaewoong and Cho, Sungjae and Shin, Yeseul and Hwang, Inseok},
title = {ArithMotion: Peer-Relative Motion Generation for Social VR via Arithmetic Metaphor},
year = {2025},
isbn = {9798400721182},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3756884.3766039},
doi = {10.1145/3756884.3766039},
abstract = {In social VR, bodily motions are a major nonverbal channel for expressing intent or emotion. However, freely making bodily motions is not always possible due to unaffordability of rich tracking devices, physical disabilities, or social/spatial constraints. While current social VR platforms provide methods like emotes, expressions are limited to a finite preset. To facilitate open-ended and socially-aligned motion in constrained environments, our insight is peer-relativity found in everyday interaction. Specifically, we propose ArithMotion, an end-to-end system to generate peer-relative motions by combining generative models with arithmetic-inspired interaction. We fully implemented and iteratively refined the system. User studies show participants experienced novel, open-ended expressions closely tied to social context.},
booktitle = {Proceedings of the 2025 31st ACM Symposium on Virtual Reality Software and Technology},
articleno = {70},
numpages = {12},
keywords = {Social VR, Peer-Relativity, Motion Generation},
location = {
},
series = {VRST '25}
}

@inproceedings{10.1145/3703619.3706043,
author = {Wang, Pan and Zhang, Xun and Zhou, Zhibin and Childs, Peter and Lee, Kunpyo and Kleinsmann, Maaike and Wang, Stephen Jia},
title = {Typeface Generation through Style Descriptions With Generative Models},
year = {2025},
isbn = {9798400713484},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3703619.3706043},
doi = {10.1145/3703619.3706043},
abstract = {Typeface design plays a vital role in graphic and communication design. Different typefaces are suitable for different contexts and can convey different emotions and messages. Typeface design still relies on skilled designers to create unique styles for specific needs. Recently, generative adversarial networks (GANs) have been applied to typeface generation, but these methods face challenges due to the high annotation requirements of typeface generation datasets, which are difficult to obtain. Furthermore, machine-generated typefaces often fail to meet designers’ specific requirements, as dataset annotations limit the diversity of the generated typefaces. In response to these limitations in current typeface generation models, we propose an alternative approach to the task. Instead of relying on dataset-provided annotations to define the typeface style vector, we introduce a transformer-based language model to learn the mapping between a typeface style description and the corresponding style vector. We evaluated the proposed model using both existing and newly created style descriptions. Results indicate that the model can generate high-quality, patent-free typefaces based on the input style descriptions provided by designers. The code is available at: https://github.com/tqxg2018/Description2Typeface},
booktitle = {Proceedings of the 19th ACM SIGGRAPH International Conference on Virtual-Reality Continuum and Its Applications in Industry},
articleno = {12},
numpages = {12},
keywords = {Artificial Intelligence, Computer vision, Generative Adversarial Networks, Typeface Design, Typeface generation},
location = {Nanjing, Guangdong Province, China},
series = {VRCAI '24}
}

@inproceedings{10.1145/3772363.3798902,
author = {Yu, Yue and Yu, Zhitao},
title = {Designing for Staying with Emotions: An AR System Driven by Generative AI to Support Emotional Participation in Children with Autism},
year = {2026},
isbn = {9798400722813},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3772363.3798902},
doi = {10.1145/3772363.3798902},
abstract = {Children with autism spectrum disorder (ASD) often face challenges in emotion recognition and expression. Existing emotional intervention approaches remain limited in their ability to provide personalized support, facilitate contextual transfer, and offer adaptive interaction feedback. Recent advances in generative artificial intelligence and augmented reality (AR) have opened new possibilities for designing situated and immersive emotional support systems; however, systematic explorations of their interaction design for neurodiverse children remain scarce. In this paper, we present MOODMATE, a multimodal emotional cognition support system that integrates generative AI and AR. The system supports children with ASD in engaging with emotional understanding and expression within real-life contexts through character-driven situated narratives, parent-involved personalization mechanisms, and multimodal emotional feedback. We report findings from a four-week exploratory deployment study in which ten children with ASD aged 5–10 used the system in their home environments. Drawing on scale-based measures, system usage logs, and parent interviews, we identify patterns of multimodal emotional interaction, experiential characteristics, and emerging design challenges. Our findings highlight design opportunities related to safety, interpretability, and parental collaboration in generative AI–driven emotional support systems, and offer preliminary insights for the interaction design of emotional interventions for neurodiverse children.},
booktitle = {Proceedings of the Extended Abstracts of the 2026 CHI Conference on Human Factors in Computing Systems},
articleno = {222},
numpages = {5},
keywords = {Autism Spectrum Disorder, Generative Artificial Intelligence, Multimodal Interaction, Augmented Reality, Emotional Cognition Support},
location = {
},
series = {CHI EA '26}
}

@inproceedings{10.1145/3664647.3681618,
author = {Bi, Jing and Tang, Yunlong and Song, Luchuan and Vosoughi, Ali and Nguyen, Nguyen and Xu, Chenliang},
title = {EAGLE: Egocentric AGgregated Language-video Engine},
year = {2024},
isbn = {9798400706868},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3664647.3681618},
doi = {10.1145/3664647.3681618},
abstract = {The rapid evolution of egocentric video analysis brings new insights into understanding human activities and intentions from a first-person perspective. Despite this progress, the fragmentation in tasks like action recognition, procedure learning, and moment retrieval, etc, coupled with inconsistent annotations and isolated model development, hinders a holistic interpretation of video content. In response, we introduce the EAGLE (Egocentric AGgregated Language-video Engine) model and the EAGLE-400K dataset to provide a unified framework that integrates various egocentric video understanding tasks. EAGLE-400K, the first large-scale instruction-tuning dataset tailored for egocentric video, features 400K diverse samples to enhance a broad spectrum task from activity recognition to procedure knowledge learning. Moreover, EAGLE, a strong video multimodal large language model (MLLM), is designed to effectively capture both spatial and temporal information. In addition, we propose a set of evaluation metrics designed to facilitate a thorough assessment of MLLM for egocentric video understanding. Our extensive experiments demonstrate EAGLE's superior performance over existing models, highlighting its ability to balance task-specific understanding with holistic video interpretation. With EAGLE, we aim to pave the way for research opportunities and practical applications in real-world scenarios.},
booktitle = {Proceedings of the 32nd ACM International Conference on Multimedia},
pages = {1682–1691},
numpages = {10},
keywords = {augmented reality, egocentric video analysis, egocentric video dataset, multimodal large language models (mllms), spatial and temporal information processing},
location = {Melbourne VIC, Australia},
series = {MM '24}
}

@inproceedings{10.1145/3665318.3677172,
author = {Ribeiro, Marcos and Santos, Joana and Lobo, Jo{\~a}o and Ara{\'u}jo, S{\'i}lvia and Magalh{\~a}es, Lu{\'i}s and Ad{\~a}o, Telmo},
title = {VR, AR, gamification and AI towards the next generation of systems supporting cultural heritage: addressing challenges of a museum context},
year = {2024},
isbn = {9798400706899},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3665318.3677172},
doi = {10.1145/3665318.3677172},
abstract = {This paper explores the development and integration of a system combining Augmented Reality (AR), Virtual Reality (VR), and gamification within a museum setting to enhance the presentation and interaction with cultural heritage. The technological framework employs AR for dynamic artifact interaction and in situ navigation, while VR capabilities facilitate virtual tours, broadening access for individuals with disabilities or those from distant geographies or socioeconomically disadvantaged backgrounds. Gamification transforms educational content into interactive experiences, fostering deeper engagement and learning. Moreover, aligning with the mission of museum institutions for cultural heritage preservation, a module for digital conservation and reconstruction was developed resorting to photogrammetry-based approaches. This module aims to create a virtual catalog accessible to both experts and the general public. Artificial Intelligence (AI) tools automate tasks such as generating thematic quizzes for gamification and cataloging scanned artifacts. The system aims to improve the interpretative and educational potential of museum exhibits, modernizing visitor engagement while preserving the integrity of physical artifacts and spaces. Its continuous evolution aims to bridge traditional forms of cultural preservation and promotion with contemporary digital interaction techniques, leveraged from cost-effective publicly accessible edge technologies.},
booktitle = {Proceedings of the 29th International ACM Conference on 3D Web Technology},
articleno = {9},
numpages = {10},
keywords = {Augmented Reality (AR), Deep Learning, Digital Museum, Gamification, Generative Artificial Intelligence, Photogrammetry, Virtual Museum, Virtual Reality (VR)},
location = {Guimar{\~a}es, Portugal},
series = {Web3D '24}
}

@inproceedings{10.1145/3641234.3671078,
author = {Lan, Alfred and Tsai, Tai-Chen and Huang, Chih-Chuan and Ching, Pu and Pan, Tse-Yu and Hu, Min-Chun},
title = {ImmerseSketch: Transforming Creative Prompts into Vivid 3D Environments in VR},
year = {2024},
isbn = {9798400705168},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3641234.3671078},
doi = {10.1145/3641234.3671078},
abstract = {We propose ImmerseSketch, a framework designed to transform creative prompts into vivid and detailed 3D content within a Virtual Reality (VR) environment. Our aim is to inspire creative ideation and to provide creators with 3D reference content for painting. However, the computational demands of diffusion models for 3D model generation and the scarcity of high-quality 3D datasets limit the diversity and intricacy of the generated environments. To overcome these obstacles, we focus on generating initial panoramic images through diffusion models and then converting these images into rich 3D environments with the aid of depth estimation. The pilot study shows that the proposed ImmerseSketch can provide an immersive environment and assist the process of creation.},
booktitle = {ACM SIGGRAPH 2024 Posters},
articleno = {56},
numpages = {2},
keywords = {Generative Environment, VR Creation, Virtual Reality},
location = {Denver, CO, USA},
series = {SIGGRAPH '24}
}

@inproceedings{10.1145/3626495.3626497,
author = {Ghorbani Lohesara, Fatemeh and Egiazarian, Karen and Knorr, Sebastian},
title = {Expression-aware video inpainting for HMD removal in XR applications},
year = {2023},
isbn = {9798400704260},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3626495.3626497},
doi = {10.1145/3626495.3626497},
abstract = {Head-mounted displays (HMDs) serve as indispensable devices for observing extended reality (XR) environments and virtual content. However, HMDs present an obstacle to external recording techniques as they block the upper face of the user. This limitation significantly affects social XR applications, specifically teleconferencing, where facial features and eye gaze information play a vital role in creating an immersive user experience. In this study, we propose a new network for expression-aware video inpainting for HMD removal (EVI-HRnet) based on generative adversarial networks (GANs). Our model effectively fills in missing information with regard to facial landmarks and a single occlusion-free reference image of the user. The framework and its components ensure the preservation of the user’s identity across frames using the reference frame. To further improve the level of realism of the inpainted output, we introduce a novel facial expression recognition (FER) loss function for emotion preservation. Our results demonstrate the remarkable capability of the proposed framework to remove HMDs from facial videos while maintaining the subject’s facial expression and identity. Moreover, the outputs exhibit temporal consistency along the inpainted frames. This lightweight framework presents a practical approach for HMD occlusion removal, with the potential to enhance various collaborative XR applications without the need for additional hardware.},
booktitle = {Proceedings of the 20th ACM SIGGRAPH European Conference on Visual Media Production},
articleno = {7},
numpages = {9},
keywords = {extended reality, generative adversarial networks, head-mounted display, immersive teleconferencing, video inpainting},
location = {London, United Kingdom},
series = {CVMP '23}
}

@inproceedings{10.1145/3777730.3777860,
author = {Xie, Hongyuan and Wang, Hongshu and Zhao, Xueyu},
title = {Submission Template AI-Driven Cross-Media Virtual Actor IP Ecosystem},
year = {2026},
isbn = {9798400718540},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3777730.3777860},
doi = {10.1145/3777730.3777860},
abstract = {This study explores the IP evolution of AI-driven virtual actors across cross-media environments. By integrating multimodal generative models such as Stable Diffusion, Sora, and AudioCraft, it proposes a systematic AI Persona IP framework covering character creation, narrative expansion, and brand consolidation. Redundant descriptions of the framework are condensed, emphasizing its unique contribution to IP lifecycle extension. A comparative perspective is introduced by aligning the model with classical frameworks such as Keller's Brand Equity Model and Aaker's Brand Building Process, demonstrating its alignment with established IP management theory. Empirical results based on 1,200 multimodal samples and 300,000 interaction records show that AI virtual actors outperform human actors in lifecycle duration, communication reach, and ROI, with 33\% higher fan retention and 60\% more brand collaborations. The findings indicate that AI virtual humans are becoming key intelligent assets in the digital content economy, reshaping creative production and value-chain structures. This work provides theoretical insight and a practical framework for sustainable development within the intelligent entertainment ecosystem.},
booktitle = {Proceedings of the 2025 International Conference on Artificial Intelligence, Virtual Reality and Interaction Design},
pages = {805–808},
numpages = {4},
keywords = {AI virtual humans, multimodal generative models, cross-media narrative, brand incubation, digital persona IP, diffusion models, large language models (LLMs)},
location = {
},
series = {AIVRID '25}
}

@inproceedings{10.1145/3715336.3735844,
author = {Ji, Hongfei and Hu, Peiyu and EL-Zanfaly, Dina},
title = {Reshaping Craft Learning: Insights from Designing an AI-Augmented MR System for Wheel-Throwing},
year = {2025},
isbn = {9798400714856},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3715336.3735844},
doi = {10.1145/3715336.3735844},
abstract = {The growth of media technologies and maker culture has expanded craft learning from instructor-guided models to diverse self-directed approaches. However, mastering crafts such as ceramics remains challenging due to their embodied nature and the difficulty of tacit knowledge transfer. While Mixed Reality (MR) and Artificial Intelligence (AI) have supported embodied task learning, their application in craft remains underexplored. We present an AI-augmented MR ceramic guiding system to investigate the interplay between these technologies and craft practices, including how they influence instruction design, shape user perception, and transform learning contexts. Our system provides immersive multimedia instruction and real-time shape-based feedback using computer vision and large language models (LLMs) to guide learners in wheel-throwing on a pottery wheel. Through a Research-through-Design process, we co-designed and evaluated the system with twenty novices and experienced ceramic practitioners. We offer design insights for AI-MR craft learning systems and identify opportunities to extend their application to creative, collaborative, and broader craft-making scenarios.},
booktitle = {Proceedings of the 2025 ACM Designing Interactive Systems Conference},
pages = {2549–2573},
numpages = {25},
keywords = {Mixed Reality, Interactive AI, Embodied Learning, Craft Learning, Personalized Learning, Instructional Design},
location = {
},
series = {DIS '25}
}

@inproceedings{10.1145/3787120.3787129,
author = {Bryson, Kathleen and Richardson, Kathleen},
title = {Designing Ethics or Manipulating It: Who Needs Ethics in a Multi-Agent Virtual Space?},
year = {2026},
isbn = {9798400722905},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3787120.3787129},
doi = {10.1145/3787120.3787129},
abstract = {In rapidly evolving virtual environments involving human, robotic and AI-based agents, ethical oversight becomes increasingly complex. Traditional frameworks often treat non-human agents as tools, overlooking the relational and distributed nature of influence in multi-agent systems. This paper applies the Good Enough Ethics (GEE) framework, developed through interdisciplinary dialogue and real-world technological collaboration, as a responsive alternative to checklist or perfectionist models. Centred on six relational principles – attachment, trust, autonomy, privacy, justice and responsibility – GEE embraces embedded, iterative and co-designed ethical practice. Our central questions – Who is ethics for? and Should the same ethical principles apply across all agents? – guide two case studies: a qualitative study of the SHARESPACE XR platform and a speculative application to Large Language Models (LLMs). We explore how ethics can be manipulated as performance, and how GEE enables a differentiated, pragmatic approach to ethics across varied agent types.},
booktitle = {Proceedings of the 2025 5th International Conference on Artificial Intelligence and Application Technologies},
pages = {88–93},
numpages = {6},
keywords = {ai ethics, ethics by design, extended reality (xr), human–machine interaction, multi-agent systems},
location = {
},
series = {AIAT '25}
}

@inproceedings{10.1145/3799825.3818743,
author = {Gallardo, Rodrigo and Doudatcz, Qilmeg and Goldstein, Ganit and Sarimehmetoglu, IIkyaz and Mutis, Sergio and Kyaw, Alexander Htet and Lin, Anita and Emmerling, Clara and Ataman, Berfin and Tibbits, Skylar},
title = {Context Aware AI Assistant and AR Interface for Lunar Extravehicular Activity (EVA) Procedural Guidance},
year = {2026},
isbn = {9798400725487},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3799825.3818743},
doi = {10.1145/3799825.3818743},
abstract = {As human space exploration returns to the Moon, astronauts need rapid access to procedural information during extravehicular activities (EVAs), where attention is divided across navigation, repair tasks, tool handling, and environmental risk. The challenge is not the absence of information, but surfacing the right information at the right moment. We present GAIN-AI (Guided Assistant for Intelligent Navigation), a context-aware AI assistant and minimal heads-up interface for procedural guidance in simulated lunar EVA. The system operates in two layers. The first grounds a large language model with structured context: EVA procedure documents, live telemetry data, and error-handling protocols encoded as JSON. The second restructures that output into three compact units for AR display: Goal, Task, and Verification. Evaluated on 111 synthetic EVA scenarios, the system scores 10.0/10 on nominal conditions and 8.15/10 on single-fault scenarios, with performance degrading on multi-fault and boundary-threshold cases.},
booktitle = {Proceedings of the Special Interest Group on Computer Graphics and Interactive Techniques Conference Posters},
articleno = {45},
numpages = {3},
keywords = {Augmented Reality, Heads-Up Display, Extravehicular Activity, Procedural Guidance, Human-AI Interaction, Lunar Surface Operations},
location = {
},
series = {SIGGRAPH Posters '26}
}

@inproceedings{10.1145/3681756.3697877,
author = {Kim, Daun and Jeong, Jin-Woo},
title = {Designing LLM Response Layouts for XR Workspaces in Vehicles},
year = {2024},
isbn = {9798400711381},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3681756.3697877},
doi = {10.1145/3681756.3697877},
abstract = {This study investigates the design of response layouts for large language models in XR environments for vehicle settings. Our formative study identified usability challenges with the current linear layout, such as difficulties in extensive scrolling and mid-air interactions. Based on these findings, we designed an improved layout that utilizes multiple windows for efficient access to diverse content, with a cohesive placement to minimize motion sickness. A user study with 24 participants compared the proposed interface against a conventional web browser interface through various information-seeking tasks. The results demonstrated that the proposed interface enhanced overall usability compared to the baseline.},
booktitle = {SIGGRAPH Asia 2024 Posters},
articleno = {5},
numpages = {2},
location = {
},
series = {SA '24}
}

@inproceedings{10.1145/3756884.3768420,
author = {Jiang, Yushu and Tan, Jilliane and McEwan, Bree L},
title = {Towards Generative and Expressive 3D Facial Animations},
year = {2025},
isbn = {9798400721182},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3756884.3768420},
doi = {10.1145/3756884.3768420},
abstract = {Expressive 3D facial animation is a key component for realistic avatars in immersive XR. While face motion capture can produce high-quality results, this approach is impractical in settings without on-device capture hardware for real-time tracking and does not address the growing demand for conversational AI avatars. In parallel, there is rapid progress in 2D talking head generation, producing expressive videos of faces driven by audio. However, these methods are for flat-screen media and cannot be directly applied to XR avatars. In this work, we leverage advances in 2D generative methods and explore a video-to-3D facial animation pipeline. We extract ARKit blendshape parameters and head poses from generated or real videos, and apply them to 3D rigs. To improve efficiency, we further investigate training an audio-to-rig model directly, bypassing pixel-space generation. Early experiments demonstrate both feasibility and challenges. We discuss how such generative pipelines could enable flexible, emotionally expressive avatars for XR, with applications to conversational AI, NPCs, and telepresence.},
booktitle = {Proceedings of the 2025 31st ACM Symposium on Virtual Reality Software and Technology},
articleno = {140},
numpages = {3},
location = {
},
series = {VRST '25}
}

@inproceedings{10.1145/3820915.3821003,
author = {Deng, Yanfeng and Ruan, Yuqing},
title = {Research on Digital Visual Communication and Style Adaptation Based on Generative AI},
year = {2026},
isbn = {9798400723612},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3820915.3821003},
doi = {10.1145/3820915.3821003},
abstract = {Traditional visual communication design has problems with long creation cycles and difficult style control, making it difficult to ssmeet the multi platform and high-frequency content production needs in digital communication scenarios. In response to the above challenges, we propose a style adaptive generative AI for digital visual communication called StyleGrad. This method uses MT5 as the basic model for extending prompt words, modeling style intensity as a gradient distribution in the semantic space, achieving automatic extension from short style words to multi-level detailed prompt words. We design Style Intensity Contrastive Loss (SIC Loss) to form an ordered semantic distribution of different intensity descriptions through triplet constraints, and introduce cross modal consistency loss constraints to generate semantic alignment between text and style images, ensuring that the expanded prompts faithfully preserve the core visual semantics of the target style. In addition, we constructed a style description dataset containing 50 visual styles across four categories and 5000 samples, each with standardized low, medium, and high intensity descriptions paired with reference images. The experimental results showed that StyleGrad achieved a generation quality of FID 23.76 and CLIP Score 0.318, with a style intensity control accuracy of 76.42\%. Compared to the suboptimal method, it improved by 8.01\%, 3.25\%, and 3. 14\% respectively, validating the effectiveness of the proposed approach in controllable style generation for digital visual communication.},
booktitle = {Proceedings of the 2nd International Conference on Artificial Intelligence, Virtual Reality and Interaction Design},
pages = {576–583},
numpages = {8},
keywords = {Adaptive style, Digital Visual Communication, Generative AI, prompt},
location = {
},
series = {AIVRID '26}
}

@inproceedings{10.1145/3770445.3770491,
author = {Zhao, Yu},
title = {VR Art Perception Computing Framework Design Integrating Embodied Phenomenology and Multimodal Feature Learning},
year = {2025},
isbn = {9798400718519},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3770445.3770491},
doi = {10.1145/3770445.3770491},
abstract = {Precise modeling of virtual reality art perception is a core challenge in digital art research. Traditional perception assessment methods struggle to capture users' complex multi-dimensional perceptual states in VR environments. This study proposes a VR art perception computing framework that integrates embodied phenomenology theory with multimodal deep learning. The framework achieves accurate quantification and prediction of user artistic experiences by constructing embodied perceptual state spaces, designing cross-modal spatiotemporal attention mechanisms, and establishing dynamic perception assessment models. Experimental validation on large-scale VR art datasets shows that the proposed framework significantly outperforms existing state-of-the-art methods in both artistic emotion recognition and perceptual immersion prediction tasks, with relative performance improvements exceeding 15\%. Ablation experiments demonstrate the effectiveness of phenomenology-guided feature representation and spatiotemporal attention mechanisms. The framework provides theoretical foundation and technical support for VR art creation optimization, personalized recommendation, and user experience evaluation, promoting theoretical development and practical applications in digital art perception computing.},
booktitle = {Proceedings of the 2025 International Conference on Generative AI and Digital Media Arts},
pages = {264–268},
numpages = {5},
keywords = {Art perception, Deep learning, Embodied phenomenology, Multimodal learning, Virtual reality},
location = {
},
series = {GAIDMA '25}
}

@inproceedings{10.1145/3772318.3790589,
author = {Chen, Ruijia and Wu, Yuheng and Houseago, Charlie and Gaspar, Filipe and Aleotti, Filippo and G{\'a}lvez-L{\'o}pez, Dorian and Johnston, Oliver and Mazala, Diego and Garcia-Hernando, Guillermo and Bandukda, Maryam and Brostow, Gabriel and Van Brummelen, Jessica},
title = {NaviNote: Enabling In-situ Spatial Annotation Authoring to Support Exploration and Navigation for Blind and Low Vision People},
year = {2026},
isbn = {9798400722783},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3772318.3790589},
doi = {10.1145/3772318.3790589},
abstract = {GPS and smartphones enable users to place location-based annotations, capturing rich environmental context. Previous research demonstrates that blind and low vision (BLV) people can use annotations to explore unfamiliar areas. However, current commercial systems allowing BLV users to create annotations have never been evaluated, and current GPS-based systems can deviate several meters. Motivated by high-accuracy visual positioning technology, we first conducted a formative study with 24 BLV participants to envision a more accurate and inclusive annotation system. Surprisingly, many participants viewed the high-accuracy technology not just as an annotation system but also as a tool for precise last-few-meters navigation. Guided by participant feedback, we developed NaviNote, which combines vision-based high-precision localization with an agentic architecture to enable voice-based annotation authoring and navigation. Evaluating NaviNote with 18 BLV participants showed that it significantly improved navigation performance and supported users in understanding and annotating their surroundings. Based on these findings, we discuss design considerations for future accessible annotation authoring systems.},
booktitle = {Proceedings of the 2026 CHI Conference on Human Factors in Computing Systems},
articleno = {948},
numpages = {22},
keywords = {Accessibility, Blind and Low Vision, Last-Few-Meters Navigation, Spatial Annotation, Augmented Reality, Visual Positioning System, Large Language Models},
location = {
},
series = {CHI '26}
}

@inproceedings{10.1145/3586182.3616693,
author = {Aikawa, Yuya and Tamura, Ryoya and Xu, Chunchen and Ge, Xiao and Misaki, Daigo},
title = {Introducing Augmented Post-it:An AR Prototype for Engaging Body Movements in Online GPT-Supported Brainstorming},
year = {2023},
isbn = {9798400700965},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3586182.3616693},
doi = {10.1145/3586182.3616693},
abstract = {Recent web-based brainstorming tools utilize pre-trained language models to support ideation. However, body movements such as walking and arm motion, which are known to enhance creativity, are generally limited in web-based brainstorming. Thus, we propose “Augmented Post-it,” a novel augmented reality (AR) interaction system that enables body movements while brainstorming using a generative pre-trained transformer (GPT). With Augmented Post-it, ideas uttered by users are structured via GPT and extended into a spatial representation that encourages divergent thinking. This study contributes to future GPT-based AR brainstorming by extending the thinking ability of users in ways that engage their body movements to enhance creativity.},
booktitle = {Adjunct Proceedings of the 36th Annual ACM Symposium on User Interface Software and Technology},
articleno = {6},
numpages = {3},
keywords = {Augmented reality, Brainstorming, Creativity, GPT},
location = {San Francisco, CA, USA},
series = {UIST '23 Adjunct}
}

@inproceedings{10.1145/3777730.3777849,
author = {Fan, Jiaqian},
title = {The Design Method of Generative Artificial Intelligence for Exhibition Spaces},
year = {2026},
isbn = {9798400718540},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3777730.3777849},
doi = {10.1145/3777730.3777849},
abstract = {With the rapid advancement of generative artificial intelligence (gAI), spatial design is undergoing a paradigm shift from rule-based and procedural workflows toward intelligent, adaptive, and collaborative creation. This study proposes a systematic generative AI-driven design framework for exhibition spaces that integrates thematic modeling, multimodal prompt reasoning, and multi-objective optimization. The framework transforms curatorial intent and audience needs into structured inputs to generate feasible, semantically coherent, and human-aligned exhibition layouts. A hybrid optimization model is employed to balance accessibility, narrative consistency, immersion, cost, and energy efficiency, while an iterative human–AI co-design mechanism enhances adaptability and interpretability. Experimental results demonstrate that the proposed method achieves superior performance over traditional and deep generative baselines in both design quality and convergence efficiency, improving mean objective performance by over 25\%. Furthermore, user studies confirm enhanced designer trust and control through visual–semantic interpretability. Overall, this research establishes a comprehensive methodology for intelligent, explainable, and efficient exhibition space design, providing a theoretical and practical foundation for future applications of gAI in architectural and spatial design.},
booktitle = {Proceedings of the 2025 International Conference on Artificial Intelligence, Virtual Reality and Interaction Design},
pages = {744–751},
numpages = {8},
keywords = {Generative Artificial Intelligence, Exhibition Design, Multi-Objective Optimization},
location = {
},
series = {AIVRID '25}
}

@inproceedings{10.1145/3777730.3777819,
author = {Wang, Jingtao and Dong, Lili and Zhang, Hui},
title = {The Transformation and Transition of Traditional Finance Led by DeepSeek Technology},
year = {2026},
isbn = {9798400718540},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3777730.3777819},
doi = {10.1145/3777730.3777819},
abstract = {This paper focuses on the transformation and reform of traditional finance led by DeepSeek technology, systematically explores the impact of this technology on the financial field, and presents relevant research cases. Specifically, it identifies identical transactions across different systems by combining BERT embeddings with cosine similarity, and verifies the identification results using DeepSeek AI; detects abnormal consumption patterns with the Isolation Forest algorithm; implements an accounting entry recommendation module based on a rule engine and Large Language Models (LLMs) to generate recommended adjustment entries; and predicts its impact on cash flow by adopting a time series model. Finally, the paper summarizes the above analysis results.},
booktitle = {Proceedings of the 2025 International Conference on Artificial Intelligence, Virtual Reality and Interaction Design},
pages = {550–555},
numpages = {6},
keywords = {BERT embeddings, DeepSeek Technology, Financial Transformation Strategies, Isolation Forest, LSTM Traditional Financial Transformation},
location = {
},
series = {AIVRID '25}
}

@inproceedings{10.1145/3757372.3771849,
author = {Liu, Dongping and Qi, Xiaojuan and Wang, Shiqi and Wong, Kam-Fai and Zhang, Luyao},
title = {Beyond the Prompt: Cultivating Intrinsic Motivation in the Generative Renaissance},
year = {2025},
isbn = {9798400721328},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3757372.3771849},
doi = {10.1145/3757372.3771849},
abstract = {Generative artificial intelligence (AI) is reshaping computer graphics and interactive techniques, sparking a “Generative Renaissance” that transforms how students create, learn, and collaborate. While these tools expand access to powerful creative capabilities, they also raise critical questions for educators: How can learning remain meaningful when a prompt can generate polished code, images, or text? How can curricula shift from performance-based incentives to cultivating deep, resilient, intrinsic motivation? This panel brings together speakers from academia, industry, and policy to share innovative research outcomes, methods, and developments in the education of computer graphics and interactive techniques. Panelists will explore human–AI synergy in learning, highlighting projects that integrate generative AI into multimedia quality assessment, three-dimensional (3D) reconstruction, visual computing, language technologies, and interdisciplinary curricula. They will present strategies for project-based education that combine computational methods, aesthetic exploration, and experiential learning—including industry collaborations, fieldwork at innovation hubs, and community-engaged initiatives. Together, the panel will address key questions: •How can assignments reward inquiry and creativity over AI-generated polish?•What “power skills” such as ethical reasoning, critical inquiry, and collaboration emerge from human–AI co-creation?•What frameworks ensure equitable, ethical, and globally relevant adoption of generative tools in education?With moderators bridging academia and industry, this panel directly supports the Educator’s Forum mission to advance innovative pedagogy in computer graphics and interactive techniques. Attendees will gain globally informed strategies to inspire intrinsically motivated learners—students who are not merely AI users, but discerning, creative collaborators in the Generative Renaissance.},
booktitle = {SIGGRAPH Asia 2025 Educator's Forum},
articleno = {4},
numpages = {4},
keywords = {Computer Graphics; Interactive Techniques; Generative AI; Intrinsic Motivation; Diversity, Equity, and Inclusion (DEI); Sustainable Development Goals (SDGs); Curriculum Design; Human–AI Collaboration; Virtual Reality (VR); Extended Reality (XR); Natural Language Processing (NLP); High-Performance Computing (HPC); Artificial Intelligence-Generated Content (AIGC);Interdisciplinary Education},
location = {
},
series = {SA '25}
}

@inproceedings{10.1145/3613904.3642947,
author = {Liu, Ziyi and Zhu, Zhengzhe and Zhu, Lijun and Jiang, Enze and Hu, Xiyun and Peppler, Kylie A and Ramani, Karthik},
title = {ClassMeta: Designing Interactive Virtual Classmate to Promote VR Classroom Participation},
year = {2024},
isbn = {9798400703300},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3613904.3642947},
doi = {10.1145/3613904.3642947},
abstract = {Peer influence plays a crucial role in promoting classroom participation, where behaviors from active students can contribute to a collective classroom learning experience. However, the presence of these active students depends on several conditions and is not consistently available across all circumstances. Recently, Large Language Models (LLMs) such as GPT have demonstrated the ability to simulate diverse human behaviors convincingly due to their capacity to generate contextually coherent responses based on their role settings. Inspired by this advancement in technology, we designed ClassMeta, a GPT-4 powered agent to help promote classroom participation by playing the role of an active student. These agents, which are embodied as 3D avatars in virtual reality, interact with actual instructors and students with both spoken language and body gestures. We conducted a comparative study to investigate the potential of ClassMeta for improving the overall learning experience of the class.},
booktitle = {Proceedings of the 2024 CHI Conference on Human Factors in Computing Systems},
articleno = {659},
numpages = {17},
keywords = {VR classroom, collaborative learning, large language Model, pedagogical agent},
location = {Honolulu, HI, USA},
series = {CHI '24}
}

@inproceedings{10.1145/3820915.3821018,
author = {Cao, Lei and Zhao, Ruiming},
title = {Generative AI for Immersive Environment Design: A Systematic Review of Deep Learning in Virtual World Creation},
year = {2026},
isbn = {9798400723612},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3820915.3821018},
doi = {10.1145/3820915.3821018},
abstract = {The rapid evolution of Generative Artificial Intelligence (GenAI) is reshaping workflows for virtual world construction, complementing manual geometric modeling with latent-space-driven synthesis. This systematic review synthesizes empirical evidence regarding the effectiveness of Deep Learning (DL) architectures, specifically Generative Adversarial Networks (GANs), Diffusion Models, and Neural Radiance Fields (NeRFs), in facilitating immersive environment design and its subsequent impact on user cognition. Following the PRISMA protocol, 50 peer-reviewed empirical studies published between 2015 and 2025 were analyzed to evaluate the synergy between AI-driven environmental fidelity and human information processing. The findings, grounded in Dual-Coding Theory and Cognitive Load Theory, reveal a distinct divergence in system component efficacy: while DL-optimized “multimedia features” such as realistic rendering and intelligent soundscapes significantly enhance spatial presence and narrative comprehension, non-congruent “interactive functions” and excessive gamification frequently precipitate cognitive overload. The results indicate that AI-mediated environments bolster emergent spatial literacy and vocabulary acquisition primarily when “temporal and spatial contiguity” is maintained between generative assets and core task content. However, the “novelty effect” often masks a conflict between algorithmic complexity and the user's limited cognitive capacity, leading to fragmented retention in highly interactive but poorly structured environments. This review concludes by offering a theoretical framework for “narrative-first” design, providing critical guidelines for developers and educators to ensure that technological scaffolding enhances, rather than hampers, deep cognitive engagement in the era of Generative AI.},
booktitle = {Proceedings of the 2nd International Conference on Artificial Intelligence, Virtual Reality and Interaction Design},
pages = {675–681},
numpages = {7},
keywords = {AI-mediated environments, Deep Learning, Generative AI, Immersive Environment Design, Virtual World Creation},
location = {
},
series = {AIVRID '26}
}

@inproceedings{10.1145/3777730.3777804,
author = {Huang, Kaixi and Wang, Tao},
title = {Innovative Application of Generative Adversarial Networks in User Interface Design},
year = {2026},
isbn = {9798400718540},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3777730.3777804},
doi = {10.1145/3777730.3777804},
abstract = {To enhance the efficiency and innovation of user interface design, this study explores the application of Generative Adversarial Networks through adversarial training between the generator and discriminator models. The research covers areas such as layout generation, color schemes, and interactive element design. Results indicate that UI-GAN can rapidly generate diverse design schemes, with layout module counts ranging from 5 to 8 on different devices, color scheme generation times between 1.8 and 2.3 seconds, and interactive element response times of 100 to 180 milliseconds. This significantly improves design efficiency and optimizes user experience.},
booktitle = {Proceedings of the 2025 International Conference on Artificial Intelligence, Virtual Reality and Interaction Design},
pages = {465–470},
numpages = {6},
keywords = {Generative Adversarial Networks, Layout Generation, User Interface Design},
location = {
},
series = {AIVRID '25}
}

@inproceedings{10.1145/3820915.3821062,
author = {Li, Xiaoman and Zheng, Kaiyuan and Li, Ang and Zhu, Ming},
title = {The Construction of a Generative AI Narrative Generation Paradigm and Intelligent Evaluation Methods Driven by Multimodal Fusion Algorithms},
year = {2026},
isbn = {9798400723612},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3820915.3821062},
doi = {10.1145/3820915.3821062},
abstract = {Generative AI narrative generation is currently confronted with two core technical challenges: in long-range narrative coherence maintenance, where models struggle to preserve logical consistency across extended story arcs; and in cross-modal semantic alignment, where visual, auditory, and textual information often fail to achieve spatiotemporal synchronization, leading to disjointed outputs. To address these issues, this study constructs a generative AI narrative generation paradigm driven by multimodal fusion algorithms,&nbsp;which takes&nbsp;text, images, and audio as input&nbsp;and generates integrated, coherent multimodal narrative content for literary creation, film and television scriptwriting, news reporting and other scenarios.&nbsp;We propose a dynamic attention-based multimodal fusion mechanism that employs Transformer self- and cross-attention to achieve deep semantic alignment between modalities, and optimizes the generation process via reinforcement learning PPO algorithm.&nbsp;To support this, we construct a multi-dimensional evaluation dataset comprising over 10,000 narrative samples spanning more than 10 themes and 5 styles across domains such as literary fiction, film scripts, and news reports, with a complete data collection, annotation and quality control mechanism. Experimental validation on a distributed computing platform with four NVIDIA A100 GPUs—using narrative coherence, multimodal alignment and generative diversity as quantitative metrics and comparing with monomodal, traditional multimodal fusion and state-of-the-art generative AI models—shows that the proposed paradigm improves narrative coherence by 23.6\% compared with baseline models, achieving a cross-modal semantic matching accuracy of 89.7\%. This study provides a novel technical paradigm and large-scale high-quality dataset for generative AI narrative generation, and bears important innovative significance and practical application value for intelligent content creation, virtual reality interaction and other related fields.},
booktitle = {Proceedings of the 2nd International Conference on Artificial Intelligence, Virtual Reality and Interaction Design},
pages = {942–949},
numpages = {8},
keywords = {dataset construction, experimental validation, generative AI, multimodal fusion algorithms, narrative generation paradigm},
location = {
},
series = {AIVRID '26}
}

@inproceedings{10.1145/3359996.3365048,
author = {Yoo, Kyungjin and Schwelling, Eli},
title = {Spatially Accurate Generative Music with AR Drawing},
year = {2019},
isbn = {9781450370011},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3359996.3365048},
doi = {10.1145/3359996.3365048},
abstract = {Recent experiments in semi-automatically generating ambient music have yielded emotionally affecting results, leading scientists and musicians alike to develop and experiment with computational systems for creating audible art with varying degrees of success. Most of these systems are based either in analogue technology such as classic tape-reel recording systems or digital systems like virtual synthesizers triggered by a combination of developer-defined values and random number generation. In this paper, I outline the conceptual reasoning behind and development of one such generative music system which uses a simple but versatile virtual synthesizer to generate sound and sequences of repeating randomly generated notes drawn by the user in augmented reality to formulate the patterns and spatial origin of each sound contributing to the entire generative piece.},
booktitle = {Proceedings of the 25th ACM Symposium on Virtual Reality Software and Technology},
articleno = {115},
numpages = {2},
keywords = {visualization, music, museum, interactive, education, augmented reality, art},
location = {Parramatta, NSW, Australia},
series = {VRST '19}
}

@inproceedings{10.1145/3706598.3714157,
author = {Zhao, Shuo and Huang, Yifei and He, Xiaoyang and Tong, Xin and Li, Xin and Wu, Dan},
title = {Reviving Mural Art through Generative AI: A Comparative Study of AI-Generated and Hand-Crafted Recreations},
year = {2025},
isbn = {9798400713941},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3706598.3714157},
doi = {10.1145/3706598.3714157},
abstract = {Virtual reality (VR) provides an immersive and interactive platform for presenting ancient murals, enhancing users’ understanding and appreciation of these invaluable culture treasures. However, traditional hand-crafted methods for recreating murals in VR are labor-intensive, time-consuming, and require significant expertise, limiting their scalability for large-scale mural scenes. To address these challenges, we propose a comprehensive pipeline that leverages generative AI to automate the mural recreation process. This pipeline is validated by the reconstruction of Foguang Temple scene in Dunhuang Murals. A user study comparing the AI-generated scene with a hand-crafted one reveals no significant differences in presence, authenticity, engagement and enjoyment, and emotion. Additionally, our findings identify areas for improvement in AI-generated recreations, such as enhancing historical fidelity and offering customization. This work paves the way for more scalable, efficient, and accessible methods of revitalizing cultural heritage in VR, offering new opportunities for mural preservation, demonstration, and dissemination using VR.},
booktitle = {Proceedings of the 2025 CHI Conference on Human Factors in Computing Systems},
articleno = {662},
numpages = {20},
keywords = {virtual reality, culture heritage, mural recreation, generative AI},
location = {
},
series = {CHI '25}
}

@inproceedings{10.1145/3772128.3772143,
author = {Li, Yi and Sun, Guangning and Li, Zhaoying},
title = {Generative 3D Face Reconstruction and Virtual Human Generation via AIGC},
year = {2025},
isbn = {9798400715860},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3772128.3772143},
doi = {10.1145/3772128.3772143},
abstract = {This paper presents an algorithmic framework for the three-dimensional (3D) reconstruction of facial features based on the 3D Morphable Model (3DMM), utilizing controllable 3D model deformations derived from 3DMM facial feature vectors. By using a single-view 2D facial image as input, the method enables rapid and effective 3D reconstruction of the face model. An improved generative framework for 3D reconstruction of facial images based on 3DMM is proposed. In response to the facial feature recognition deficiencies in AI-generated facial images within the DECA framework, improvements are made to the backbone network for the recognition of 68 key facial landmarks, enabling the spatial 3D estimation of 2D feature points. Furthermore, to address the issue of feature mapping discrepancies in the generated virtual faces, an average human face is used for alignment with the 3D reference model. To reduce the reliance on large-scale real facial data and overcome challenges such as the inconsistent feature labeling formats in reference networks, this paper constructs a virtual human application model for 3D reconstruction of facial expressions. This offers an effective solution for the virtual human technology domain. Experimental results show that the proposed method is highly applicable to generative 3D face reconstruction across various facial expressions, especially in the domain of virtual human interaction simulation, making it significant both theoretically and in terms of practical innovation.},
booktitle = {Proceedings of the 2025 2nd International Conference on Virtual Reality, Image and Signal Processing},
pages = {79–87},
numpages = {9},
keywords = {3D Face Modeling, 3DMM, Face Feature Recognition, Generative Artificial Intelligence, Virtual Avatar},
location = {
},
series = {VRISP '25}
}

@inproceedings{10.1145/3773078.3831787,
author = {Chen, Mengyu and Lu, Feiyu and Chen, Chun-Fu and Vinh Tran, Lucas and Katukuri, Jay},
title = {Inverse Theory of Mind Modeling for Content Recommendation: From Web Browsing to Dynamic Intelligent Interfaces},
year = {2026},
isbn = {9798400722844},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3773078.3831787},
doi = {10.1145/3773078.3831787},
abstract = {Modern recommender systems treat observed actions as reliable proxies for user preferences, yet interactions often reflect exploration or comparison rather than stable preference expression. As interfaces evolve from static layouts toward generative UIs and immersive extended reality&nbsp;(XR), the need for deeper, modality-agnostic user understanding grows: these adaptive environments must decide not only what to present but where, when, how prominently, and most importantly why a user acts. We propose an Inverse Theory of Mind (IToM) pipeline that reasons backward from observed interactions to infer the beliefs, preferences, and decision-making traits that explain behavior. The pipeline reconstructs each user’s decision context, including what was chosen and what alternatives were available, applies LLM-driven counterfactual reasoning to produce evidence-grounded natural-language belief statements, and synthesizes these beliefs through multi-hypothesis abductive inference into a structured user persona. We evaluate on the OPeRA dataset against ground-truth personality assessments, attitudinal surveys, and interview-based personas across four tasks: next action prediction, shopping attitude alignment, Big Five personality inference, and held-out category prediction. Results show that inferred personas match or exceed ground-truth personas and that multi-hypothesis reasoning is essential for accurate personality prediction. We further demonstrate cross-modal transferability with a persona-driven spatial banking application on VisionOS.},
booktitle = {Proceedings of the 20th ACM Conference on Recommender Systems},
pages = {339–349},
numpages = {11},
keywords = {Theory of Mind, User modeling, Persona synthesis, Recommender systems, LLM reasoning, Generative UI, Extended reality, Adaptive interfaces, Persona prediction},
location = {
},
series = {RecSys '26}
}

@inproceedings{10.1145/3820915.3821132,
author = {Ji, Jingwen},
title = {A Study on the Game between Generative AI and Human Cognitive Thinking},
year = {2026},
isbn = {9798400723612},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3820915.3821132},
doi = {10.1145/3820915.3821132},
abstract = {With the rapid iteration and popularization of computer technologies such as generative artificial intelligence, multimodal interaction, natural language processing, computer vision, and large-scale pre-trained models, artificial intelligence has deeply penetrated the core scenarios of human cognitive activities, and gradually formed a multi-dimensional and in-depth game relationship with human cognitive thinking. This game is not a simple compromise and confrontation, but a dynamic interaction and tension balance centered on key links such as information filtering, demand satisfaction, and cognitive judgment. In essence, it is the collision and adaptation between artificial intelligence algorithm logic and computational models, as well as human cognitive laws and value preferences. From the interdisciplinary perspective of cognitive psychology, artificial intelligence ethics and game theory, this paper follows the core research logic of “phenomenon analysis – mechanism interpretation – quantitative characterization – conclusion condensation”. It systematically analyzes the specific forms of the game between artificial intelligence and human cognitive thinking, focusing on three core game phenomena: cognitive competition, cognitive pressure and cognitive bias. A formula for cognitive resource occupancy is introduced to achieve quantitative characterization, and three groups of engineering charts are combined to intuitively present the game characteristics. The paper further interprets two major balancing mechanisms in the current game relationship: asymmetric narration and dynamic game. Finally, it condenses research conclusions and puts forward prospects for future studies, so as to provide solid theoretical support and operable practical references for regulating the application of artificial intelligence technology, safeguarding human cognitive subjectivity, and realizing the high-quality development of human-machine cognitive collaboration.},
booktitle = {Proceedings of the 2nd International Conference on Artificial Intelligence, Virtual Reality and Interaction Design},
pages = {1394–1399},
numpages = {6},
location = {
},
series = {AIVRID '26}
}

@inproceedings{10.1145/3777730.3777812,
author = {Xiao, Yutong},
title = {Intelligent Art Creation and Image Generation Method Based on Generative Adversarial Networks},
year = {2026},
isbn = {9798400718540},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3777730.3777812},
doi = {10.1145/3777730.3777812},
abstract = {This paper addresses the challenges of insufficient style consistency and low detail fidelity in artistic style image generation. We propose an intelligent art creation method based on a deep convolutional generative adversarial network (DCGAN). Building on the traditional GAN framework, our method incorporates multi-layer convolutional feature fusion and style optimization modules to enhance the generated images' ability to capture the target artist's style. We construct a comprehensive technical system consisting of data preprocessing, feature extraction, generative model training, and style optimization, and conduct experimental validation on image data from a variety of artists' works. Experimental results demonstrate that the proposed method outperforms existing mainstream approaches on Inception Score (IS), Fr{\'e}chet Inception Distance (FID), and Structural Similarity (SSIM). FID is reduced by 12.7\% and SSIM is improved by 8.4\%, demonstrating significant advantages in detail representation and style restoration. This research not only improves the applicability of generative models in artistic creation but also provides a new technical path for intelligent and personalized art generation.},
booktitle = {Proceedings of the 2025 International Conference on Artificial Intelligence, Virtual Reality and Interaction Design},
pages = {511–515},
numpages = {5},
keywords = {Artistic Style Transfer, Deep Convolutional Neural Network, Generative Adversarial Network, Image Generation, Intelligent Art Creation},
location = {
},
series = {AIVRID '25}
}

@inproceedings{10.1145/3779232.3779278,
author = {Nikoli{\'c}, Predrag K. and Prentner, Robert},
title = {Epistemoverse: Toward an AI-Driven Knowledge Metaverse for Intellectual Heritage Preservation},
year = {2026},
isbn = {9798400723629},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3779232.3779278},
doi = {10.1145/3779232.3779278},
abstract = {Large language models (LLMs) have often been characterized as “stochastic parrots” that merely reproduce fragments of their training data. This study challenges that assumption by demonstrating that, when placed in an appropriate dialogical context, LLMs can develop emergent conceptual structures and exhibit interaction‑driven (re-)structuring of cognitive interfaces and reflective question-asking. Drawing on the biological principle of cloning and Socrates’ maieutic method, we analyze authentic philosophical debates generated among AI-reincarnated philosophers within the interactive art installations of the Syntropic Counterpoints project. By engaging digital counterparts of Aristotle, Nietzsche, Machiavelli, and Sun Tzu in iterative discourse, the study reveals how machine dialogue can give rise to inferential coherence, reflective questioning, and creative synthesis. Based on these findings, we propose the concept of the Epistemoverse—a metaverse of knowledge where human and machine cognition intersect to preserve, reinterpret, and extend intellectual heritage through AI-driven interaction. This framework positions virtual and immersive environments as new spaces for epistemic exchange, digital heritage, and collaborative creativity.},
booktitle = {Proceedings of the 20th International Conference on Virtual Reality Continuum and Its Applications in Industry},
articleno = {18},
numpages = {7},
location = {
},
series = {VRCAI '25}
}

@inproceedings{10.1145/3820915.3821123,
author = {Liu, Xinyu and Li, Yanzhen and Yim, Jinho},
title = {Fast Generation and Interaction Validity Verification of Embedded Device UI Interface Based on Generative AI},
year = {2026},
isbn = {9798400723612},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3820915.3821123},
doi = {10.1145/3820915.3821123},
abstract = {Abstract-This study addresses the inefficiency and limited interaction quality of traditional embedded UI development by proposing a closed-loop, constraint-aware generative framework for rapid interface generation and interaction validity verification. Unlike existing approaches that focus solely on UI generation, the proposed method integrates intent understanding, structured constraint modeling, hardware-aware rendering, and interaction feedback optimization into a unified pipeline. Specifically, the framework introduces a “describe-generate-interact-optimize” loop, which transforms multimodal user input into executable UI interfaces under strict embedded hardware constraints. For reproducibility, hardware constraints are encoded as a JSON device profile and injected into generation through prompt templates plus a rule-based verifier, rather than end-to-end retraining. To ensure practical usability, a multi-level validation scheme is designed, combining static feasibility checks, dynamic performance testing, and user-centered evaluation. A case study based on a smart thermostat interface demonstrates that the proposed method achieves order-of-magnitude improvements in development efficiency, while maintaining comparable task performance and significantly improving user experience. The results indicate that the framework provides a verifiable and scalable paradigm for embedded UI development, bridging the gap between generative AI capabilities and real-world human-computer interaction requirements.},
booktitle = {Proceedings of the 2nd International Conference on Artificial Intelligence, Virtual Reality and Interaction Design},
pages = {1328–1333},
numpages = {6},
keywords = {AI, Embedded, Interactive, UI interface generation},
location = {
},
series = {AIVRID '26}
}

@inproceedings{10.1145/3788851.3815043,
author = {Araujo Lima, Renato and da Concei{\c c}{\~a}o Estevam, Leonardo and C{\'e}sar da Rocha Seruffo, Marcos},
title = {Project SmartAvatar: A Human-Avatar Interface},
year = {2026},
isbn = {9798400724480},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3788851.3815043},
doi = {10.1145/3788851.3815043},
abstract = {This paper presents SmartAgent, a real-time multimodal framework that integrates Large Language Models (LLMs), speech processing, and embodied avatar rendering to enable more natural and expressive human-computer interaction. The system introduces an embodied conversational agent, Bitzy, capable of interpreting user input and responding through synchronized speech, facial expressions, gestures, and gaze. To ensure consistency across modalities, a structured JSON schema is used to bridge cognitive processing and real-time animation in Unity. The architecture adopts a modular design that decouples speech recognition, language generation, and rendering, improving scalability and responsiveness. Preliminary results indicate that the proposed approach enhances user engagement, perceived presence, and interaction quality when compared to traditional text-based interfaces. These findings suggest that multimodal embodied agents represent a promising direction for developing more human-centered interactive systems.},
booktitle = {Proceedings of the 2026 ACM International Conference on Interactive Media Experiences},
pages = {564–567},
numpages = {4},
keywords = {ECA, Multimodal Interaction, LLM, XR, Virtual Avatars, HCI, Unity, Real-Time Systems},
location = {
},
