}

@inproceedings{10.1145/3785706.3785902,
author = {Zhang, Kai and Wu, Di},
title = {Research on Innovation of AIGC-Integrated Digital Media Art Creation and Communication Modes},
year = {2026},
isbn = {9798400719516},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3785706.3785902},
doi = {10.1145/3785706.3785902},
abstract = {With the rapid development of Artificial Intelligence Generated Content (AIGC) technology, the field of digital media art has ushered in unprecedented opportunities for innovation. This study focuses on exploring the integration of AIGC into digital media art creation and the corresponding innovations in communication modes. First, it analyzes the current status of digital media art creation and communication, identifying the limitations of traditional models in terms of efficiency, personalization, and audience interaction. Then, a novel AIGC-integrated digital media art creation framework is proposed, which combines generative adversarial networks (GANs), diffusion models, and transformer-based language models to enhance the diversity and creativity of artworks. For the communication mode, a multi-channel interactive communication model is designed, leveraging social media platforms, virtual reality (VR) exhibition halls, and blockchain-based digital asset management systems to improve the reach and influence of digital media art.​To verify the effectiveness of the proposed framework and model, experiments are conducted from two aspects: creation efficiency and communication effect. In the creation efficiency experiment, 50 professional digital media artists and 50 non-professional participants are invited to create artworks using the traditional method and the AIGC-integrated method respectively. The results show that the AIGC-integrated method reduces the creation time by an average of 62.3\% and improves the diversity of artworks by 45.8\% compared with the traditional method. In the communication effect experiment, two groups of artworks (one created with the AIGC-integrated method and the other with the traditional method) are promoted through different communication channels. The data indicate that the multi-channel interactive communication model increases the audience engagement rate by 78.5\% and the artwork sharing rate by 63.2\% compared with the single-channel communication model.​},
booktitle = {Proceedings of the 2025 2nd International Conference on Digital Economy and Computer Science},
pages = {1242–1247},
numpages = {6},
keywords = {AIGC, Audience Engagement, Blockchain, Communication Mode, Creation Framework, Diffusion Models, Digital Media Art, GANs, VR Exhibition Halls},
location = {
},
series = {DECS '25}
}

@inproceedings{10.1145/3786995.3787074,
author = {Kang, Xinhui and Hua, Xia and Tan, Jingying and Huang, Zihan and Chen, Yunbing},
title = {EmbroidVR: Weaving Cultural Heritage with AI-Powered Immersive Interaction},
year = {2026},
isbn = {9798400722349},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3786995.3787074},
doi = {10.1145/3786995.3787074},
abstract = {Virtual Reality (VR) applications are increasingly used to safeguard Intangible Cultural Heritage (ICH), yet many deployments emphasize static representation over participatory practice, keeping audiences as observers rather than makers. These often fail to capture or transmit the intricacies of highly specialized subcategories within a field, such as Beijing embroidery (Jingxiu), a subcategory of Chinese embroidery. In this paper, we explore how immersive VR, powered by generative AI, might transform Beijing embroidery from a static exhibit into a lived, co-creative experience that fosters understanding, agency, and attachment. We present EmbroidVR, a narrative-driven VR system in which users progress from knowledge immersion to AI-assisted creation to contextual application. We design three acts in which Beijing embroidery is practiced, namely royal palace, artisan workshop, and opera theatre. Our three-act framework combines sketch-conditioned diffusion with VR craft metaphors and a cultural transmission layer linking embroidery to their applications. We also outline a user-study plan for engagement, learning, and creative self-efficacy. This work is transferable to other ICH domains and paves the way for digitally supported ICH transmission in the long run.},
booktitle = {Proceedings of the 2025 International Conference on Human-Engaged Computing},
articleno = {45},
numpages = {10},
keywords = {VR},
location = {
},
series = {ICHEC '25}
}

@inproceedings{10.1145/3563657.3596008,
author = {Han, Jihae and Vande Moere, Andrew and Simeone, Adalberto L.},
title = {Architectural Narrative VR: Towards Generatively Designing Natural Walkable Spaces},
year = {2023},
isbn = {9781450398930},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3563657.3596008},
doi = {10.1145/3563657.3596008},
abstract = {The current state of Virtual Reality (VR) presents a limited and underwhelming user experience. Users are restricted from naturally walking beyond the physical boundaries of the real world, unable to fully explore large virtual environments. The virtual manifestation also often mirrors the physical features of the real world, neglecting the limitless possibilities of the virtual universe. In response to this limitation, this pictorial introduces Architectural Narrative VR, a generative environment that dynamically designs spaces on-the-fly. This approach enables users to roam freely within the constraints of their physical space, while the architectural proportions and rhythm of virtual spaces are designed to relate to external factors such as the sequential presentation of content and user behaviour. This work contributes to VR research by exploring new ways of generating virtual spaces that prioritise user-dependent rather than predefined manifestations of the architectural narrative, offering greater potential for immersive and multidimensional user experiences.},
booktitle = {Proceedings of the 2023 ACM Designing Interactive Systems Conference},
pages = {523–536},
numpages = {14},
location = {Pittsburgh, PA, USA},
series = {DIS '23}
}

@inproceedings{10.1145/3799823.3812445,
author = {Miller, Marty and Yohannes, Tesfa},
title = {Reframe: Collaborative AI Scene Editing in 360° Multiplayer VR},
year = {2026},
isbn = {9798400725463},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3799823.3812445},
doi = {10.1145/3799823.3812445},
abstract = {Reframe is a multiplayer virtual reality experience where groups collectively edit 360° photographic environments using generative AI. Participants inhabit an immersive 360° or panoramic image and point at areas they wish to modify. They then speak together about what they want to see, and the system transcribes and summarizes their dialogue into a prompt. AI imagery is subsequently composited into the selected area. Building on prior research documenting how collaborative storytelling emerges through voice-based interaction with panoramic imagery, Reframe translates these affordances into a portable VR installation. The result invites participants to treat the panorama as an archive for remembering or a canvas for exploration.Supplementary Video: https://youtu.be/oBRH6CAxUgk},
booktitle = {Proceedings of the Special Interest Group on Computer Graphics and Interactive Techniques Conference Immersive Pavilion},
articleno = {12},
numpages = {3},
location = {
},
series = {SIGGRAPH Immersive Pavilion'26}
}

@inproceedings{10.1145/3761667.3761966,
author = {Tay, Tiffany and Ong, Jernyse and Lipkowitz, Gabriel},
title = {Bridging Generations Through Reconstructed Historical Environments For Spatial User Interfaces},
year = {2025},
isbn = {9798400721687},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3761667.3761966},
doi = {10.1145/3761667.3761966},
abstract = {The absence of shared experiences between younger and older individuals widens the generational gap, and often places a strain on familial relationships. This experience aims to bridge the digital divide by inviting all users into an emotionally rich, collaborative design process that combines AI-driven image generation with geo-spatial memory mapping. Through uploading an image, providing prompts to a custom scene generator, and selecting views from Look Around to compare scenes from the past, users may recreate personalized immersive spatial environments, and experience time-enabled geo-spatial navigation paired with soundscapes that reflect the historical and cultural setting of the space. By enabling youth to visually re construct the memories of older adults through collaborative co-creation, this approach integrates storytelling, spatial exploration, and emotional engagement across both local and remote settings, thereby fostering inter-generational connection and understanding.},
booktitle = {SIGGRAPH Asia 2025 XR},
articleno = {2},
numpages = {2},
keywords = {Spatial computing, Spatial intelligence, 3D Generative AI},
location = {
},
series = {SA '25}
}

@inproceedings{10.1145/3746058.3758472,
author = {Arakawa, Riku and Li, Franklin Mingzhe and Zhang, Nandi and Huh, Mina and Pavel, Amy and Suzuki, Ryo and Carrington, Patrick and Yan, Yukang},
title = {Accessible Cyber-Physical Activities},
year = {2025},
isbn = {9798400720369},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3746058.3758472},
doi = {10.1145/3746058.3758472},
abstract = {Recent advances in context sensing, generative AI, robotics, and augmented/mixed reality have created unprecedented opportunities to design cyber-physical systems that meaningfully support accessibility and inclusion in everyday life. These intelligent systems can sense the environment, interpret user goals, and provide adaptive, real-time support, enabling people with disabilities to engage confidently in daily activities ranging from cooking and personal care to creative expression and skill acquisition. However, realizing this potential requires addressing critical challenges in sensing, interaction design, adaptability, and evaluation to ensure systems are trustworthy, user-centered, and extend rather than replace human capabilities. This workshop brings together researchers and designers across HCI, AI, AR/VR, accessibility, and robotics to explore the design and evaluation of accessible cyber-physical systems. For details, please visit https://accessible-cps.github.io/.},
booktitle = {Adjunct Proceedings of the 38th Annual ACM Symposium on User Interface Software and Technology},
articleno = {15},
numpages = {3},
keywords = {Activities of Daily Living (ADLs), Accessibility, AI, Physical Interaction, Sensing, VR/AR/XR/MR, Robotics, Learning},
location = {
},
series = {UIST Adjunct '25}
}

@inproceedings{10.1145/3450741.3465260,
author = {Urban Davis, Josh and Anderson, Fraser and Stroetzel, Merten and Grossman, Tovi and Fitzmaurice, George},
title = {Designing Co-Creative AI for Virtual Environments},
year = {2021},
isbn = {9781450383769},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3450741.3465260},
doi = {10.1145/3450741.3465260},
abstract = {Co-creative AI tools provide a method of creative collaboration between a user and machine. One form of co-creative AI called generative design requires the user to input design parameters and wait substantial periods of time while the system computes design solutions. We explore this interaction dynamic by providing an embodied experience in VR. Calliope is a virtual reality (VR) system that enables users to explore and manipulate generative design solutions in real time. Calliope accounts for the typical idle times in the generative design process by using a virtual environment to encourage parallelized and embodied data-exploration and synthesis, while maintaining a tight human-in-the-loop collaboration with the underlying algorithms. In this paper we discuss design considerations informed by formative studies with generative designers and artists and provide design guidelines to aid others in the development of co-creative AI systems in virtual environments.},
booktitle = {Proceedings of the 13th Conference on Creativity and Cognition},
articleno = {26},
numpages = {11},
keywords = {human-ai collaboration, creativity support tools, VR/AR/XR},
location = {Virtual Event, Italy},
series = {C&amp;C '21}
}

@inproceedings{10.1145/3799820.3820876,
author = {Hartman, Nigel Joe Al and Coulombe, Alex},
title = {Powered By Gaussian Splats: From World Models to 3D Interactive Worlds},
year = {2026},
isbn = {9798400725432},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3799820.3820876},
doi = {10.1145/3799820.3820876},
abstract = {The rapid maturation of 3D Gaussian Splatting (3DGS) as a native output format of generative world models has created a compelling but underserved workflow gap: developers and artists who can prompt a photorealistic volumetric scene into existence lack the practical skills to deploy it as a navigable, interactive extended-reality (XR) experience. This 90-minute, hands-on technical workshop bridges that gap. Participants survey the landscape of spatial world models — contrasting video-based, point-cloud, and 3DGS representations across four levels of spatial information — then follow a structured five-stage pipeline: world model generation and scene export, WebXR integration with Spark.js 2.0, level-of-detail (LOD) tuning for real-time performance, semantic object detection via Splat Analyzer to surface interactive trigger zones, and open build time for creative extension. All tools are open-source or browser-accessible; the only prerequisite is Node.js 20 or higher. By the end of the session, every attendee has a live WebXR experience running on commodity XR hardware, informed by a conceptual map of where 3DGS world models sit in the broader ecosystem of generative spatial AI.},
booktitle = {Proceedings of the Special Interest Group on Computer Graphics and Interactive Techniques Conference Courses},
articleno = {12},
numpages = {3},
keywords = {3D Gaussian Splatting, WebXR, world models, spatial AI, real-time rendering, interactive XR, level of detail, object detection, open-source tooling},
location = {
},
series = {SIGGRAPH Courses '26}
}

@inproceedings{10.1145/3719236.3719270,
author = {Basso, Alessandro and Palestini, Caterina and Perticarini, Maurizio},
title = {New Frontiers of Technology. Leveraging Advanced Digital Tools for Effective Cultural Heritage Communication Engagement and Preservation},
year = {2025},
isbn = {9798400710322},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3719236.3719270},
doi = {10.1145/3719236.3719270},
abstract = {The article provides an overview of the potential of advanced digital technologies in the field of cultural heritage representation and dissemination. The adoption of innovative tools such as interactive XR environments supported by Artificial Intelligence dynamics, educational Serious Games, and digital archives promises to overcome traditional barriers in cultural communication. Research documents how these technologies can facilitate more effective and inclusive cultural transmission, transforming the way cultural heritage is perceived and interacted with by the public, contributing to its preservation and enhancement for future generations. As evidence of such techno-methodological advances, the expeditious survey of a real space using Nerf reconstructive algorithms exploiting progressive video data for AI training on Postshot Beta platform is proposed. The experiment offers insight into the ease of use and speed of application of such low-cost systems compared with the quality of congruent and profitable results.},
booktitle = {Proceedings of the 21st International Conference on Culture and Computer Science: From Humanism to Digital Humanities},
articleno = {9},
numpages = {10},
keywords = {Digital Reconfiguration, Digital Twin, Generative AI, Innovation, XR Environments},
location = {
},
series = {KUI '24}
}

@inproceedings{10.1145/3723498.3723743,
author = {Kultima, Annakaisa},
title = {Trends in Gaming - Views of Industry Professionals and Game Scholars},
year = {2025},
isbn = {9798400718564},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3723498.3723743},
doi = {10.1145/3723498.3723743},
abstract = {This paper presents findings from a three-year survey study (2022 –2024) examining evolving trends in the game industry, drawing insights from professionals across industry roles and academia. In addition to the general questions on trends, each annual survey focused on a unique theme: in 2022, we explored the impact of the pandemic on participants’ information-sharing and learning practices; in 2023, we investigated perceptions of responsibility for future-oriented knowledge within the professional ecosystem; and in 2024, we examined strategies for coping with changes in the shared landscape of games. The results highlight a shift between two major trends, Generative AI and Cryptogames. This shift is situated within a broader context of respondents both experiencing and anticipating large-scale transformations, while concurrently navigating more gradual trajectories of change.},
booktitle = {Proceedings of the 20th International Conference on the Foundations of Digital Games},
articleno = {10},
numpages = {7},
keywords = {Game trends, Game industry, Game academia, VR/AR games, Hybrid work, Diversity, Cross-platform, Low-code/no-code, Sustainability, Regulations, Generative AI, Cryptogames, Precarity},
location = {
},
series = {FDG '25}
}

@inproceedings{10.1145/3641233.3664334,
author = {Wang, Tiange and Feng, Xin},
title = {Co-Presence, Connection and Co-Creation: Building Real-time Cross-person Neurofeedback Interactions},
year = {2024},
isbn = {9798400705151},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3641233.3664334},
doi = {10.1145/3641233.3664334},
abstract = {How can we push the boundaries of human connection by tapping into the power of immersive interpersonal brainwave interactions? While biosignal visualizations and interactions have advanced in both research and art scenes, most experiences and applications that utilize brainwaves and other biosignals involve single-person or one-way interactions from one individual to another, underexploiting the prosocial potential of these biosignals. This talk explores cross- and multi-person environments in virtual reality (VR) driven by shared brainwaves. Through case studies of two installations in a series, each showcasing unique relationships cultivated by the immersive experience via distinct EEG manifestations and visualization rules - feeling each other's presence, reinforcing mutual emotional connections, and co-creating art through synchronized brainwaves - the talk describes the design and development process of cross-person neurofeedback experiences in virtual reality. It explains various innovative approaches to real-time brainwave visualizations and interactions that integrate technology, science, storytelling and gamification, and examines their significance in expanding non-verbal channels of communication, elevating interpersonal connections, and fostering collective creativity.},
booktitle = {ACM SIGGRAPH 2024 Talks},
articleno = {25},
numpages = {2},
keywords = {Co-creation, EEG, Generative VR, Interpersonal social connectedness},
location = {Denver, CO, USA},
series = {SIGGRAPH '24}
}

@inproceedings{10.1145/3793853.3795743,
author = {Swamy, Shneka Muthu Kumara and Dasari, Mallesham and Mastronarde, Nicholas and Chakareski, Jacob},
title = {SPARC: Proximity-aware Scheduling of AR Mapping and Cloud-based GenAI Upsampling for Efficient Multi-User SLAM},
year = {2026},
isbn = {9798400724817},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3793853.3795743},
doi = {10.1145/3793853.3795743},
abstract = {The scalability of multi-user SLAM is fundamentally limited by the constrained network and computational resources. Existing approaches either focus on SLAM for single-user scenarios or overload networks and servers by streaming dense, uniform camera data and treating all users equally. This results in poor pose estimation accuracy or slow updates to multiple users. Our key insight is that the sparsity and heterogeneity of user activity reveal that not all users or frames contribute equally to the shared map. Building on this, we propose SPARC - Proximity-aware Scheduling of AR Mapping and a blur-aware adaptive Cloud-based GenAI sampling method, which together form a cloud-native framework for efficient multi-user SLAM. On the client side, adaptive, context-aware frame transmission selectively forwards high-value frames. On the server side, generative AI (GenAI)-based upsampling reconstructs dense scene features from sparse inputs, while a proximity-aware scheduler prioritizes updates for users with higher drift or critical interactions. Together, these components reduce redundant transmission, improve resource allocation, and enable fairness without sacrificing accuracy. We show through extensive experimentation that our method reduces the latency by 2{\texttimes} to 4{\texttimes} compared to state-of-the-art while maintaining similar or better tracking accuracy. More broadly, this work reimagines SLAM as a cloud-native service, paving the way for scalable, real-time AR/VR applications where many users seamlessly interact in shared environments.},
booktitle = {Proceedings of the ACM Multimedia Systems Conference 2026},
pages = {13–24},
numpages = {12},
keywords = {Multi-user Cloud SLAM, AR/VR, GenAI Upsampling and Adaptive Downsampling for Streaming, Network Systems},
location = {
},
series = {MMSys '26}
}

@inproceedings{10.1145/3716640.3716655,
author = {W{\"u}nsche, Burkhard Claus and Hooper, Steffan and Whalley, Jacqueline and Straand, Ingjerd and Denny, Paul and Crow, Tyne and Lange-Nawka, Dominik and Luxton-Reilly, Andrew and Thompson, Samuel E. R.},
title = {Leveling up Learning: Serious Games for Computing Education - Long-Term Opportunities and Risks},
year = {2025},
isbn = {9798400714252},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3716640.3716655},
doi = {10.1145/3716640.3716655},
abstract = {Serious games are becoming an increasingly popular tool in education, including computing education, due to their potential to engage learners, practice skills development, stimulate creativity, promote active learning, and cultivate exploration. However, few researchers have discussed the potential long-term implications of using serious games for learning programming and how they can be addressed.This paper investigates opportunities and drawbacks arising from the wider use of serious games in computing education. We look beyond immediate effects, such as the risk of distraction and technological barriers, and consider prospects and risks caused by market forces and the economic realities of the game, education, and software industries. In particular, we discuss how technological advances can increase the benefits of serious games for programming education, but also that there is a risk that an increasing use of serious games might result in market dominance of a few vendors, lack of diversity, cultural bias, inequity, pressure on education funding, and reduced learning outcomes.},
booktitle = {Proceedings of the 27th Australasian Computing Education Conference},
pages = {134–143},
numpages = {10},
keywords = {Serious Games, Computing Education, Diversity, Equality, Accessibility, Generative AI, AR/VR, Game Industry},
location = {
},
series = {ACE '25}
}

@inproceedings{10.1145/3799457.3799518,
author = {Qiu, Nengsheng and Huang, Yubin},
title = {Design and Implementation of an Adaptive Learning System for Business English Based on AI-Driven Multi-Modal Textbooks},
year = {2026},
isbn = {9798400720710},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3799457.3799518},
doi = {10.1145/3799457.3799518},
abstract = {Traditional Business English (BE) textbooks are static, lacking personalization and failing to meet the dynamic demands of modern business scenarios such as cross-border e-commerce and international negotiations. This creates a significant gap between academic instruction and real-world professional requirements. This paper addresses this gap by presenting the design and implementation of a novel adaptive learning system for BE based on an AI-driven, multi-modal textbook architecture. We propose a "Human-Computer Collaborative" framework that integrates key AI technologies: Natural Language Processing (NLP) for dynamic case generation, Knowledge Graphs (KG) for content structuring, and Virtual/Augmented Reality (VR/AR) for immersive simulation. The system features an adaptive engine that personalizes learning paths and content difficulty based on real-time student performance analysis. We detail the system's four-layer architecture and the implementation of its core components, including a dynamic content generation module leveraging generative models like Deepseek and Qwen-QwQ-32B. The system's effectiveness was validated through a quasi-experimental study involving 88 university BE students. We conducted a comparative analysis between an experimental group (n=44) using the proposed system and a control group (n=44) using traditional textbooks. Evaluation focused on improvements in language proficiency, business skill application, and cross-cultural communicative competence. Results showed the experimental group demonstrated statistically significant improvements in business skill application (a 13.9\% higher adjusted mean score, p &lt; .001) and oral communication (p &lt; .001) compared to the control group. Qualitative feedback confirmed high usability (SUS score = 88.5) and perceived professional relevance. The proposed AI-driven system provides a scalable and effective solution for modern BE education, successfully transitioning textbook design from an "experience-driven" to a "data-driven" model and offering a practical, validated pathway for intelligent higher education.},
booktitle = {Proceedings of the 2025 3rd International Conference on Information Education and Artificial Intelligence},
pages = {363–369},
numpages = {7},
keywords = {AI-Driven Textbooks, Adaptive Learning, Business English, Knowledge Graph, Multi-Modal Learning, Natural Language Processing (NLP), VR/AR in Education},
location = {
},
series = {ICIEAI '25}
}

@article{10.1145/3678172,
author = {Storey, Margaret-Anne and Russo, Daniel and Novielli, Nicole and Kobayashi, Takashi and Wang, Dong},
title = {A Disruptive Research Playbook for Studying Disruptive Innovations},
year = {2024},
issue_date = {November 2024},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {33},
number = {8},
issn = {1049-331X},
url = {https://doi.org/10.1145/3678172},
doi = {10.1145/3678172},
abstract = {As researchers today, we are witnessing a fundamental change in our technologically-enabled world due to the advent and diffusion of highly disruptive technologies such as generative Artificial Intelligence (AI), Augmented Reality (AR) and Virtual Reality (VR). In particular, software engineering has been profoundly affected by the transformative power of disruptive innovations for decades, with a significant impact of technical advancements on social dynamics due to its socio-technical nature. In this article, we reflect on the importance of formulating and addressing research problems in software engineering through a socio-technical lens, thus ensuring a holistic understanding of the complex phenomena in this field. We propose a research playbook with the aim of providing a guide to formulate compelling and socially relevant research questions and to identify the appropriate research strategies for empirical investigations, with an eye on the long-term implications of technologies or their use. We showcase how to apply the research playbook. Firstly, we show how it can be used retrospectively to reflect on a prior disruptive technology, Stack Overflow, and its impact on software development. Secondly, we show how it can be used to question the impact of two current disruptive technologies: AI and AR/VR. Finally, we introduce a specialized GPT model to support the researcher in framing future investigations. We conclude by discussing the broader implications of adopting the playbook for both researchers and practitioners in software engineering and beyond.},
journal = {ACM Trans. Softw. Eng. Methodol.},
month = nov,
articleno = {195},
numpages = {29},
keywords = {Socio-technical Integration, Disruptive Innovation Evaluation, Empirical Software Engineering, AI-driven Code Generation, AR/VR Collaboration Tools}
}

