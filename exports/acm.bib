@article{10.1145/3654663,
author = {Otoum, Yazan and Gottimukkala, Navya and Kumar, Neeraj and Nayak, Amiya},
title = {Machine Learning in Metaverse Security: Current Solutions and Future Challenges},
year = {2024},
issue_date = {August 2024},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {56},
number = {8},
issn = {0360-0300},
url = {https://doi.org/10.1145/3654663},
doi = {10.1145/3654663},
abstract = {The Metaverse, positioned as the next frontier of the Internet, has the ambition to forge a virtual shared realm characterized by immersion, hyper-spatiotemporal dynamics, and self-sustainability. Recent technological strides in AI, Extended Reality, 6G, and blockchain propel the Metaverse closer to realization, gradually transforming it from science fiction into an imminent reality. Nevertheless, the extensive deployment of the Metaverse faces substantial obstacles, primarily stemming from its potential to infringe on privacy and be susceptible to security breaches, whether inherent in its underlying technologies or arising from the evolving digital landscape. Metaverse security provisioning is poised to confront various foundational challenges owing to its distinctive attributes, encompassing immersive realism, hyper-spatiotemporally, sustainability, and heterogeneity. This article undertakes a comprehensive study of the security and privacy challenges facing the Metaverse, leveraging machine learning models for this purpose. In particular, our focus centers on an innovative distributed Metaverse architecture characterized by interactions across 3D worlds. Subsequently, we conduct a thorough review of the existing cutting-edge measures designed for Metaverse systems while also delving into the discourse surrounding security and privacy threats. As we contemplate the future of Metaverse systems, we outline directions for open research pursuits in this evolving landscape.},
journal = {ACM Comput. Surv.},
month = apr,
articleno = {215},
numpages = {36},
keywords = {Metaverse Security, Digital Twin, Machine Learning, Extended Reality, Generative AI, Blockchain}
}

@inproceedings{10.1145/3745900.3746103,
author = {Lau, Ka Hei Carrie and Yun, Bhada and Saruba, Samuel and Bozkir, Efe and Kasneci, Enkelejda},
title = {Wrapped in Anansi's Web: Unweaving the Impacts of Generative-AI Personalization and VR Immersion in Oral Storytelling},
year = {2025},
isbn = {9798400715662},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3745900.3746103},
doi = {10.1145/3745900.3746103},
abstract = {Oral traditions, vital to cultural identity, are losing relevance among youth due to the dominance of modern media. This study addresses the revitalization of these traditions by reconnecting young people with folklore. We introduce&nbsp;Anansi the Spider VR, a novel virtual space that combines first-person virtual reality (VR) with generative artificial intelligence (Gen-AI)-driven narrative personalization. This space immerses users in the story of Anansi the Spider, empowering them to influence the narrative by envisioning themselves as the protagonists, thereby enhancing personal reflection. In a 2 {\texttimes} 2 between-subjects study with 48 participants, we employed a mixed-method approach to measure user engagement and changes in interest, complemented by semi-structured interviews providing qualitative insights into personalization and immersion. Our results indicate that personalization in VR significantly enhances engagement and cultural interest. We recommend that future studies using VR and Gen-AI to revitalize oral storytelling, maintain cultural integrity, and involve cultural communities to ensure authentic, respectful narratives.},
booktitle = {Proceedings of the Augmented Humans International Conference 2025},
pages = {312–332},
numpages = {21},
keywords = {VR, Gen-AI, Intangible Cultural Heritage, Education},
location = {
},
series = {AHs '25}
}

@inproceedings{10.1145/3820915.3821117,
author = {Sun, Jinrun and Liu, Kaijie and Chen, Ruolin and Wang, Rui},
title = {Research on AIGC-3D Printing Collaborative Design Method for Personalized Wearable Devices},
year = {2026},
isbn = {9798400723612},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3820915.3821117},
doi = {10.1145/3820915.3821117},
abstract = {Aiming at the problems of disconnection among creative generation, physiological adaptation and additive manufacturing, insufficient manufacturability constraints and low design automation in personalized wearable device design, this paper proposes a closed-loop collaborative design framework embedded with manufacturing constraints. The framework adopts a three-tier modular architecture: design semantic-to-visual mapping, physiological data-driven geometric constraint solving, and additive manufacturing-oriented performance optimization. By integrating 3D printing process priors into the generative stage and multi-objective topology optimization, the framework realizes end-to-end intelligent customization from text to printable models. Verified on a VR headset mask, the design cycle is shortened from days to minutes; the average fitting accuracy reaches 0.37 mm; the average printing yield reaches 98.5\%; and the model weight is reduced by 25.2\%. The method provides a reusable paradigm for the large-scale personalized production of wearable devices.},
booktitle = {Proceedings of the 2nd International Conference on Artificial Intelligence, Virtual Reality and Interaction Design},
pages = {1292–1297},
numpages = {6},
keywords = {3D printing, AIGC, VR headset mask, collaborative design, manufacturability optimization, parametric adaptation, parametric design, personalized wearable devices},
location = {
},
series = {AIVRID '26}
}

@inproceedings{10.1145/3635636.3663738,
author = {Royer, Karen and Smith, Gillian and Telliel, Yunus Do{\u g}an},
title = {The Matrix of Discomfort: Reimagining Critical AI Artwork through a Lens of Organic Creative Spaces},
year = {2024},
isbn = {9798400704857},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3635636.3663738},
doi = {10.1145/3635636.3663738},
abstract = {Wright’s notion of "organic creative space" invites viewers to experience the harmony and discord inherent when operating at the boundary between the natural and designed worlds. In this artwork, we interrogate similar boundaries: between the natural and artificial, and between the creative and the generative. We explore the use of artificial intelligence systems to generate images of natural phenomena–specifically, women’s faces–and the discomfort felt by viewers as they are unsettled by the unanticipated. The Matrix of Discomfort is a multimedia art installation that blends quilting and augmented reality (AR) to critically reflect upon AI as a medium that holds promise and distrust, and that exists at boundaries: between the natural and artificial, the creative and the generative, the digital and the physical. It reimagines the quilt, traditionally a feminized symbol of comfort and relaxation, as a canvas for stimulating conversation about the ethical quandaries and potential promises of generative AI.},
booktitle = {Proceedings of the 16th Conference on Creativity \&amp; Cognition},
pages = {596–600},
numpages = {5},
keywords = {Artificial Intelligence Generated Content, Augmented Reality, Multimedia, Quilts},
location = {Chicago, IL, USA},
series = {C&amp;C '24}
}

@inproceedings{10.1145/3820915.3820971,
author = {Zhao, Jiaxiang and Li, Yanzhen and Deng, Jizhen},
title = {Research on Optimizing AI-Assisted Film and Television VFX Production},
year = {2026},
isbn = {9798400723612},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3820915.3820971},
doi = {10.1145/3820915.3820971},
abstract = {Generative Artificial Intelligence (AI) has opened up new possibilities for efficiency innovation in film and television visual effects (VFX) production. The traditional VFX production process involves creative design via hand-drawing or Photoshop in the early stage, followed by 3D modeling based on the design drafts, and finally rendering. This process is often time-consuming and inefficient. This paper proposes a VFX production method that integrates AI with the traditional workflow, namely “Doubao AI for rendering generation → Tripo AI for preliminary modeling → Maya for model refinement and animation production → Unreal Engine for rendering”. The feasibility and advantages of this model are verified through comparative experiments. The experimental results show that the most prominent role of AI in film and television VFX production lies in early-stage creative divergence and auxiliary modeling. It can effectively improve production efficiency while ensuring work quality, providing an efficient production mode for the film and television post-production workflow.},
booktitle = {Proceedings of the 2nd International Conference on Artificial Intelligence, Virtual Reality and Interaction Design},
pages = {370–374},
numpages = {5},
keywords = {AI Modeling, Film and Television Visual Effects, Generative Artificial Intelligence, Maya, Unreal Engine},
location = {
},
series = {AIVRID '26}
}

@inproceedings{10.1145/3820915.3821144,
author = {Ren, Liang and Guo, Jian and Liu, Siyang},
title = {Research on the Construction of Subjectivity in Art Education in the AI Era},
year = {2026},
isbn = {9798400723612},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3820915.3821144},
doi = {10.1145/3820915.3821144},
abstract = {With the rapid popularization of generative artificial intelligence (AI), art creation has entered a human-computer symbiosis era featuring data-driven generation, algorithmic interaction, and intelligent collaboration. Art students, as core practitioners of AI-assisted creation, are confronted with the critical problem of how to construct and maintain creative subjectivity under human-AI collaboration. This study adopts a mixed research method combining questionnaire survey and in-depth interview, and uses statistical algorithms including independent samples t-test, one-way ANOVA, and Pearson correlation analysis to process 303 valid samples from an art university. The results show that AI usage presents two typical patterns: human-dominant creation and AI-dominant creation. Students with high subjectivity perceive stronger AI empowerment in efficiency improvement and technical iteration, while those with low subjectivity face risks such as reduced originality and increased cognitive offloading. Grade, major, and AI familiarity are significant influencing factors of subjectivity. This paper constructs a phased teaching framework for AI-integrated art education based on statistical inference and subjectivity protection, providing a quantitative reference for the digital transformation of art education.},
booktitle = {Proceedings of the 2nd International Conference on Artificial Intelligence, Virtual Reality and Interaction Design},
pages = {1477–1483},
numpages = {7},
keywords = {Art Education, Artificial Intelligence, Cognitive Offloading, Generative Model, Human-Computer Collaboration, Statistical Inference, Subjectivity},
location = {
},
series = {AIVRID '26}
}

@inproceedings{10.1145/3820915.3821014,
author = {Li, Guangsheng},
title = {Research on AIGC-based Visual Translation and Multimodal Interaction Design for Cultural Heritage},
year = {2026},
isbn = {9798400723612},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3820915.3821014},
doi = {10.1145/3820915.3821014},
abstract = {This paper proposes and validates a lightweight framework aimed at utilizing Generative Artificial Intelligence (AIGC) to address the issues of homogenized visual styles and superficial interactive experiences in the digital display of cultural heritage. The core of the framework consists of a visual feature deconstruction model based on painting expertise, a low-threshold stylized translation workflow based on Stable Diffusion and LoRA, and a multimodal interaction prototype system integrated with AIGC real-time generation capability. Using Han Dynasty stone reliefs as an empirical case, this study collects quantitative and qualitative data through a controlled experiment (N=60). The results show that the visual content generated by this method significantly outperforms traditional 3D modeling methods in cultural recognizability (improvement of 42.3\%, p&lt;0.01); the developed interaction system also performs better in user experience metrics such as immersion, cultural understanding, and engagement intention. This study provides a feasible low-technical-threshold pathway for researchers with art backgrounds to participate in digital cultural heritage creation. The related process has been successfully applied in digital art course teaching.},
booktitle = {Proceedings of the 2nd International Conference on Artificial Intelligence, Virtual Reality and Interaction Design},
pages = {650–654},
numpages = {5},
keywords = {Digital Cultural Heritage, Generative Artificial Intelligence, Multimodal Interaction, User Experience, Visual Style Translation},
location = {
},
series = {AIVRID '26}
}

@inproceedings{10.1145/3746027.3755405,
author = {Yang, Liu and Duan, Huiyu and Zhu, Yucheng and Liu, Xiaohong and Liu, Lu and Xu, Zitong and Ma, Guangji and Min, Xiongkuo and Zhai, Guangtao and Le Callet, Patrick},
title = {Omni2: Unifying Omnidirectional Image Generation and Editing in an Omni Model},
year = {2025},
isbn = {9798400720352},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3746027.3755405},
doi = {10.1145/3746027.3755405},
abstract = {360° omnidirectional images (ODIs) have gained considerable attention recently, and are widely used in various virtual reality (VR) and augmented reality (AR) applications. However, capturing such images is expensive and requires specialized equipment, making ODI synthesis increasingly important. While common 2D image generation and editing methods are rapidly advancing, these models struggle to deliver satisfactory results when generating or editing ODIs due to the unique format and broad 360° Field-of-View (FoV) of ODIs. To bridge this gap, we construct  Any2Omni , the first comprehensive ODI generation-editing dataset comprises 60,000+ training data covering diverse input conditions and up to 9 ODI generation and editing tasks. Built upon Any2Omni, we propose an Omni model for Omni-directional image generation and editing ( Omni  2), with the capability of handling various ODI generation and editing tasks under diverse input conditions using one model. Extensive experiments demonstrate the superiority and effectiveness of the proposed Omni2 model for both the ODI generation and editing tasks. Both the Any2Omni dataset and the Omni2 model are publicly available at: https://github.com/IntMeGroup/Omni2.},
booktitle = {Proceedings of the 33rd ACM International Conference on Multimedia},
pages = {10103–10112},
numpages = {10},
keywords = {generative models, omnidirectional image editing, omnidirectional image generation, virtual reality},
location = {Dublin, Ireland},
series = {MM '25}
}

@inproceedings{10.1145/3820915.3821091,
author = {Li, Damo and Chen, Ruolin and Yu, Chengzhi},
title = {The Beauty of Dao-Qi-Yong: Research on Bionic Teaware Design in the Context of Artificial Intelligence},
year = {2026},
isbn = {9798400723612},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3820915.3821091},
doi = {10.1145/3820915.3821091},
abstract = {This study originated from the author's field observation in Yixing purple clay teaware production area—traditional teaware workshops are facing the dilemma of lacking successors. To explore the feasible path of integrating artificial intelligence technology with the traditional “Dao-Qi-Yong” philosophy, the research team spent three months visiting Yixing, Jingdezhen, and Dehua, constructing a “form-semantics” correlation database containing over 5,000 natural image images (bamboo 24\%, landscape 30\%, cloud pattern 18\%, etc.) and more than 80 cultural semantic keywords. On this basis, the CLIP cross-modal learning model (Top-5 accuracy 73.6\%) and conditional generative adversarial network (FID reduced below 20) were introduced to achieve intention-driven generation from cultural semantics such as “bamboo+flowing water+quiet vitality” to three-dimensional forms. The design practice with “Zhuyun Zhiliu” intelligent teapot as a case study shows that this framework can effectively support teaware creation with both cultural connotation and intelligent function. User evaluation by 30 participants (8 design professionals, 12 tea culture enthusiasts, 10 ordinary consumers) showed that the design in this paper was significantly better than traditional design in aesthetic satisfaction (6.2±0.75), cultural identity (6.5±0.72), and user experience (6.0±0.81) (p&lt;0.001), with GRA grey correlation degree reaching 0.89, verifying the effectiveness of the “Dao-Qi-Yong” ternary framework in the context of intelligent design.},
booktitle = {Proceedings of the 2nd International Conference on Artificial Intelligence, Virtual Reality and Interaction Design},
pages = {1124–1132},
numpages = {9},
keywords = {Dao-Qi-Yong, artificial intelligence, bionic design, teaware design, generative adversarial network, cultural heritage},
location = {
},
series = {AIVRID '26}
}

@inproceedings{10.1145/3820915.3821156,
author = {Jin, Jing and Deng, Shengqi and Zhang, Ting and Chen, Zhenghan and Wu, Yunman},
title = {Digital Workflow for Intelligent Woolen Garment Development},
year = {2026},
isbn = {9798400723612},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3820915.3821156},
doi = {10.1145/3820915.3821156},
abstract = {Intelligent transformation in fashion design increasingly depends on the integration of generative artificial intelligence, virtual prototyping, and craft-aware material development. Yet for woolen garments and crochet-based womenswear, the workflow from concept generation to manufacturable structure is still often fragmented: visual ideation is rapid, but material logic, structural translation, and physical validation remain slow and highly manual. This paper proposes a Digital Workflow for Intelligent Woolen Garment Development (DWIWD) that combines craft-material knowledge capture, AI-assisted concept expansion, 3D virtual prototyping, and physical sampling in a closed-loop process. The workflow is validated through the womenswear case Qianmo, which integrates crochet structures and Tyvek elements inspired by fish scales and water gradients. The case is suitable for intelligent woolen design because it contains both soft yarn logic and semi-rigid modular components, making it an effective testbed for digital translation, virtual verification, and craft refinement. Based on retrospective process records reconstructed from the project documentation, the proposed workflow reduced downstream physical sample rounds from five to two and shortened total iteration time from 41.5 h to 26.0 h. To formalize decision control, the paper introduces a Digital Feasibility Index that screens candidate solutions before sampling. The study contributes a reproducible, engineering-oriented workflow for woolen apparel development, demonstrating how AI and virtual prototyping can augment rather than replace craft intelligence.},
booktitle = {Proceedings of the 2nd International Conference on Artificial Intelligence, Virtual Reality and Interaction Design},
pages = {1560–1567},
numpages = {8},
keywords = {Tyvek, crochet, digital fashion, generative AI, intelligent workflow, virtual prototyping, woolen garment},
location = {
},
series = {AIVRID '26}
}

@inproceedings{10.1145/3728487.3759219,
author = {Sakamoto, Kotaro},
title = {Beyond Potemkin Understanding: Towards Coherent World Models in Video AI},
year = {2025},
isbn = {9798400718441},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3728487.3759219},
doi = {10.1145/3728487.3759219},
abstract = {Contemporary foundation models often display 'Potemkin understanding': fluent outputs resting on brittle, locally trained correlations. The notion of a world model serves here not as a ready-made remedy but as a conceptual lens that reveals what is missing—temporally coherent, causally grounded representations of the processes that generate data. Nowhere is this deficit clearer than in video generation: adjacent frames contribute scant new signal, so scale alone rarely yields agents that respect long-range dynamics or latent physics, unlike information-dense next-token prediction in language modelling. Entering an era of experience therefore requires training protocols that compel models to act, predict and revise across extended horizons, with principles distilled from humanity's scientific drive to compress reality informing architecture and objective design. These directions, rather than the world-model label itself, point towards more credible AI avatars and immersive XR systems whose behaviour remains consistent well beyond benchmark snippets.},
booktitle = {Proceedings of the International Workshop on Intelligent Immersification in the Metaverse: AI-Driven Immersive Multimedia},
pages = {55},
numpages = {1},
keywords = {world models, temporal modeling, causal representations, video generation, representation learning, agentic ai, avatars, xr, immersive systems},
location = {Ireland},
series = {I2M-MM '25}
}

@inproceedings{10.1145/3820915.3821060,
author = {Lin, Xiaowan and Wang, Qiuju},
title = {A Real-Time Rendering Algorithm for Dongguan Water Ripple Dynamic Art Installation Integrating Reaction-Diffusion Equations and GAN},
year = {2026},
isbn = {9798400723612},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3820915.3821060},
doi = {10.1145/3820915.3821060},
abstract = {Immersive art installations increasingly demand real-time, high-fidelity, and artistically controllable fluid rendering. However, traditional physics-based simulations often lack artistic stylization, while standard generative adversarial networks (GANs) suffer from severe temporal instability and a lack of physical constraints in video generation. To address these challenges, this paper proposes a novel Reaction-Diffusion conditional GAN (RD-cGAN) fusion framework for real-time, emotion-driven water ripple generation. Our method leverages the Reaction-Diffusion (RD) equation to compute a physical structure tensor, providing a stable dynamic baseline, which is then fed into an emotion-labeled cGAN for artistic stylization. To ensure inter-frame smoothness, a temporal consistency loss is integrated into the training pipeline. The model is trained on a custom dataset comprising 15,000 high-resolution frames captured from the real-world water towns of Dongguan, ensuring regional cultural authenticity. Experimental results demonstrate that the proposed RD-cGAN achieves a Fr{\'e}chet Inception Distance (FID) of 14.2 and a Temporal Error of 0.035, significantly outperforming baseline models in both visual fidelity and temporal stability. Furthermore, optimized with TensorRT half-precision inference, the system achieves a stable real-time rendering performance of 65 FPS at 4K resolution. The proposed framework successfully bridges physical realism with artistic expression, providing a robust and highly interactive solution for large-scale digital cultural exhibitions.},
booktitle = {Proceedings of the 2nd International Conference on Artificial Intelligence, Virtual Reality and Interaction Design},
pages = {930–935},
numpages = {6},
keywords = {Fluid Animation, Generative Adversarial Networks (GAN), Immersive Art, Reaction-Diffusion Equation, Real-Time Rendering, Temporal Consistency},
location = {
},
series = {AIVRID '26}
}

@inproceedings{10.1145/3820915.3821024,
author = {Zhao, Mengru},
title = {Emotion Mapping in Multimodal Interactive Art: A Structural Framework},
year = {2026},
isbn = {9798400723612},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3820915.3821024},
doi = {10.1145/3820915.3821024},
abstract = {With the increasing integration of multimodal interaction technologies and generative systems in contemporary art, emotion has become a structuring condition in artistic generation and experiential formation. However, affective computing frameworks centered on recognition and classification remain insufficient for explaining how emotion is transformed into aesthetic experience and meaning structures within artistic contexts. To address this limitation, this paper proposes emotion mapping as a methodological framework for analyzing multimodal interactive art. Rather than treating emotion as a directly identifiable psychological state, emotion mapping conceptualizes it as an experiential condition that is interpreted, encoded, and embedded into generative systems through artistic intervention. Based on an examination of multimodal affect-related technologies and their reconfiguration in artistic practice, this study develops a three-layer model—the perceptual, interpretive, and generative layers—to clarify how affective cues enter the system, undergo symbolic and cultural translation, and become operative within generative logic.},
booktitle = {Proceedings of the 2nd International Conference on Artificial Intelligence, Virtual Reality and Interaction Design},
pages = {712–716},
numpages = {5},
keywords = {Emotion Mapping, Emotion Recognition, Interactive Art, Multimodality},
location = {
},
series = {AIVRID '26}
}

@inproceedings{10.1145/3586182.3615819,
author = {Lee, Jaewook and Wang, Jun and Brown, Elizabeth and Chu, Liam and Rodriguez, Sebastian S. and Froehlich, Jon E.},
title = {Towards Designing a Context-Aware Multimodal Voice Assistant for Pronoun Disambiguation: A Demonstration of GazePointAR},
year = {2023},
isbn = {9798400700965},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3586182.3615819},
doi = {10.1145/3586182.3615819},
abstract = {Voice assistants (VAs) like Siri and Alexa have transformed how humans interact with technology; however, their inability to consider a user’s spatiotemporal context, such as surrounding objects, drammatically limits natural dialogue. In this demo paper, we introduce GazePointAR, a wearable augmented reality (AR) system that resolves ambiguity in speech queries using eye gaze, pointing gesture, and conversation history. With GazePointAR, a user can ask “what’s over there?” or “how do I solve this math problem?” simply by looking and/or pointing. We describe GazePointAR’s design and highlight supported use cases.},
booktitle = {Adjunct Proceedings of the 36th Annual ACM Symposium on User Interface Software and Technology},
articleno = {92},
numpages = {3},
keywords = {LLM, augmented reality, gaze tracking, multimodal input, pointing gesture recognition, voice assistants},
location = {San Francisco, CA, USA},
series = {UIST '23 Adjunct}
}

@inproceedings{10.1145/3706599.3720170,
author = {Liu, Tianjian and Kato, Kunihiro and Ohta, Takashi},
title = {From Photos to Immersive Memories: Awakening the Past with Panoramic Environments},
year = {2025},
isbn = {9798400713958},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3706599.3720170},
doi = {10.1145/3706599.3720170},
abstract = {Digital diaries relying on text and static images often struggle to effectively convey past events’ spatial context and atmosphere, limiting their ability to support vivid and episodic memory recollection. By episodic memory, we refer to an individual’s recall of personally experienced events, along with their contextual details (e.g., the time, place, and emotions present during the original experience). Virtual reality offers opportunities for more immersive re-experiences, yet integrating personal data in a meaningful, context-aware manner remains a significant challenge. To address this, we propose a system that uses EXIF metadata from diary photographs to reconstruct past environments. By applying Generative Adversarial Networks and super-resolution techniques, the system refines Google Street View panoramas to simulate original lighting and weather conditions, enhancing users’ emotional connection to their memories. User evaluations indicate that our approach improves memory clarity, emotional resonance, and immersion compared with traditional diary methods. These findings highlight the potential of virtual reality to transform personal recollection, providing an effective and innovative means for immersive and emotionally engaging memory recall.},
booktitle = {Proceedings of the Extended Abstracts of the CHI Conference on Human Factors in Computing Systems},
articleno = {291},
numpages = {6},
keywords = {Virtual reality, Immersive memory recall, Panoramic environmental reconstruction},
location = {
},
series = {CHI EA '25}
}

@inproceedings{10.1145/3689050.3707685,
author = {Timmerman, Kristof and Mertens, Rob and Yoncalik, Arafa and Spriet, Lowie},
title = {Cities Unseen: Experiencing the Imagined},
year = {2025},
isbn = {9798400711978},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3689050.3707685},
doi = {10.1145/3689050.3707685},
abstract = {"Cities Unseen: Experiencing the Imagined" is an art installation that reinterprets Italo Calvino’s "Invisible Cities" through the lens of virtual reality. The project employs a physical suitcase as a portal, allowing participants to enter and explore virtual urban environments using the Oculus Quest 3. The cityscapes will be developed with generative AI, converting Calvino’s descriptions into prompts, creating an immersive space for philosophical reflection on the nature of travel and the boundaries between reality and imagination. By integrating Unity’s shared spatial anchors and advanced multiplayer features, "Cities Unseen" supports real-time interaction among participants, emphasizing the social and collaborative dimensions of virtual travel.},
booktitle = {Proceedings of the Nineteenth International Conference on Tangible, Embedded, and Embodied Interaction},
articleno = {102},
numpages = {3},
keywords = {Virtual Reality, Immersive Storytelling, Presence, Sensory Involvement, Embodiment},
location = {
},
series = {TEI '25}
}

@inproceedings{10.1145/3757377.3763854,
author = {Lee, Jiye and Li, Chenghui and Tran, Linh and Wei, Shih-En and Saragih, Jason and Richard, Alexander and Joo, Hanbyul and Bai, Shaojie},
title = {Audio Driven Real-Time Facial Animation for Social Telepresence},
year = {2025},
isbn = {9798400721373},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3757377.3763854},
doi = {10.1145/3757377.3763854},
abstract = {We present an audio-driven real-time system for animating photorealistic 3D facial avatars with minimal latency, designed for social interactions in virtual reality for anyone. Central to our approach is an encoder model that transforms audio signals into latent facial expression sequences in real time, which are then decoded as photorealistic 3D facial avatars. Leveraging the generative capabilities of diffusion models, we capture the rich spectrum of facial expressions necessary for natural communication while achieving real-time performance (&lt;15ms GPU time). Our novel architecture minimizes latency through two key innovations: an online transformer that eliminates dependency on future inputs and a distillation pipeline that accelerates iterative denoising into a single step. We further address critical design challenges in live scenarios for processing continuous audio signals frame-by-frame while maintaining consistent animation quality. The versatility of our framework extends to multimodal applications, including semantic modalities such as emotion conditions and multimodal sensors with head-mounted eye cameras on VR headsets. Experimental results demonstrate significant improvements in facial animation accuracy over existing offline state-of-the-art baselines, achieving 100 to 1000 {\texttimes} faster inference speed. We validate our approach through live VR demonstrations and across various scenarios such as multilingual speeches.},
booktitle = {Proceedings of the SIGGRAPH Asia 2025 Conference Papers},
articleno = {51},
numpages = {12},
keywords = {Virtual Reality, Data-Driven Animation, Digital Human, Real-Time Facial Animation},
location = {
},
series = {SA Conference Papers '25}
}

@inproceedings{10.1145/3613905.3650797,
author = {Park, Gun Woo (Warren) and Panda, Payod and Tankelevitch, Lev and Rintel, Sean},
title = {CoExplorer: Generative AI Powered 2D and 3D Adaptive Interfaces to Support Intentionality in Video Meetings},
year = {2024},
isbn = {9798400703317},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3613905.3650797},
doi = {10.1145/3613905.3650797},
abstract = {Current online meeting technologies lack holistic support for reducing the effort of planning and running meetings. We present CoExplorer2D and CoExplorerVR, generative AI (GenAI)-driven technology probes for exploring the significant transformative potential of GenAI to augment these aspects of meetings. In each system, before the meeting, these systems generate tools that allow synthesis and ranking of attendees’ key issues for discussion, and likely phases that a meeting would require to cover these issues. During the meeting, these systems use speech recognition to generate 2D or VR window layouts with appropriate applications and files for each phase, and recognize the attendees’ progress through the meeting’s phases. We argue that these probes show the potential of GenAI to contribute to reducing the effort required for planning and running meetings, providing participants with a more engaging and effective meeting experiences.},
booktitle = {Extended Abstracts of the CHI Conference on Human Factors in Computing Systems},
articleno = {79},
numpages = {10},
keywords = {adaptive user interface, design, effectiveness, facilitation, generative AI, goals, intent recognition, meetings, planning, speech recognition, videoconferencing, virtual reality, windowing},
location = {Honolulu, HI, USA},
series = {CHI EA '24}
}

@inproceedings{10.1145/3505284.3532976,
author = {van der Boon, Matthijs and Fermoselle, Leonor and ter Haar, Frank and Dijkstra-Soudarissanane, Sylvie and Niamut, Omar},
title = {Deep Learning Augmented Realistic Avatars for Social VR Human Representation},
year = {2022},
isbn = {9781450392129},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3505284.3532976},
doi = {10.1145/3505284.3532976},
abstract = {Virtual reality (VR) has created a new and rich medium for people to meet each other digitally. In VR, people can choose from a broad range of representations. In several cases, it is important to provide users with avatars that are a lifelike representation of themselves, to increase the user experience and effectiveness of communication. In this work, we propose a pipeline for generating a realistic and expressive avatar from a single reference image. The pipeline consists of a blendshape-based avatar combined with two deep learning improvements. The first improvement module runs offline and improves the texture map of the base avatar. The second module runs inference in real-time at the rendering stage and performs a style transfer to the avatar’s eyes. The deep learning modules effectively improve the visual representation of the avatar and show how AI techniques can be integrated with traditional animation methods to generate realistic human avatars for social VR.},
booktitle = {Proceedings of the 2022 ACM International Conference on Interactive Media Experiences},
pages = {311–318},
numpages = {8},
keywords = {generative adversarial networks, human avatars, real-time deep learning, virtual reality},
location = {Aveiro, JB, Portugal},
series = {IMX '22}
}

@inproceedings{10.1145/3820915.3821159,
author = {Wen, Qin and Wang, Ping and Wu, Yuanling and Xu, Jiaxin},
title = {A Digital Design Method for Intangible Cultural Heritage Creative Products Based on the Cognitive-Affective-Behavioral Cultural Identity Model: A Case Study of Guang Embroidery Women's Handbag Design},
year = {2026},
isbn = {9798400723612},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3820915.3821159},
doi = {10.1145/3820915.3821159},
abstract = {Against the backdrop of globalization and digitalization, the transmission of Intangible Cultural Heritage (ICH) faces significant challenges, such as diminishing cultural identity and insufficient user engagement. Existing cultural and creative designs often remain confined to the superficial level of symbolic translation, lacking a systematic mechanism capable of effectively fostering cultural identity. Drawing upon the “Cognition-Affect-Behavior” (C-A-B) model of cultural identity, this paper proposes a digital design methodology specifically tailored for ICH-inspired cultural and creative products. First, this methodology achieves a structured representation of ICH information through the extraction and encoding of cultural elements; second, it establishes a mapping mechanism between the three-tiered model of cultural identity and specific design elements. Furthermore, by integrating parametric design and digital generative technologies, the study constructs a design workflow framework encompassing the stages of “data acquisition—feature translation-generative design-user feedback.” The efficacy of this methodology is validated through a case study involving ICH-inspired apparel design, utilizing user questionnaires to assess users' cognitive understanding, emotional resonance, and behavioral intentions. The research findings demonstrate that this methodology effectively enhances users' level of cultural identity, offering a novel methodological pathway and practical reference for the design of ICH-related cultural and creative products.},
booktitle = {Proceedings of the 2nd International Conference on Artificial Intelligence, Virtual Reality and Interaction Design},
pages = {1581–1585},
numpages = {5},
keywords = {C-A-B Model, Costume Design, Cultural Identity, Digital Design, Intangible Cultural Heritage-based Creative Products},
location = {
},
series = {AIVRID '26}
}

@inproceedings{10.1145/3820915.3820975,
author = {Li, Siyuan and Liu, Xutong and Zhang, Qi},
title = {From the Perspective of Artificial Intelligence: Design and Application of Song Brocade Patterns Based on the Theory of Qualia},
year = {2026},
isbn = {9798400723612},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3820915.3820975},
doi = {10.1145/3820915.3820975},
abstract = {This study aims to precisely classify user demands using generative artificial intelligence tools, addressing the issue of insufficient quantification of users' emotional needs in cultural and creative product design related to Song Brocade patterns. It proposes an innovative design strategy based on the Theory of Qualia and generative AI technology to enhance the cultural identity and market competitiveness of such products. A qualia model is constructed around product imagery, behavioral preference, and emotional identity as its three core dimensions. The Kano model and K-means clustering analysis are employed to classify the preferences of 129 users. The Song Brocade patterns are generated and trained using the LoRA model to achieve visual optimization, with the design outcomes subsequently validated through user evaluation. According to the K-means clustering analysis of user classifications, the “Cultured-Elegant” group prefers historical connotations, while the “Functional-Practical” group focuses on convenience. Based on these findings, culturally adaptive patterns are generated. This strategy provides significant insights for the refined development and industrial advancement of intangible cultural heritage cultural and creative products.},
booktitle = {Proceedings of the 2nd International Conference on Artificial Intelligence, Virtual Reality and Interaction Design},
pages = {393–398},
numpages = {6},
keywords = {Artificial Intelligence Generated Content(AIGC), K-means Clustering,, Qualia Theory, Song Brocade},
location = {
},
series = {AIVRID '26}
}

@inproceedings{10.1145/3714394.3756248,
author = {Shilova, Marta and Hong, Hui-Ting and Chen, Chu-Yin and Lee, Ray-Kuang},
title = {A Sensory Experience Through the Entanglement of Dynamic Virtual Memories},
year = {2026},
isbn = {9798400714771},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3714394.3756248},
doi = {10.1145/3714394.3756248},
abstract = {Intricate Memories is an immersive and interactive virtual reality installation that explores how bodily sensations, gaze, and multimodal feedback affect the participant's sense of presence through a responsive avatar. The system integrates real-time body tracking, eye tracking, and generative AI to enable a dynamic entanglement between the participant and their avatar, whose appearance evolves based on emotional and sensory stimuli. By combining multiple input modalities and sensory outputs, this VR space supports non-linear interactions guided by gaze, allowing the avatar's body to act as a medium of somatic memory. The project examines how three types of memory : somatic, mental, and collective artificial, reshape presence and body representation in immersive environments. It also critically examines how media representations, especially those shaped by disinformation, can alter our affects.},
booktitle = {Companion of the 2025 ACM International Joint Conference on Pervasive and Ubiquitous Computing},
pages = {1243–1247},
numpages = {5},
keywords = {virtual reality, multisensory interaction, eye tracking, entanglement, virtual body, generative ai, somatic memory},
location = {Finland},
series = {UbiComp Companion '25}
}

@inproceedings{10.1145/3706599.3719877,
author = {Nassani, Alaeddin and Blake, John and Villegas, Julian},
title = {Adaptive Learning Companions: Enhancing Education with Biosignal-Driven Digital Human},
year = {2025},
isbn = {9798400713958},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3706599.3719877},
doi = {10.1145/3706599.3719877},
abstract = {We introduce a novel approach to language learning leveraging digital humans as adaptive tutors within immersive XR environments. Our system’s novelty lies in the use of biosignals, specifically real-time heart rate data, collected from a Samsung Watch 7, to dynamically adapt the learning experience. The digital human tutor adjusts its behavior, feedback, and the difficulty of the learning content based on the learner’s inferred cognitive and emotional state. We present the fully developed system architecture, which integrates a customizable digital human powered by ConvAI, LLM, an XR environments, and a data streaming pipeline. While human participant testing is planned , preliminary insights from the system’s development demonstrate the technical feasibility of this approach. This research has the potential to significantly enhance language learning outcomes, engagement, and motivation by creating more personalized, and engaging learning experiences, paving the way for a new generation of adaptive educational technologies.},
booktitle = {Proceedings of the Extended Abstracts of the CHI Conference on Human Factors in Computing Systems},
articleno = {63},
numpages = {7},
keywords = {Virtual Reality, Language Learning, Adaptive, Biosignal, Avatar, Digital Human},
location = {
},
series = {CHI EA '25}
}

@inproceedings{10.1145/3820915.3820958,
author = {Zhang, Ji},
title = {Research on AI-Empowered Visual Translation and Innovative Communication of Bashu Regional Cultural Heritage},
year = {2026},
isbn = {9798400723612},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3820915.3820958},
doi = {10.1145/3820915.3820958},
abstract = {With the advancement of generative AI technology, its applications in visual design have garnered significant attention. To address challenges in traditional regional cultural visual communication—including limited design efficiency, insufficient creative expression, and difficulties in translating cultural symbols—this study focuses on Bashu regional culture and establishes a cultural visual design research framework based on AIGC (ARTIFICIAL INTELLIGENCE GENERATED CONTENT). The research first systematically collects visual resources of Bashu culture, creating a cultural visual database that includes traditional patterns, cultural symbols, performing arts, and architectural elements. Subsequently, through cultural feature extraction and PROMPT prompt design, generative AI models generate cultural visual images, which are then integrated via a collaborative “AI generation + designer optimization” model. During the experimental phase, the AI model generated 120 visual design proposals across three categories: cultural posters, product packaging, and cultural illustrations. Thirty design professionals were invited to evaluate the proposals, and a five-point Likert scale was used to construct a cultural visual communication evaluation system. Results showed that all metrics averaged over 4.0, with the visual creativity index reaching 4.47, indicating strong performance in creative expression and cultural symbol presentation. Compared to traditional design processes, AI-assisted design improved creativity scores by approximately 16\% and significantly enhanced design efficiency. The research findings demonstrate that AIGC technology can effectively expand the creative space for cultural visual design, while providing innovative design methodologies and practical approaches for regional cultural visual communication.},
booktitle = {Proceedings of the 2nd International Conference on Artificial Intelligence, Virtual Reality and Interaction Design},
pages = {283–289},
numpages = {7},
keywords = {AI-Assisted Design, AIGC, Bashu Culture, Cultural Heritage, Visual Communication},
location = {
},
series = {AIVRID '26}
}

@inproceedings{10.1145/3820915.3821097,
author = {Sha, Chunping},
title = {Human-AI Co-Creative Aesthetics: Mechanisms and Value of Deep Learning Image Generation in Art Education},
year = {2026},
isbn = {9798400723612},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3820915.3821097},
doi = {10.1145/3820915.3821097},
abstract = {The deep integration of generative artificial intelligence (AI) is reshaping the paradigm of artistic creation, transforming “human-AI co-creation” from a technological possibility into a critical issue that art education must address. Based on theoretical reasoning and literature synthesis, this study systematically reviews cutting-edge theories of human-AI co-creativity and constructs a five-stage co-creative model encompassing “Divergent Exploration - Intent Articulation - Co-generative Exploration - Critical Curation - Iterative Refinement.” Integrating Jeongki Lim's theory of “relational artifacts,” Duri Long's framework of “co-creative AI,” and recent systematic review findings, the study elucidates the intrinsic mechanisms of human-AI co-creation from the dual perspectives of relational construction and interaction design. The findings reveal that human-AI co-creation is fundamentally a deep collaborative relationship characterized by “human-led, AI-enhanced” dynamics: AI expands the possibility space of creativity, while humans remain the ultimate agents of intention setting, value judgment, and meaning construction. The “imperfections” of AI-generated images are transformed into creative resources through mechanisms of “serendipity capture,” “critical awareness against over-compliance,” and “metacognitive reflection in intention-output gaps.” This transformation is reshaping the value structure of art education, shifting it from an exclusive focus on “skill training” toward the multidimensional integration of “creative cultivation,” “narrative capacity,” and “aesthetic competence.” Based on these findings, this paper proposes collaborative teaching strategies for future-oriented art education.},
booktitle = {Proceedings of the 2nd International Conference on Artificial Intelligence, Virtual Reality and Interaction Design},
pages = {1168–1172},
numpages = {5},
keywords = {Human-AI co-creativity, art education, co-creative AI, deep learning, image generation},
location = {
},
series = {AIVRID '26}
}

@inproceedings{10.1145/3777730.3777820,
author = {Lu, Yiwei},
title = {AIGC traces the reactivation of traditional culture: The construction of the grand model of “Wisdom Red Mountain”},
year = {2026},
isbn = {9798400718540},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3777730.3777820},
doi = {10.1145/3777730.3777820},
abstract = {Under the background of deepening the integration of data and intelligence, the digital preservation and innovation dissemination of traditional cultural resources has become an important path for the protection and reuse of cultural heritage. Taking Hongshan culture as the research object, this paper relies on generative artificial intelligence technology to construct an intelligent Hongshan big model for the identification, extraction and re-creation of Hongshan cultural elements, which is committed to realizing the intelligent mining and activation application of cultural resources. By systematically combing the visual features, instrument forms and totem symbols of Hongshan culture, the cross-modal generative model and low-rank adaptive technology are combined to complete the efficient processing and feature reconstruction of cultural data. Based on 3D real-time rendering and interactive design, the digital image and immersive experience scene with the characteristics of Hongshan culture are created. This paper further proposes a set of technical paths and design frameworks from cultural element extraction to digital IP generation, which provides theoretical support and practical reference for the creative transformation and innovative dissemination of traditional culture in contemporary society.},
booktitle = {Proceedings of the 2025 International Conference on Artificial Intelligence, Virtual Reality and Interaction Design},
pages = {556–561},
numpages = {6},
keywords = {Digital revitalization, Large model, Cultural inheritance, Interaction design, Generative artificial intelligence, Hongshan culture},
location = {
},
series = {AIVRID '25}
}

@inproceedings{10.1145/3820915.3821027,
author = {Wang, Ruijie and Chen, Qiu},
title = {Chinese Landscape Painting Composition Generation and Spatial Layout Optimization Using Transformer-Diffusion Hybrid Model},
year = {2026},
isbn = {9798400723612},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3820915.3821027},
doi = {10.1145/3820915.3821027},
abstract = {Recent advancements in deep generative models have shown remarkable success in image synthesis; however, generating traditional Chinese landscape paintings remains a significant challenge. Existing models, such as Generative Adversarial Networks (GANs) and standard Diffusion Models, inherently rely on Western single-point perspective priors and struggle to capture unique Eastern aesthetic principles. Consequently, they often fail to replicate the “scatter perspective” (multi-point perspective) and “Ji Bai Dang Hei” (intentional blank space), resulting in flattened spatial hierarchies and noise-polluted blank areas. To address these limitations, this paper proposes a novel Transformer-Diffusion hybrid architecture specifically tailored for Chinese landscape painting synthesis. First, we introduce a Three-Distances Spatial Encoder (TSE) to mathematically formulate the scatter perspective, enabling the Transformer to act as a global planner that constructs rational spatial hierarchies across high, deep, and level distances. Second, a Virtual-Real Attention Mechanism (VRAM) is proposed to dynamically modulate the U-Net denoising process, actively preserving the purity of intentional blank spaces. We construct a specialized dataset comprising 320 topologically-annotated classical masterpieces and 180 structural sketches. Extensive experiments demonstrate that our hybrid model significantly outperforms state-of-the-art baselines. Quantitatively, our method achieves a Fr{\'e}chet Inception Distance (FID) of 21.4 and establishes new benchmarks on domain-specific metrics, improving the Spatial Hierarchy Score (SHS) by 29.3\% and the Blankness Rationality Ratio (BRR) by 18.5\%. This research provides a mathematically rigorous paradigm for integrating classical art theories into neural network design, advancing the digitization of cultural heritage.},
booktitle = {Proceedings of the 2nd International Conference on Artificial Intelligence, Virtual Reality and Interaction Design},
pages = {729–735},
numpages = {7},
location = {
},
series = {AIVRID '26}
}

@inproceedings{10.1145/3820915.3820956,
author = {Hua, Yi},
title = {Multimodal Transformer with Contrastive Learning for Automated Generation and Style Transfer of Chinese Intangible Cultural Heritage Patterns},
year = {2026},
isbn = {9798400723612},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3820915.3820956},
doi = {10.1145/3820915.3820956},
abstract = {With the development of the digital cultural industry, the digital preservation and intelligent design of traditional cultural patterns have gradually become an important interdisciplinary field in computer vision and cultural heritage research. However, existing image generation methods still suffer from limitations in data scale, insufficient cultural semantic expression, and low style transfer stability in intangible cultural heritage pattern generation tasks. To address these issues, this paper proposes an intangible cultural heritage pattern generation method that combines multimodal Transformer and contrastive learning mechanisms. This method extracts cultural symbols and structural information from traditional patterns by constructing a cultural feature encoder, and uses a multimodal Transformer model to model the global structural relationships of the patterns. Simultaneously, a contrastive learning mechanism is introduced to optimize the feature space distribution, thereby enhancing the model's ability to express cultural semantic features. Experiments are conducted on a constructed intangible cultural heritage pattern dataset. The results show that compared with mainstream generative models such as CycleGAN and StyleGAN2, the proposed method achieves significant improvements in FID, SSIM, and cultural consistency scores. The generated patterns exhibit better stability and consistency in both visual quality and cultural symbol expression. The research results demonstrate that combining cultural semantic modeling with deep generative models can effectively improve the quality of traditional pattern generation. This study provides a new technical framework for the intelligent generation and style transfer of intangible cultural heritage patterns, and offers valuable technical references for digital cultural heritage protection and cultural and creative design.},
booktitle = {Proceedings of the 2nd International Conference on Artificial Intelligence, Virtual Reality and Interaction Design},
pages = {268–275},
numpages = {8},
keywords = {Chinese intangible heritage patterns, Multimodal Transformer model, contrastive learning framework, cultural pattern generation, style transfer design},
location = {
},
series = {AIVRID '26}
}

@inproceedings{10.1145/3746059.3747659,
author = {Hou, Zhuangze and Tian, Jingze and Li, Nianlong and Ren, Farong and Liu, Can},
title = {EchoLadder: Progressive AI-Assisted Design of Immersive VR Scenes},
year = {2025},
isbn = {9798400720376},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3746059.3747659},
doi = {10.1145/3746059.3747659},
abstract = {Mixed reality platforms allow users to create virtual environments, yet novice users struggle with both ideation and execution in spatial design. While existing AI models can automatically generate scenes based on user prompts, the lack of interactive control limits users’ ability to iteratively steer the output. In this paper, we present EchoLadder, a novel human-AI collaboration pipeline that leverages large vision-language model (LVLM) to support interactive scene modification in virtual reality. EchoLadder accepts users’ verbal instructions at varied levels of abstraction and spatial specificity, generates concrete design suggestions throughout a progressive design process. The suggestions can be automatically applied, regenerated and retracted by users’ toggle control. Our ablation study showed effectiveness of our pipeline components. Our user study found that, compared to baseline without showing suggestions, EchoLadder better supports user creativity in spatial design. It also contributes insights on users’ progressive design strategies under AI assistance, providing design implications for future systems.},
booktitle = {Proceedings of the 38th Annual ACM Symposium on User Interface Software and Technology},
articleno = {55},
numpages = {22},
keywords = {AIGC, LVLMs, Progressive design, VR space authoring, Spatial design, Multimodal interface, Natural language input},
location = {
},
series = {UIST '25}
}

