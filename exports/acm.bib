@inproceedings{10.1145/3769534.3769599,
author = {Garan{\v c}s, Jundefinednis},
title = {Bridging Immersive Analytics and Affect: Audiovisual XR Sceneries of Financial Transactions},
year = {2025},
isbn = {9798400718458},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3769534.3769599},
doi = {10.1145/3769534.3769599},
abstract = {Immersive technologies, such as virtual reality (VR) and extended reality (XR), are reshaping data mediation by enabling multi-sensory environments that blend applied and fine arts. This paper introduces an investigation of the interplay between Immersive Analytics and affective aesthetics through generative audiovisual coherence. Framed as practice-led research in media arts and creative technologies, the work comprises immersive installations and performances that visualize and sonify financial transactions—trades and order-book fluctuations. These compositions fuse charts and abstract graphics with realistic simulations of natural elements and visual effects. The audiovisual sceneries employ stereoscopic projection, AI-aided graphic algorithms and surround sound to construct spatial, dynamic audiovisual experiences that try to reference and transfer market states such as euphoria, confusion, and fear, examining how such aesthetics transform the perception of the represented data. The work series investigates immersive scenery’s potential to craft hyperreal, emotionally resonant human–computer interactions while raising critical questions about representation and the ethics of data‑driven, affect‑inducing immersion.},
booktitle = {Proceedings of the 18th International Symposium on Visual Information Communication and Interaction},
articleno = {54},
numpages = {5},
keywords = {Immersive analytics, Affective aesthetics, Emotional design, Generative audiovisual art, AI-assisted art},
location = {
},
