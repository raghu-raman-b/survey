@inproceedings{10.1145/3828157.3828791,
author = {Parchami, Alireza and Saberpour Abadian, Artin and Schramm, Robin Connor and Steimle, J{\"u}rgen and Schwanecke, Ulrich},
title = {Speak to the City: Multimodal Resolution for Outside-the-Vehicle References},
year = {2026},
isbn = {9798400728143},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3828157.3828791},
doi = {10.1145/3828157.3828791},
abstract = {As autonomous vehicles and Extended Reality (XR) headsets enable novel in-car interactions, seamlessly querying physical landmarks, known as Outside-the-Vehicle Referencing (OVR), remains challenging due to ego-motion and referential ambiguity. We present a robust, multimodal OVR framework fusing user gaze and natural language to identify Points of Interest (POIs). To address the scarcity of dynamic vehicular data, we developed a VR-based pipeline synchronizing 360-degree transit videos with vehicle GNSS telemetry. Through a user study (N=46) mapping passenger head orientation into a 3D geospatial Digital Twin, we captured authentic gaze-speech behaviors. We subsequently trained a lightweight Transformer network, leveraging LLMs to dynamically align continuous spatial gaze vectors with discrete verbal context. Experimental results demonstrate high accuracy and low computational overhead, achieving an 83.33\% Top-1 accuracy (87.72\% Top-2) and an average inference time of 24.3 milliseconds. This real-time paradigm effectively resolves referential ambiguity, enabling context-aware spatial retrieval for passengers within the vehicle.},
booktitle = {Proceedings of the 18th International Conference on Automotive User Interfaces and Interactive Vehicular Applications},
pages = {95–105},
numpages = {11},
keywords = {Outside-the-Vehicle Referencing, In-Car Extended Reality, Multimodal Interaction, Point of Interest Estimation, Generative AI},
location = {
},
series = {AutomotiveUI '26}
}

@inproceedings{10.1145/3830911.3830939,
author = {Leem, Dylan and Leen, Kova},
title = {A Lightweight Image-Recognition WebAR Narrative System for Low-Barrier Digital Prototyping in Wellness-Oriented Cultural Tourism Parks},
year = {2026},
isbn = {9798400725098},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3830911.3830939},
doi = {10.1145/3830911.3830939},
abstract = {Wellness-oriented cultural tourism parks often contain local cultural narratives, health-oriented product knowledge, educational materials, and situated interpretive resources, yet they frequently face practical constraints when introducing digital interpretation systems. Native applications, heavy AR infrastructures, and high-fidelity 3D assets may increase development costs, maintenance burdens, and entry barriers for visitors. To address these constraints, this paper presents a lightweight image-recognition WebAR narrative system for low-barrier digital prototyping in wellness-oriented cultural tourism parks. The system runs in a mobile browser, supports QR/URL-based access, recognizes physical image targets, and triggers multimodal interpretive content, including images, audio, video, role prompts, mini-tasks, progress feedback, and AR-like HUD overlays. Using the Bao Gu-and-Chinese Mugwort cultural-historical anecdote as the narrative basis of the Chinese Mugwort Healer Quest prototype, the system integrates MindAR image tracking, A-Frame/Three.js rendering, target-attached HUD presentation, local progress gating, and explicit media-triggering mechanisms. Its runtime flow follows a sequence of detecting a physical marker, checking the expected station, attaching a reusable HUD to the detected target, rendering the current narrative phase, and unlocking the next station after user interaction. Rather than reporting comparative user-experience results, this paper focuses on system architecture, key implementation logic, and a field technical validation checklist. The contribution is a deployable and maintainable WebAR prototyping approach for low-cost digital interpretation in resource-constrained wellness-oriented cultural tourism environments.},
booktitle = {Proceedings of the 2026 International Conference on Artificial Intelligence and Generative Design},
pages = {182–187},
numpages = {6},
keywords = {Digital Narrative, Image Recognition, Mobile Augmented Reality, WebAR, Wellness Tourism},
location = {
},
