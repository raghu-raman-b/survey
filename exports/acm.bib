@inproceedings{10.1145/3777730.3777794,
author = {OuYang, YuXuan and Jiang, YuShan},
title = {Research on Visualized Landscape Design and Optimization Combining BIM and Deep Learning},
year = {2026},
isbn = {9798400718540},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3777730.3777794},
doi = {10.1145/3777730.3777794},
abstract = {Building Information Modeling (BIM) technology has been increasingly applied in landscape design. However, traditional BIM methods still face limitations in modeling complex landscape elements and design optimization. Deep learning provides a novel approach to address these challenges. This study proposes an integrated method combining BIM and deep learning for visualized landscape design and optimization. A convolutional neural network-based model is constructed for landscape element recognition, along with a generative adversarial network framework for design scheme generation. Experimental verification based on a city park project shows that the proposed method achieves a recognition accuracy of 94.235\%, improves design generation efficiency by 67.892\%, and yields a user satisfaction score of 4.726 out of 5, demonstrating its effectiveness and practical value in the landscape design domain.},
booktitle = {Proceedings of the 2025 International Conference on Artificial Intelligence, Virtual Reality and Interaction Design},
