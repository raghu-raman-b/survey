address = {New York, NY, USA},
url = {https://doi.org/10.1145/3820915.3820949},
doi = {10.1145/3820915.3820949},
abstract = {With the rapid popularization of interactive systems (e.g., e-commerce platforms, social media, and content streaming services), AI recommendation models have become core components to address information overload. However, traditional recommendation algorithms tend to over-fit user historical preferences, leading to the formation of information cocoons, which not only limit users’ access to diverse information but also reduce long-term user engagement. To solve this problem, this paper proposes an adaptive AI recommendation model (AARM) that integrates dynamic user preference modeling, diversity optimization, and real-time feedback adjustment. The model first captures the temporal evolution of user interests through a time-aware preference encoder, then introduces a diversity constraint mechanism to balance recommendation accuracy and content diversity, and finally realizes adaptive adjustment of recommendation strategies based on real-time user interaction feedback. Experimental results on MovieLens and Amazon Reviews datasets show that compared with traditional collaborative filtering, content-based recommendation, and LLM-enhanced hybrid models, the proposed AARM improves user click-through rate (CTR) by 12.3\% and 9.7\% respectively, increases recommendation diversity by 21.5\% and 18.9\%, and effectively alleviates the information cocoon effect while ensuring user experience. This study provides a feasible solution for building user-centric, diverse, and adaptive recommendation systems in interactive scenarios.},
booktitle = {Proceedings of the 2nd International Conference on Artificial Intelligence, Virtual Reality and Interaction Design},
pages = {223–228},
numpages = {6},
keywords = {AI Model, Adaptive Recommendation, Information Cocoon, Interactive Systems, Preference Modeling, User Experience},
location = {
},
series = {AIVRID '26}
}

@inproceedings{10.1145/3803784.3804474,
author = {Lim, Timothi},
title = {From Spectators to Co-Creators: Designing Social XR Frameworks Incorporating Nonverbal GenAI and Real-Time Data in Co-Located XR Experiences},
year = {2026},
isbn = {9798400725838},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3803784.3804474},
doi = {10.1145/3803784.3804474},
abstract = {Co-located Extended Reality (XR) installations increasingly seek to support social and cooperative play. However groups can struggle to coordinate and interpret cues to act, which inhibits their participation in the experience of the installation. My practice-based PhD thus investigates how nonverbal sensorial feedback, driven by real-time data and mediated by generative artificial intelligence (GenAI) facilitators, might support pro-social and co-creative group play in room-scale co-located social XR installations. Developed in Unreal Engine 5, my extended reality (XR) installation integrates Azure Kinect Sensors to TouchDesigner and streams real-time data via Open Sound Control (OSC), which feeds into the GenAI facilitation layer. The GenAI facilitation layer parses the data and returns cue actions that Unreal enacts as a world-anchored audiovisual intervention that the groups can then coordinate and interpret. Through convergent mixed-methods analysis, I examine how groups interpret cues, how norms emerge during play, and which design configurations help scaffold cooperative pro-social play. The outcome of my PhD is an emerging evidence-led Social XR Framework that offers reusable design patterns for nonverbal GenAI Facilitation and my installation projects as research artefacts that can be reproduced in different contexts by other researchers.},
booktitle = {Proceedings of the 2026 Conference on Creativity and Cognition},
pages = {83–90},
numpages = {8},
keywords = {Social XR, co-creation, co-located XR, generative AI, interactive installations, nonverbal facilitation, play, real-time data, social norms, themed entertainment},
location = {
},
series = {C&amp;C '26}
}

@inproceedings{10.1145/3820915.3820981,
author = {Xiu, Xinxin and Xu, Siyi and Zhao, Yanxiu},
title = {AI-Enabled Dynamic Visual Reconstruction of Northern Chinese Island Culture: A Focus on Marine Heritage Dissemination in Changhai County},
year = {2026},
isbn = {9798400723612},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3820915.3820981},
doi = {10.1145/3820915.3820981},
abstract = {In recent years, the rapid development of Artificial Intelligence (AI) has brought profound changes to the digital representation and dissemination of local culture. Northern Chinese islands culture, exemplified by Changhai County, possesses distinctive regional and seasonal characteristics. However, it faces challenges in continuous cultural dissemination due to seasonal dependence, fragmented visual symbols, and the simplification of traditional rituals. This study employs field surveys and AI-enabled dynamic visualization as its research methodology. It explores the practical applications of AI-enabled dynamic visual technologies in the preservation and dissemination of island culture. The study finds that AI can efficiently support the generation of cultural content, unify visual styles, extract key cultural symbols, and enable interactive experiences, thereby facilitating the dissemination of marine cultural heritage. This paper proposes a structurally integrated four-layer framework for the dynamic dissemination of northern island culture. This facilitates year-round accessibility and authentic representation of northern island culture, while offering a systematic approach to combining generative and platform-based dissemination and providing theoretical guidance and practical reference for cultural preservation, reinterpretation, and interactive engagement.},
booktitle = {Proceedings of the 2nd International Conference on Artificial Intelligence, Virtual Reality and Interaction Design},
pages = {433–438},
numpages = {6},
keywords = {AIGC (AI-Generated Content), Dynamic Imagery, Immersive Interaction, Maritime Heritage Culture},
location = {
},
series = {AIVRID '26}
}

@inproceedings{10.1145/3756884.3770547,
author = {Lee, Jeong Yeon and Park, Soungsill and chai, youngho},
title = {MoPriC : Two Stage Approach for Text Guided Motion-Primitives Composition},
year = {2025},
isbn = {9798400721182},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3756884.3770547},
doi = {10.1145/3756884.3770547},
abstract = {Text-to-motion generative models suffer from the long-term dependency problem, where it becomes difficult to maintain the context of text instructions as the motion length increases. Also, current MoCap datasets include only predefined actions and fail to reflect diverse individual styles. To address these limitations, we introduced MoPriC, a two-stage motion composition framework that produces sequential motions from elementary motion primitives guided by text descriptions. We also presented DancePrimitives, a new dataset of collected motion primitives to capture the semantics of each unit motion.},
booktitle = {Proceedings of the 2025 31st ACM Symposium on Virtual Reality Software and Technology},
articleno = {137},
numpages = {2},
keywords = {Avatars, Text-to-Motion Generation, Mocap Dataset},
location = {
},
series = {VRST '25}
}

@inproceedings{10.1145/3820915.3820954,
author = {Wu, Xiaofen},
title = {Landscape Design Optimization Based on Big Data and Intelligent Technology},
year = {2026},
isbn = {9798400723612},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3820915.3820954},
doi = {10.1145/3820915.3820954},
abstract = {As a key medium for coordinating natural ecosystems and artificial built environments, landscape architecture design integrates ecological functions, aesthetic values, and social cultural attributes. Traditional design paradigms often rely on subjective experience and judgment, which are limited by insufficient data support and weak quantitative analysis. With the in-depth application of big data analysis and intelligent algorithms, landscape architecture design is gradually transforming towards a data-driven and model-optimized scientific direction. By mining and machine learning from massive environmental data on meteorology, soil, vegetation coverage, human behavior trajectories, heat maps of pedestrian flow, activity preferences, and cultural geographic information, designers can construct multi-dimensional decision-making models to achieve precise identification of site characteristics, ecological sensitivity assessment, and prediction of usage demands. Moreover, the integration of intelligent generative design, parametric simulation, and virtual reality (VR) technologies enables dynamic verification of the spatial efficiency and ecological adaptability of design schemes, thereby optimizing core indicators such as landscape patterns, microclimate regulation, and resource circulation. This paper systematically demonstrates the methodological value of big data and intelligent technologies in landscape architecture design and proposes a design strategy framework based on data modeling, intelligent feedback, and collaborative platforms, providing theoretical basis and practical paths for technological upgrading in the industry.},
booktitle = {Proceedings of the 2nd International Conference on Artificial Intelligence, Virtual Reality and Interaction Design},
pages = {255–261},
numpages = {7},
keywords = {Big data, Intelligent technology, Landscape architecture design, Optimization strategies Introduction},
location = {
},
series = {AIVRID '26}
}

@inproceedings{10.1145/3820915.3820925,
author = {Song, Bin and Yang, Wei},
title = {Reconstructing the Design Workflow from Tradition to Algorithm in AI-Assisted Ceramic Product Design},
year = {2026},
isbn = {9798400723612},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3820915.3820925},
doi = {10.1145/3820915.3820925},
abstract = {The increasing prevalence of artificial intelligence (AI) in design practice has sparked interest in AI-assisted creativity; however, existing research focuses on technical performance or visual effects, with little attention paid to how AI reshapes design processes in craft-based design fields. This study aims to fill this gap by exploring how AI-assisted tools transform the ceramic product design workflow from a process-oriented perspective. Using a qualitative, practice-based approach, this study reconstructs and compares traditional and AI-assisted ceramic product design workflows through design experiments and protocol analysis. The results show that AI primarily intervenes in the early ideation stage of the design process, introducing a generative layer, reorganizing iterative patterns, and front-loading the exploration process. Rather than replacing traditional practices, AI reshapes the workflow structure, shifting the designer's role from direct generation to curation, evaluation, and contextual judgment, while material experimentation, craft knowledge, and cultural understanding remain crucial in the later stages of the design process. This study contributes to design research by providing empirical evidence from a craft-based design field and proposing a workflow reconstruction method to facilitate human-AI collaboration. By positioning AI as a workflow intermediary embedded within design practice, this study offers a deeper understanding of how AI supports innovation in ceramic product design while maintaining cultural continuity and craft integrity.},
booktitle = {Proceedings of the 2nd International Conference on Artificial Intelligence, Virtual Reality and Interaction Design},
pages = {54–59},
numpages = {6},
keywords = {AI-assisted design, Ceramic product design, Craft-based creativity, Design workflow, Human–AI collaboration},
location = {
},
series = {AIVRID '26}
}

@inproceedings{10.1145/3820915.3820945,
author = {Xu, Jinghao and Qie, Longfei},
title = {Attention-Enhanced SRGAN for Image Super-Resolution and Restoration},
year = {2026},
isbn = {9798400723612},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3820915.3820945},
doi = {10.1145/3820915.3820945},
abstract = {Magnetic Resonance Imaging (MRI) is widely used in clinical diagnosis due to its superior soft-tissue contrast and the absence of ionizing radiation. However, the spatial resolution of acquired MRI is often constrained by scan time and signal-to-noise ratio (SNR), leading to blurred details and missing high-frequency information, which can hinder accurate interpretation. MRI super-resolution aims to reconstruct high-resolution (HR) images from low-resolution (LR) inputs without additional scanning cost, thereby improving image quality while maintaining clinical throughput. To address the training instability and insufficient detail recovery commonly observed in conventional deep-learning super-resolution methods, this paper proposes an improved generative adversarial network (GAN) named SRGAN-GA. Built upon SRGAN, the proposed framework first introduces the Wasserstein distance with gradient penalty (SRGAN-GP) to stabilize adversarial training, and then incorporates an attention mechanism and a conditional discrimination strategy (SRGAN-GA) to enhance local structural and fine-detail restoration in MRI. Experimental results on an MRI dataset demonstrate that SRGAN-GA achieves the best performance, reaching 34.22 dB in PSNR and 0.917 in SSIM under SRF = 2, outperforming baseline models. The proposed method provides an efficient and stable solution for MRI super-resolution with promising potential for clinical image-quality enhancement.},
booktitle = {Proceedings of the 2nd International Conference on Artificial Intelligence, Virtual Reality and Interaction Design},
pages = {196–201},
numpages = {6},
keywords = {Attention Mechanism, MRI Super-Resolution, SRGAN},
location = {
},
series = {AIVRID '26}
}

@inproceedings{10.1145/3777730.3777847,
author = {Zhang, Zhengyuan and Li, Mengfan and Situ, Qianmiao and Li, Xinci},
title = {Product Packaging Design Automation Optimization Based on Image Processing and GAN},
year = {2026},
isbn = {9798400718540},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3777730.3777847},
doi = {10.1145/3777730.3777847},
abstract = {With the rapid development of artificial intelligence in the field of visual creativity, product packaging design is embracing new opportunities for automation and intelligence. However, traditional image generation methods still struggle to meet the complex aesthetic demands, layout structures, and printing compliance requirements of packaging design, often resulting in unstable generation quality and insufficient structural control. This paper proposes an optimization framework for packaging design that integrates image processing techniques with Generative Adversarial Networks (GANs). The framework incorporates structural preservation modules, semantic guidance mechanisms, and color printability constraints to enhance both visual appeal and industrial applicability. A multi-dimensional evaluation metric system was established, and extensive experiments were conducted on typical packaging scenarios such as beverages, personal care, and snacks. Experimental results demonstrate that the proposed method significantly outperforms mainstream models in terms of aesthetic scores, OCR recognition accuracy, layout consistency, and color compliance. Notably, the model achieved superior performance in ΔE₀₀ color difference control and TAC violation rate. This study not only improves the visual and practical quality of generated designs but also provides a feasible technical path for intelligent packaging design generation.},
booktitle = {Proceedings of the 2025 International Conference on Artificial Intelligence, Virtual Reality and Interaction Design},
pages = {732–737},
numpages = {6},
keywords = {Generative Adversarial Networks, Image Processing, Packaging Design Optimization, Printability Compliance, Visual Aesthetic Constraints},
location = {
},
series = {AIVRID '25}
}

@inproceedings{10.1145/3820915.3820978,
author = {Guo, Linna and Meng, Fandong and Hsieh, Yiching and Cao, Jing and Shen, Chaochun},
title = {AIGC-Assisted Fashion Content Creation and Communication in New Media},
year = {2026},
isbn = {9798400723612},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3820915.3820978},
doi = {10.1145/3820915.3820978},
abstract = {With the rapid development of generative artificial intelligence (AIGC) technology, its applications in new media content production and dissemination have become increasingly widespread, particularly demonstrating significant potential in fashion communication. Addressing challenges such as high production costs, low efficiency, and difficulty in quantifying communication effectiveness in traditional fashion content creation, this study focuses on “AIGC-Assisted Fashion Content Generation and New Media Dissemination,” establishing an integrated analytical framework spanning content generation to dissemination evaluation. First, at the content production level, we achieve automated generation and style control of fashion visual content through diffusion models and text prompt engineering methods. Second, in dissemination analysis, we develop a multi-dimensional evaluation system encompassing click-through rates, like rates, comment rates, and share rates, while constructing a weighted scoring model for quantitative analysis of content dissemination performance. Finally, by comparing the dissemination effects of different content types and styles across new media platforms, we validate AIGC's advantages in enhancing content appeal and user engagement. Research findings indicate that AIGC-generated content significantly outperforms traditional content in key metrics such as click-through rates and interaction rates, effectively improving dissemination efficiency and user participation while demonstrating stronger adaptability in innovative style expression. This study not only expands the application pathways of AIGC in fashion communication but also provides data-driven theoretical foundations and practical references for optimizing content production and dissemination in new media environments.},
booktitle = {Proceedings of the 2nd International Conference on Artificial Intelligence, Virtual Reality and Interaction Design},
pages = {412–417},
numpages = {6},
keywords = {AIGC, Content Generation, Diffusion Models, Fashion Communication, New Media, Social Media Analytics, User Engagement},
location = {
},
series = {AIVRID '26}
}

@inproceedings{10.1145/3820915.3821092,
author = {Zhao, Ruiming and Liu, Na},
title = {Computational Analysis of Emotional Coding Characteristics in Female Artists' Works from the Perspective of Neural Plasticity},
year = {2026},
isbn = {9798400723612},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3820915.3821092},
doi = {10.1145/3820915.3821092},
abstract = {In the era of increasingly precise intelligent generation of artistic works, model algorithms excel in simulating the style of artists' works but overlook the original pursuit of art, which is to convey emotions. How can the emotional state of an artist be accurately conveyed to the viewer. In our research, we establish a system for AI learning through emotional encoding, mapping the emotional characteristics of artists during creation to quantifiable visual elements such as color, line, composition, and texture of the works. If these characteristics can be decoded by the audience and evoke the corresponding emotional response that the artist intended to convey, it means that a path to enhancing AI emotional intelligence may be found. Firstly, by selecting a recent exhibition to collect a dataset of artistic works, we develop an emotional evaluation method called Emotional Encoding Score (EES) based on three dimensions: emotional granularity, evocative potential, and the balance between concept and emotion. Subsequently, to verify the hypothesis that female artists' works express richer emotions, we draw on the principles of neuroaesthetics and neuroplasticity to further analyze representative works of female artists in postmodernism. We aim to identify the factors and strengths that influence emotional encoding, improve the existing model's analysis of emotions, and establish a closer dialogue between generative art, traditional painting, and aesthetic education.},
booktitle = {Proceedings of the 2nd International Conference on Artificial Intelligence, Virtual Reality and Interaction Design},
pages = {1133–1138},
numpages = {6},
keywords = {Affective Computing, Art, Emotion, Female Artists, Neural plasticity, Neuroaesthetics},
location = {
},
series = {AIVRID '26}
}

@inproceedings{10.1145/3820915.3821095,
author = {Yang, Pinlin and Zhao, Di},
title = {AI Empowerment, User Experience, and Cultural Translation: Design and Evaluation of a Cross-border E-commerce Platform for Cultural and Creative Products Targeting the Northeast Asian Market},
year = {2026},
isbn = {9798400723612},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3820915.3821095},
doi = {10.1145/3820915.3821095},
abstract = {Under the backdrop of the global digitalization of the cultural and creative industry and China's “Cultural Digitalization” strategy, the efficient international transformation of regional characteristic cultural and creative resources faces core challenges such as cultural discount, weak copyright protection, and fragmented user experience. This study takes the rich intangible cultural heritage resources of Liaoning Province (such as Xiuyan jade carving, Manchu embroidery, etc.) and the creative output of university art talents as objects, aiming to construct an AI-empowered “ArtLink Global” cross-border e-commerce platform for cultural and creative products targeting the Northeast Asian market. The platform innovatively integrates a generative AI cultural translation engine, a lightweight immersive display module, and a blockchain-based certification system, aiming to intelligently transform local cultural symbols into products that align with the aesthetic preferences of Japanese and Korean audiences, and provide a low-threshold, highly interactive cross-border transaction experience. This paper elaborates on the platform's three-layer architecture design of “Front-end Experience Layer - AI Empowerment Middle Platform - Resource Backend,” and demonstrates its technical implementation through a prototype system named “ArtLink Global” that integrates cultural translation, AR display, and intelligent customer service. A mixed-method approach (heuristic evaluation, user testing, A/B comparison) was used to conduct a preliminary evaluation of the prototype's usability and cultural adaptability. The results indicate that AI-driven cultural translation can effectively reduce cognitive bias by approximately 35\%, and AR display increases user interaction time with products by about 50\%. This study provides an integrated “technology-design-business” solution to the regional dilemma of “abundant resources but weak transformation,” and also offers a new paradigm for the application of AI and interdisciplinary approaches in the field of digital cultural heritage.},
booktitle = {Proceedings of the 2nd International Conference on Artificial Intelligence, Virtual Reality and Interaction Design},
pages = {1157–1161},
numpages = {5},
keywords = {Artificial Intelligence, Cross-border E-commerce, Cultural Translation, Cultural and Creative Products, Northeast Asian Market, User Experience},
location = {
},
series = {AIVRID '26}
}

@inproceedings{10.1145/3799825.3818690,
author = {Takacs, Barnabas and Pencz, Patrik and Vincze, Zsuzsanna},
title = { 'Out of the Box' - Synthesizing Historical Fashion for Virtual Production, XR, and Games via Generative Re-imagination and 4DGS},
year = {2026},
isbn = {9798400725487},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3799825.3818690},
doi = {10.1145/3799825.3818690},
abstract = {We present a lightweight production pipeline that transforms fragile historical costumes into dynamic digital assets using Generative Re-imagination to bridge the gap between restricted physical archives and production requirements. Our key insight is that labor-intensivke physical scanning and multi-camera photogrammetric capture can be replaced by AI-generated virtual views, which serve as the foundation for 3DGS model creation. We introduce a novel method to unify these partial 3DGS models into seamless temporal representations (4DGS), termed Blended 3DGS, and demonstrate the framework's versatility in the context of digital actor pipelines for costume design and facial animation, as well as virtual period fashion for Virtual Productions.},
booktitle = {Proceedings of the Special Interest Group on Computer Graphics and Interactive Techniques Conference Posters},
articleno = {36},
numpages = {3},
keywords = {3D Gaussian splatting, 4DGS, Cloth simulation, Facial animation},
location = {
},
series = {SIGGRAPH Posters '26}
}

@article{10.1145/3699738,
author = {Lyu, Yue and Liu, Di and An, Pengcheng and Tong, Xin and Zhang, Huan and Katsuragawa, Keiko and Zhao, Jian},
title = {EMooly: Supporting Autistic Children in Collaborative Social-Emotional Learning with Caregiver Participation through Interactive AI-infused and AR Activities},
year = {2024},
issue_date = {December 2024},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {8},
number = {4},
url = {https://doi.org/10.1145/3699738},
doi = {10.1145/3699738},
abstract = {Children with autism spectrum disorder (ASD) have social-emotional deficits that lead to difficulties in recognizing emotions as well as understanding and responding to social interactions. This study presents EMooly, a tablet game that actively involves caregivers and leverages augmented reality (AR) and generative AI (GenAI) to enhance social-emotional learning for autistic children. Through a year of collaborative effort with five domain experts, we developed EMooly that engages children through personalized social stories, interactive and fun activities, and enhanced caregiver participation, focusing on emotion understanding and facial expression recognition. Compared with a baseline, a controlled study with 24 autistic children and their caregivers showed EMooly significantly improved children's emotion recognition skills and its novel features were preferred and appreciated. EMooly demonstrates the potential of AI and AR in enhancing social-emotional development for autistic children via prompt personalizing and engagement, and highlights the importance of caregiver involvement for optimal learning outcomes.},
journal = {Proc. ACM Interact. Mob. Wearable Ubiquitous Technol.},
month = nov,
articleno = {203},
numpages = {36},
keywords = {Autism spectrum disorder, augmented reality, generative AI, mobile game, parent-mediated intervention, storytelling}
}

@inproceedings{10.1145/3820915.3821039,
author = {Wei, Jing},
title = {Research on the Differentiated Communication Paradigm of Film and Television Content Driven by Intelligent Image Generation and Multimodal Interaction},
year = {2026},
isbn = {9798400723612},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3820915.3821039},
doi = {10.1145/3820915.3821039},
abstract = {The iterative evolution of artificial intelligence technology has profoundly reshaped the ecological landscape of film and television production and communication. The dual drive of intelligent image generation and multimodal interaction technologies has enabled the film and television industry to break through the constraints of traditional standardized production and mass communication, making differentiated communication a core trend of film and television communication in the intelligent era. The two technologies respectively realize the efficient customization of differentiated content and the in-depth reconstruction of the audience's viewing experience, and jointly drive the transformation of film and television communication from a “content-centered” model to an “audience-centered” one. From the interdisciplinary perspective of technology and communication, this paper sorts out the media evolution and contemporary driving forces of differentiated film and television communication, combines 12 typical industrial cases of AI film and television creation from 2024 to 2025 and the user behavior data of 3 major video platforms (Tencent Video, Douyin, Kuaishou) with a sample size of 500,000+, quantitatively analyzes the implementation effect and industrial application value of differentiated communication, expounds the core connotation and operational logic of this paradigm in the dimensions of content creation, channel communication and experience interaction, and provides a systematic cognitive framework for understanding the transformative characteristics of film and television communication in the intelligent era.With the continuous maturity of large-scale pre-trained models and generative artificial intelligence technologies, the integration of technology and film and television content has entered a deep-water area. Unlike the previous single auxiliary application, the current intelligent image generation and multimodal interaction technologies have realized the whole-chain penetration from script creation, scene rendering, post-production to interactive experience design. Differentiated communication, as an important communication strategy to adapt to the fragmentation and personalization of audience needs, has gradually evolved from a theoretical concept to a mainstream industrial practice. In this context, it is of great theoretical and practical significance to systematically explore the paradigm characteristics, operation logic and development challenges of differentiated communication driven by dual technologies. This paper attempts to fill the research gap of insufficient systematic research on the whole chain of differentiated communication in the existing literature, and provide reference for the high-quality development of China's film and television industry in the intelligent era.},
booktitle = {Proceedings of the 2nd International Conference on Artificial Intelligence, Virtual Reality and Interaction Design},
pages = {803–808},
numpages = {6},
keywords = {Communication Paradigm, Differentiation, Film and Television Communication, Intelligent Image Generation, Multimodal Interaction},
location = {
},
series = {AIVRID '26}
}

@inproceedings{10.1145/3820915.3820997,
author = {Tang, Jing and Liu, Ying and Wang, Jing and Tan, Yuanlong},
title = {Computer Vision and Deep Learning-Driven Intelligent Animation IP Creation: A Case Study of Zhong Kui Character Design Based on AI Intelligent Drawing},
year = {2026},
isbn = {9798400723612},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3820915.3820997},
doi = {10.1145/3820915.3820997},
abstract = {Against the backdrop of the deep integration of computer vision (CV), deep learning (DL) and generative artificial intelligence (AIGC) in the animation industry, and in response to the core theme of the 2nd International Conference on Artificial Intelligence, Virtual Reality and Interaction Design (AIVRID 2026) — “Computer Vision and Image Processing, Deep Learning and AI Intelligent Drawing”, this study aims to address the prominent industry pain points in animation IP development, including insufficient creative capacity, low efficiency of image processing, and difficult management of cross-media style consistency. With the rapid development of AI technology, animation IP creation is facing an urgent demand for intelligent transformation, while traditional manual design models and single AI drawing methods can no longer meet the requirements of high efficiency, high quality and cultural consistency in modern animation IP development [1]. Focusing on the synergistic adaptation between intelligent character design and worldview construction, which is a key link in animation IP creation, this research takes the classic traditional Chinese cultural image Zhong Kui as the research carrier, and takes the creation of its animated character and supporting 30-second short film as the core case, constructing a CV-DL dual-drive intelligent animation IP design framework deeply integrated with AI intelligent drawing technology. Specifically, computer vision technology, including image preprocessing, SIFT feature extraction and image matching algorithms, is used to accurately extract the cultural feature elements of Zhong Kui from 500 traditional artworks (such as paintings, murals and sculptures), establishing a standardized cultural feature library to ensure the inheritance of traditional cultural connotations [2]. Meanwhile, deep learning models represented by StyleGAN2 are employed to realize intelligent generation and multi-dimensional optimization of character shapes, textures and dynamic effects, and the model is trained through 100,000 iterations to improve the clarity and authenticity of generated images [16]. The experimental results show that the proposed framework can significantly improve the efficiency and quality of animation IP creation, and effectively ensure the consistency of character image and worldview style. Compared with traditional manual design methods, the design cycle of animation characters is shortened by 62.3\%, the average feature similarity between generated characters and traditional cultural images reaches 87.9\%, and the user satisfaction rate among 50 professional evaluators reaches 89.7\%. This research not only provides a feasible technical path for the intelligent transformation of animation IP creation, enriches the application scenarios of computer vision and deep learning in the cultural and creative field, but also responds to the development trend of the integration of computer technology and animation industry emphasized by AIVRID 2026, providing important academic reference for the innovative application of AI intelligent drawing technology in animation IP creation [17].},
booktitle = {Proceedings of the 2nd International Conference on Artificial Intelligence, Virtual Reality and Interaction Design},
pages = {537–542},
numpages = {6},
keywords = {Computer Vision, Deep Learning, AI Intelligent Drawing, Animation IP Creation, Character Design, Image Processing},
location = {
},
series = {AIVRID '26}
}

