address = {New York, NY, USA},
url = {https://doi.org/10.1145/3736539.3737497},
doi = {10.1145/3736539.3737497},
abstract = {A creator's play is never done. Our Hybrid Dance Xplorations workshop invites you to play with us as we adventurously explore virtual camera control, motion capture, generative AI, touchless or gesture-based interaction, and potentially clothing/costume design \&amp; simulation – in evolving configurations of our XR/AI sandbox for co-creation and hybrid performance. We will share previous and present work including three use/play cases for movement-based experiences with contemporary dance and salsa (solo, pairs and rueda). Presenters include local artists, researchers and technologists. A highlight will be engaging group activities for workshop attendees to contribute to ideas, laughter and ambitions to date.},
