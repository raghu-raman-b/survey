@inproceedings{10.1145/3820915.3821071,
author = {Lu, Jiayun and Zhang, Chenghe and Hu, Jun and Hao, Lele},
title = {Technical Architecture and Implementation Path of Immersive Design for University Cultural Venues from the Perspective of Physical Aesthetic Education},
year = {2026},
