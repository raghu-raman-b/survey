@inproceedings{10.1145/3772128.3772129,
author = {Zhou, Xinyun and Lu, Yeshi and Zeng, Yongle and Tang, Xiaoying},
title = {A system to facilitate user learning of Chaozhou embroidery through the crafting process},
year = {2025},
isbn = {9798400715860},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3772128.3772129},
doi = {10.1145/3772128.3772129},
abstract = {This paper presents an interactive system designed to facilitate learning of Chaozhou embroidery, a nationally listed intangible cultural heritage representing traditional Chinese craftsmanship. Grounded in constructivist theory, we propose a digital teaching framework emphasizing contextualization, interaction, and hands-on practice. The system collects extensive video documentation of Chaozhou embroidery techniques, trains generative adversarial networks to build an embroidery database, and employs Video Swin Transformer to extract key operations into frame-by-frame tutorials. These animations are projected directly onto fabrics via interactive projection, intuitively guiding users through the distinctive "raised-relief" techniques. By decomposing complex processes into manageable steps with real-time visual feedback, the system significantly enhances beginners' engagement and skill acquisition. This integration of traditional craft with digital innovation opens new avenues for preserving and disseminating Chaozhou culture, promoting sustainable development of this art form.},
booktitle = {Proceedings of the 2025 2nd International Conference on Virtual Reality, Image and Signal Processing},
pages = {1–6},
numpages = {6},
keywords = {Chaozhou Embroidery, Cultural Heritage Preservation, Digital Integration, Handicraft Education, Interactive Learning System},
location = {
},
series = {VRISP '25}
}

@inproceedings{10.1145/3777730.3777846,
author = {Li, Mengfan and Jin, Rilong and Deng, Yu and Liu, Binbin},
title = {Feasibility projection guided layout constrained diffusion for automatic poster design},
year = {2026},
isbn = {9798400718540},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3777730.3777846},
doi = {10.1145/3777730.3777846},
abstract = {For visual communication scenarios such as poster design, existing text-to-image diffusion models struggle to consistently meet professional layout specifications. Common issues include element overlap, margin violations, and insufficient text readability. This paper proposes a Feasibility Projection-Guided Layout Constrained Diffusion framework (FP-LCD). This framework uses a layout constraint encoder to formalize hard and soft constraints such as margins, collinearity/baseline, non-overlap, and whitespace into feasible regions and differentiable penalties. Denoising and projection are performed alternately during latent space sampling, and in-the-loop optical character recognition (OCR) readability and aesthetic priors are introduced for collaborative optimization. Experiments demonstrate that this framework significantly improves constraint compliance and visual quality on a standard test set: the feasibility rate increases to 89.7\%, the overlap rate decreases to 0.029, the mean alignment error decreases to 5.2 px, the OCR confidence level increases to 0.91, and the double-blind preference success rate reaches 68.4\%. These results demonstrate that deeply coupling generative modeling with constraint optimization can effectively bridge the gap between controllable and verifiable generation. This paper contributes by proposing a generalizable unified “projection-sampling-feedback” paradigm, constructing a layout-oriented multi-metric evaluation protocol and implementation details, and providing a verifiable and scalable technical path for the implementation of automated poster generation.},
booktitle = {Proceedings of the 2025 International Conference on Artificial Intelligence, Virtual Reality and Interaction Design},
pages = {725–731},
numpages = {7},
keywords = {Automated Poster Generation, Constrained Optimization, Feasibility Projection Framework, Layout Constrained Diffusion Model, Text Readability Optimization},
location = {
},
series = {AIVRID '25}
}

@inproceedings{10.1145/3772128.3772145,
author = {Chen, Yanzhu},
title = {Application of Real-time Image Style Conversion in Design Software},
year = {2025},
isbn = {9798400715860},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3772128.3772145},
doi = {10.1145/3772128.3772145},
abstract = {In view of the efficiency bottleneck and lack of artistic expression in children's picture book creation, this study proposes an innovative solution based on improved cyclic generative adversarial network. The traditional design process relies on designers to manually transform photo materials into picture-book style images, facing problems such as long creation cycle, distortion of details and difficulty in compatibility with art specifications. In this paper, we reconstruct the CycleGAN framework by three core techniques: introducing residual dense module into the generator to enhance the ability of extracting detailed features of picture books; using the discriminator of optimized convolution layer to enhance the accuracy of style transfer; innovatively embedding the loss function between color quantity control and CMYK printing specification. The data set verification shows that the improved model is significantly better than the baseline model in PSNR (25.89dB), SSIM (0.93) and other indicators, providing intelligent solutions with artistic expression and production feasibility for creative design.},
booktitle = {Proceedings of the 2025 2nd International Conference on Virtual Reality, Image and Signal Processing},
pages = {95–100},
numpages = {6},
keywords = {CycleGAN, GAN, Picture Book, Real-time Image Style Conversion},
